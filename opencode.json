{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "tidewave": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec npx -y mcp-remote@0.16.0 \"http://localhost:$(cat .server.port 2>/dev/null || echo 4000)/tidewave/mcp\""
      ],
      "enabled": true
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp/alergeek/firmowid"
    },
    "posthog": {
      "type": "remote",
      "url": "https://mcp.posthog.com/mcp",
      "enabled": true
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": true
    },
    "anonimized-mcp": {
      "type": "remote",
      "url": "https://firmowid-mcp.d.alergeek.me/mcp",
      "enabled": true
    }
  }
}
