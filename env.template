# Firmowid local environment without Infisical
#
# The Alergeek Ventures team loads shared development values from Infisical.
# Everyone else can run the app with this file instead (see README):
#
#   cp env.template .env.worktree
#   echo "SECRET_KEY_BASE=$(openssl rand -base64 48)" >> .env.worktree
#   echo "OAUTH2_SIGNING_SECRET=$(openssl rand -base64 48)" >> .env.worktree
#   echo "CLOAK_VAULT_KEY=$(openssl rand -base64 32)" >> .env.worktree
#   export AV_SKIP_INFISICAL=1
#
# AV_SKIP_INFISICAL=1 must be set in the shell that runs Mix; .env.worktree is
# read only after the Infisical step.

# =============================================================================
# Local services (local/compose.yml)
# =============================================================================

PORT=4000
DB_PORT=5433
S3_PORT=4566
GOTENBERG_PORT=3000
DEBUGGER_PORT=9229
BRANCH=main
# Development uses the database URL from config/dev.exs (port 5433). When you
# change DB_PORT, also set DATABASE_URL to that URL with the new port.

# SeaweedFS S3 accepts these fixed local credentials (required by ex_aws)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# =============================================================================
# Application (required)
# =============================================================================

# Public URL of the app; `mix dev.up` overwrites it with the worktree's URL
PHX_URL=http://localhost:4000
MCP_RESOURCE_URL=http://localhost:4000/mcp

# KSeF environment selector, allowed values: test | prod
# Local development and staging use test, production uses prod.
KSEF_ENV=test

# SECRET_KEY_BASE, OAUTH2_SIGNING_SECRET and CLOAK_VAULT_KEY are generated
# locally by the commands above. Never reuse production values.

# =============================================================================
# External API Keys (all optional in dev)
# =============================================================================
# Leave them commented out: an empty value counts as configured.

# OpenAI API (https://openai.com), used for AI-powered invoice enrichment
# OPENAI_API_KEY=

# Reducto API (https://reducto.ai), used for OCR document processing
# Development always uses a local mock (config/dev.exs), so it needs no key.
# REDUCTO_API_KEY=

# Resend Email API (https://resend.com), used for transactional emails
# Development delivers emails to the local mailbox without it.
# RESEND_API_KEY=

# Open Exchange Rates API (https://openexchangerates.org), used for currency
# conversion in production; development and tests use fixed rates
# OPEN_EXCHANGE_RATES_APP_ID=

# GoCardless Bank Account Data (https://gocardless.com), used for bank sync
# GO_LIMITLESS_SECRET_ID=
# GO_LIMITLESS_SECRET_KEY=

# Google OAuth (https://console.cloud.google.com), used for Google Sign-In
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
