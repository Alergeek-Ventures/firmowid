# Firmowid Environment Variables
# Copy this file to .env for local development
# These defaults work out-of-the-box with the local docker-compose setup

# ============================================================================
# REQUIRED - Core Application
# ============================================================================

# PostgreSQL database connection string (matches local docker-compose setup)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/firmowid_dev?sslmode=prefer"

# Phoenix secret key base
# For production: generate a new one with: mix phx.gen.secret
# For development: this default value works fine
SECRET_KEY_BASE="REMOVED_PHOENIX_SECRET_KEY_BASE"

# ============================================================================
# OPTIONAL - OAuth/SSO
# ============================================================================

# Google OAuth (https://console.cloud.google.com)
# Used for Google Sign-In. Leave empty to disable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================================
# S3 Object Storage
# ============================================================================

# S3 bucket name (default: firmowid-uploads)
S3_BUCKET=firmowid-uploads

# S3 endpoint configuration (defaults work with localstack in local/compose.yml)
S3_HOST=localhost
S3_SCHEME=http://
S3_PORT=4566

# AWS credentials (these defaults work with localstack for development)
# For production: use real AWS credentials
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ============================================================================
# OPTIONAL - Analytics and Monitoring
# ============================================================================

# PostHog analytics (https://posthog.com)
# Leave empty to disable analytics
POSTHOG_API_KEY=
POSTHOG_API_URL=

# Sentry error tracking (https://sentry.io)
# Leave empty to disable error tracking
SENTRY_DSN=

# ============================================================================
# OPTIONAL - External Services
# ============================================================================

# Open Exchange Rates API (https://openexchangerates.org)
# Used for currency conversion. Leave empty to use mock data in dev/test
OPEN_EXCHANGE_RATES_APP_ID=

# GoCardless Bank Data API (https://gocardless.com)
# Used for bank account synchronization. Leave empty to disable
GO_LIMITLESS_SECRET_ID=
GO_LIMITLESS_SECRET_KEY=

# OpenAI API (https://openai.com)
# Used for AI-powered invoice enrichment. Leave empty to disable
OPENAI_API_KEY=

# Reducto API (https://reducto.ai)
# Used for OCR document processing. Leave empty to disable
REDUCTO_API_KEY=

# Resend Email API (https://resend.com)
# Used for transactional emails. Leave empty to use local adapter in dev
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# ============================================================================
# PDF Generation
# ============================================================================

# Chromium DevTools Protocol endpoint for PDF generation
# Format: "hostname:port"
# Development (with local docker-compose): localhost:9222
# Production: chromium:9222
# Leave empty to use local Chromium with --no-sandbox (development only)
CHROME_ADDRESS=localhost:9222

# ============================================================================
# OPTIONAL - Production Configuration
# ============================================================================

# PHX_HOST is required in production (your domain name)
# PHX_HOST=example.com

# PORT for the HTTP server (default: 4000)
# PORT=4000

# Enable Phoenix server (set to "true" in production)
# PHX_SERVER=true

# Database pool size (default: 5)
# POOL_SIZE=10
