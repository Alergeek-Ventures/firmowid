# Firmowid Environment Variables
# Copy this file to .env for local development
#
# Only API keys/secrets that shouldn't be committed go here.
# All other config (ports, URLs) is in config/dev.exs or .env.local (worktrees).

# =============================================================================
# External API Keys (all optional in dev)
# =============================================================================

# KSeF environment selector (required)
# Allowed values: test | prod
# - local/staging should use: test
# - production should use: prod
KSEF_ENV=test

# OpenAI API (https://openai.com)
# Used for AI-powered invoice enrichment
OPENAI_API_KEY=

# Reducto API (https://reducto.ai)
# Used for OCR document processing
REDUCTO_API_KEY=

# Resend Email API (https://resend.com)
# Used for transactional emails
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Open Exchange Rates API (https://openexchangerates.org)
# Used for currency conversion
OPEN_EXCHANGE_RATES_APP_ID=

# Google OAuth (https://console.cloud.google.com)
# Used for Google Sign-In
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
