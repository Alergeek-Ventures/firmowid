{
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@sentry/browser": "11.8.0",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "canvas-confetti": "1.9.4",
    "heroicons": "2.2.0",
    "live_toast": "file:../deps/live_toast",
    "phoenix": "file:../deps/phoenix",
    "phoenix_html": "file:../deps/phoenix_html",
    "phoenix_live_view": "file:../deps/phoenix_live_view",
    "posthog-js": "1.438.13",
    "tailwindcss": "4.3.3",
    "tippy.js": "6.3.7",
    "topbar": "3.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "audit-ci": "7.1.0",
    "esbuild": "0.28.2",
    "license-checker": "25.0.1"
  },
  "scripts": {
    "audit:check": "audit-ci --config audit-ci.jsonc",
    "licenses:check": "license-checker --production --excludePrivatePackages --summary --onlyAllow 'MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;CC0-1.0;Unlicense;BlueOak-1.0.0;MPL-2.0'",
    "sentry:sourcemaps:clean": "find ../priv/static/assets -type f \\( -name '*.map' -o -name '*.map.*' \\) -delete"
  },
  "overrides": {
    "@tailwindcss/cli": {
      "@parcel/watcher": "2.6.0"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.7"
    }
  }
}
