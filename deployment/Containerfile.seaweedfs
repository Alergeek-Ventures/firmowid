# SeaweedFS S3-compatible server for CI
#
# The upstream image has no default CMD, so GitHub Actions service containers
# (which cannot pass command args) would just print usage and exit.
# This wrapper adds the default command to run the all-in-one server with S3.
#
# No HEALTHCHECK is baked in — SeaweedFS needs ~25s to boot all components
# (master -> volume -> filer -> S3), which exceeds GHA runner's health timeout.
# Readiness is handled in workflow steps instead (retry loop on bucket creation).
#
# Dependabot tracks the FROM tag and opens PRs on new releases.
# On main, Build and Test publishes missing wrapper images before running tests.
#
# Build: docker build -f deployment/Containerfile.seaweedfs -t seaweedfs-s3:latest .
# Run:   docker run -p 8333:8333 seaweedfs-s3:latest

FROM docker.io/chrislusf/seaweedfs:4.48@sha256:4e61d15fd35994cb1e43e1e553dff106794841fd9a99ade2fc8c8bfce4d7872d

CMD ["server", "-s3"]
