# Containerfile for Gotenberg service with invoice fonts
# Upstream Gotenberg ships without Geist / Lexend / Open Sans / Montserrat, which the
# invoice PDFs rely on (see PdfHelpers font handling). This image adds them
# so local and deployed renders use the same typefaces.
#
# Build: docker build -f deployment/Containerfile.gotenberg -t firmowid-gotenberg:latest .
# Run:   docker run -p 3000:3000 firmowid-gotenberg:latest

FROM docker.io/gotenberg/gotenberg:9.10.0-chromium@sha256:74ce5ec9f836a7f46e4a32df39340bdd164aaee7d5a369c68f25d25d1f16aee7

# Keep Chromium warm from boot instead of starting on first conversion.
ENV CHROMIUM_AUTO_START=true

# Install custom fonts from a pinned google/fonts commit. The SHA-256 sums were
# computed from the files at that commit; the build fails before installing
# anything if a download differs. Moving the commit means recomputing all sums.
ARG GOOGLE_FONTS_COMMIT=06bfe0d62a98375cb09c942fa18e68bd32cff057
USER root
RUN mkdir -p /usr/share/fonts/truetype/geist \
             /usr/share/fonts/truetype/lexend \
             /usr/share/fonts/truetype/open-sans \
             /usr/share/fonts/truetype/montserrat && \
    cd /tmp && \
    fonts="https://raw.githubusercontent.com/google/fonts/${GOOGLE_FONTS_COMMIT}/ofl" && \
    curl -fsSL "$fonts/geist/Geist%5Bwght%5D.ttf" -o Geist.ttf && \
    curl -fsSL "$fonts/lexend/Lexend%5Bwght%5D.ttf" -o Lexend.ttf && \
    curl -fsSL "$fonts/opensans/OpenSans%5Bwdth%2Cwght%5D.ttf" -o OpenSans.ttf && \
    curl -fsSL "$fonts/opensans/OpenSans-Italic%5Bwdth%2Cwght%5D.ttf" -o OpenSans-Italic.ttf && \
    curl -fsSL "$fonts/montserrat/Montserrat%5Bwght%5D.ttf" -o Montserrat.ttf && \
    curl -fsSL "$fonts/montserrat/Montserrat-Italic%5Bwght%5D.ttf" -o Montserrat-Italic.ttf && \
    printf '%s  %s\n' \
      73894e0448cae90a92b6c2f8732b7bb9acb7b94c418bff559dad4a18e1de9659 Geist.ttf \
      3add53e641fbc81da64da4bb254285e2831b52b029527bc0714e2b9610832ee6 Lexend.ttf \
      36643644f318a812aab2d2ed3bb98f8cf0872527f835fe9398d95fe6b9adb878 OpenSans.ttf \
      fe269381e992f32e135801740998544d6235061e37c93ec067ad2be3edd5b17b OpenSans-Italic.ttf \
      0f7b311b2f3279e4eef9b2f968bcdbab6e28f4daeb1f049f4f278a902bcd82f7 Montserrat.ttf \
      51607f316bc020e59f03cbf51543eecffbea501c0b31d73e5b82927c5cca442c Montserrat-Italic.ttf \
      | sha256sum --strict -c - && \
    mv Geist.ttf /usr/share/fonts/truetype/geist/ && \
    mv Lexend.ttf /usr/share/fonts/truetype/lexend/ && \
    mv OpenSans.ttf OpenSans-Italic.ttf /usr/share/fonts/truetype/open-sans/ && \
    mv Montserrat.ttf Montserrat-Italic.ttf /usr/share/fonts/truetype/montserrat/ && \
    fc-cache -f -v

USER gotenberg

# Gotenberg API port
EXPOSE 3000

# Health check to ensure the API is responding
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=60s \
  CMD curl --fail --silent --show-error http://127.0.0.1:3000/health || exit 1
