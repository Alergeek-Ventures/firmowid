# Containerfile for Chromium service
# This image wraps zenika/alpine-chrome with the proper command for ChromicPDF
# Use this when your deployment platform (e.g., Coolify) doesn't allow setting custom commands
#
# Based on ChromicPDF documentation example:
# https://hexdocs.pm/chromic_pdf/ChromicPDF.html#module-remote-chrome
#
# Build: docker build -f deployment/Containerfile.chromium -t firmowid-chromium:latest .
# Run:   docker run -p 9222:9222 firmowid-chromium:latest

FROM zenika/alpine-chrome:124@sha256:1db3ae560c20f70f31bca4ea81fac3fc19cfb22343990d65326e92a5b59760a7

# Install nginx for reverse proxy and fontconfig for custom fonts
USER root
RUN apk add --no-cache nginx fontconfig curl

# Create directories for nginx with chrome user ownership
RUN mkdir -p /var/lib/nginx/logs /var/lib/nginx/tmp && \
    chown -R chrome:chrome /var/lib/nginx /var/log/nginx /tmp

# Download and install Lexend font
RUN mkdir -p /usr/share/fonts/truetype/lexend && \
    cd /tmp && \
    wget -q https://github.com/google/fonts/raw/main/ofl/lexend/Lexend%5Bwght%5D.ttf -O Lexend.ttf && \
    mv Lexend.ttf /usr/share/fonts/truetype/lexend/ && \
    fc-cache -f -v

USER chrome

# Copy our custom entrypoint script with the required flags
# Use --chmod to set executable permissions during COPY (avoids permission issues)
COPY --chmod=755 deployment/entrypoint.chromium.sh /usr/local/bin/entrypoint.chromium.sh

# Override the base image's ENTRYPOINT to use our script directly
ENTRYPOINT ["/usr/local/bin/entrypoint.chromium.sh"]
CMD []

# Expose the DevTools Protocol port
EXPOSE 9222

# Health check to ensure Chrome is responding on the debugging port
# Increased start-period to give Chrome time to initialize
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=60s \
  CMD curl --fail --silent --show-error http://127.0.0.1:9222/json/version || exit 1
