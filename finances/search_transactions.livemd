# Transaction Search Performance Testing

```elixir
Mix.install(
  [
    {:firmowid, path: Path.join(__DIR__, "../"), env: :dev},
    {:kino, "~> 0.13.0"}
  ],
  config_path: :firmowid,
  lockfile: :firmowid,
  start_applications: false
)

# boot only what the notebook really needs
Application.ensure_all_started(:ecto_sql)
Application.ensure_all_started(:kino)

# now you can attach the repo as a Livebook child
{:ok, _pid} = Kino.start_child({Firmowid.Repo, []})
```

## Performance Testing

```elixir
Firmowid.Repo.put_org_id("01948dfc-1367-7e4f-90e2-54b685167481")
```

```elixir
# Helper function to measure execution time
measure_time = fn fun ->
  start = System.monotonic_time(:millisecond)
  result = fun.()
  time = System.monotonic_time(:millisecond) - start
  {result, time}
end

total_transactions_from_listing =
  Firmowid.Finances.list_transactions(
    ~D[2020-01-01],
    ~D[2030-01-01]
  )
total_transactions_from_search = Firmowid.Finances.search_transactions(%{})

IO.inspect(%{
  total_transactions_from_listing_count: length(total_transactions_from_listing),
  total_transactions_from_search_count: length(total_transactions_from_search)
})

# Test different search queries
queries = [
  "made",
  "mobile",
  "viking"
]

results =
  queries
  |> Enum.map(fn query ->
    {transactions, time} =
      measure_time.(fn ->
        Firmowid.Finances.search_transactions(%{query: query})
      end)

    %{
      query: query,
      results_count: length(transactions),
      time_ms: time
    }
  end)

Kino.DataTable.new(results)
```

## Index Health Check

```elixir
# Check BM25 index health
sql = "SELECT * FROM paradedb.index_info('transactions_search_idx')"
{:ok, result} = Firmowid.Repo.query(sql)

headers = result.columns
rows = result.rows

data = Enum.map(rows, fn row ->
  Enum.zip(headers, row) |> Map.new()
end)

Kino.DataTable.new(data)
```
