  "base_filter": null,
  "check_constraints": [
    {
      "attribute": [
        "amount"
      ],
      "base_filter": null,
      "check": "COALESCE((invoice_type)::text = ANY ((ARRAY['kor'::character varying, 'kor_zal'::character varying, 'kor_roz'::character varying])::text[]), false)\nOR (amount).amount <= (0)::numeric\n",
      "name": "cost_invoices_non_correction_amount_non_positive"
    }
  ],
  "create_table_options": null,
  "custom_indexes": [],
  "custom_statements": [
    {
      "after_tables": [],
      "code?": false,
      "down": "SELECT 1;",
      "global?": false,
      "name": "validate_cost_invoice_correction_currencies",
      "up": "DO $$\nBEGIN\n  IF EXISTS (\n    SELECT 1\n    FROM cost_invoices correction\n    JOIN cost_invoices original\n      ON original.ksef_number = correction.original_invoice_ksef_number\n    WHERE correction.invoice_type IN ('kor', 'kor_zal', 'kor_roz')\n      AND (correction.amount).currency_code IS DISTINCT FROM (original.amount).currency_code\n  ) THEN\n    RAISE EXCEPTION\n      'Cost invoice money migration failed: linked corrections must use the original invoice currency';\n  END IF;\n\nEND\n$$;\n"
    }
  ],
