<div class="flex flex-col items-center gap-8">
  <.header class="mx-auto w-full max-w-[1024px]">
    {gettext("Invitations to your organization")}
    <:actions>
      <.button phx-click="create">{gettext("Prepare invitation")}</.button>
    </:actions>
  </.header>

  <.empty_state
    :if={@organization_invites == []}
    id="organization_invites_empty"
    title={gettext("No invites yet")}
    class="w-full max-w-[1024px]"
  >
    {gettext(
      "Prepare an invite and give its code to the person who should join your organization."
    )}
  </.empty_state>

  <.table
    :if={@organization_invites != []}
    id="organization_invites"
    rows={@organization_invites}
    class="mx-auto w-full max-w-[1024px] border-separate border-spacing-y-2"
  >
    <:col :let={organization_invite} label={gettext("Date")}>
      <%= if is_nil(organization_invite.consumed_at) do %>
        {organization_invite.expires_at |> Calendar.strftime("%Y-%m-%d")}
      <% else %>
        {organization_invite.consumed_at |> Calendar.strftime("%Y-%m-%d")}
      <% end %>
    </:col>
    <:col :let={organization_invite} label={gettext("Invitation code")}>
      <code class="rounded-md bg-teal-800 p-2 text-white">
        {organization_invite.invite_code}
      </code>
    </:col>
    <:col :let={organization_invite} label={gettext("Issued by")}>
      {organization_invite.issued_by.email}
    </:col>
    <:col :let={organization_invite} label={gettext("Used by")}>
      <%= if is_nil(organization_invite.consumed_by) do %>
        -
      <% else %>
        {organization_invite.consumed_by.email}
      <% end %>
    </:col>
    <:action :let={organization_invite}>
      <.button
        type="button"
        variant="outline"
        phx-click={JS.push("delete", value: %{id: organization_invite.id})}
        data-confirm={gettext("Are you sure?")}
      >
        {gettext("Delete")}
      </.button>
    </:action>
  </.table>
</div>
