<div class="flex flex-col items-center gap-8">
  <.header class="mx-auto w-[1024px]">
    Zaproszenia do Twojej organizacji
    <:actions>
      <.button phx-click="create">Przygotuj zaproszenie</.button>
    </:actions>
  </.header>

  <.table
    id="organization_invites"
    rows={@organization_invites}
    class="mx-auto w-full max-w-[1024px] border-separate border-spacing-y-2"
  >
    <:col :let={organization_invite} label="Data">
      <%= if is_nil(organization_invite.consumed_at) do %>
        {organization_invite.expires_at |> Calendar.strftime("%Y-%m-%d")}
      <% else %>
        {organization_invite.consumed_at |> Calendar.strftime("%Y-%m-%d")}
      <% end %>
    </:col>
    <:col :let={organization_invite} label="Kod zaproszenia">
      <code class="bg-blueText rounded-md p-2 text-white">
        {organization_invite.invite_code}
      </code>
    </:col>
    <:col :let={organization_invite} label="Wydane przez">
      {organization_invite.issued_by.email}
    </:col>
    <:col :let={organization_invite} label="Wykorzystane przez">
      <%= if is_nil(organization_invite.consumed_by) do %>
        -
      <% else %>
        {organization_invite.consumed_by.email}
      <% end %>
    </:col>
    <:action :let={organization_invite}>
      <.button
        type="button"
        variant="outline"
        phx-click={JS.push("delete", value: %{id: organization_invite.id})}
        data-confirm="Jesteś pewny?"
      >
        Usuń
      </.button>
    </:action>
  </.table>
</div>
