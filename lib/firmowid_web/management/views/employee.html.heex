<div class="mx-auto my-4 grid size-full max-h-240 min-h-0 max-w-7xl flex-1 grid-cols-[minmax(min-content,373px)_minmax(0,1fr)] grid-rows-[min-content_1fr] gap-x-10">
  <.back
    navigate={Navigation.employees_path(:index, %{miesiac: @projects_filter_date})}
    class="mb-8 justify-self-start"
  />

  <div class="col-start-2 flex items-end justify-between gap-4">
    <div class="-mb-2 flex gap-6 px-6">
      <.tab
        patch={~p"/zarzadzanie/pracownicy/#{@employee.id}"}
        active={@live_action == :projects}
      >
        Projekty i ewidencja
      </.tab>

      <.tab
        patch={~p"/zarzadzanie/pracownicy/#{@employee.id}/profil"}
        active={@live_action == :profile}
      >
        Profil pracownika
      </.tab>

      <.tab
        patch={~p"/zarzadzanie/pracownicy/#{@employee.id}/dokumenty"}
        active={@live_action == :documents}
      >
        Dokumenty
      </.tab>
      <.tab
        patch={~p"/zarzadzanie/pracownicy/#{@employee.id}/urlopy"}
        active={@live_action == :leaves}
      >
        Urlopy
      </.tab>
      <.tab
        :if={@employee.member.delegations != []}
        patch={~p"/zarzadzanie/pracownicy/#{@employee.id}/delegacje"}
        active={@live_action == :delegations}
      >
        Delegacje
      </.tab>
    </div>
  </div>

  <.card class="row-start-2 w-full">
    <div class="flex gap-3">
      <.avatar class="size-20 shrink-0 ring-1 ring-grey-200/50">
        <.avatar_image
          :if={Map.get(@employee.member.avatar_blob || %{}, :url)}
          src={Map.get(@employee.member.avatar_blob || %{}, :url)}
          alt="Avatar"
        />
        <.avatar_fallback class="bg-teal-200 text-2xl text-teal-800">
          {to_string(@employee.member.display_name || "")
          |> String.slice(0, 1)
          |> String.upcase()}
        </.avatar_fallback>
      </.avatar>
      <div>
        <h2 class="text-lg font-medium">{@employee.member.display_name}</h2>
        <div
          :if={@employee.member.slack_url not in [nil, ""]}
          class="flex items-center gap-2 text-sm text-grey-700"
        >
          <img src="/images/slack.png" alt="slack logo" width={24} height={24} />
          <.link
            kind="unstyled"
            external={@employee.member.slack_url}
            target="_blank"
            class="border-b border-transparent transition-colors hover:border-grey-700"
          >
            napisz na Slacku
          </.link>
        </div>
      </div>
      <.dropdown id="employee-dropdown" class="ml-auto">
        <:trigger>
          <span class="cursor-pointer rounded-full text-grey-700 transition-colors hover:bg-grey-100">
            <.icon name="hero-ellipsis-vertical" />
          </span>
        </:trigger>
        <div class="mt-2 flex flex-col rounded bg-grey-100 p-2 shadow-md">
          <.button
            disabled={@employee.member.archived_at}
            type="button"
            variant="ghost"
            size="small"
            phx-click="archive_employee"
          >
            <.icon name="hero-archive-box-mini" class="size-5" /> Archiwizuj
          </.button>
        </div>
      </.dropdown>
    </div>
    <div
      :if={@employee.member.archived_at}
      class="flex flex-col items-center gap-4 rounded-lg bg-grey-200 p-4 text-grey-700 shadow-card"
    >
      <p class="text-sm/snug text-balance">
        Pracownik został zarchiwizowany {Firmowid.Cldr.Date.to_string!(
          @employee.member.archived_at,
          format: :long
        )}. Nie ma dostępu do organizacji do czasu przywrócenia przez administratora.
      </p>

      <.button
        type="button"
        variant="tertiary"
        size="small"
        phx-click="unarchive_employee"
      >
        Przywróć pracownika
      </.button>
    </div>
    <.user_card_info :if={@employee.member.phone} label="Numer telefonu">
      {@employee.member.phone}
    </.user_card_info>
    <.user_card_info label="Adres e-mail">
      <span>{@employee.email}</span>
      <.button
        id="copy-email"
        phx-hook="CopyToClipboard"
        phx-click="copy-email"
        phx-value-email={@employee.email}
        type="button"
        variant="icon"
        class="h-6 w-7 duration-300"
      >
        <.icon name="hero-document-duplicate" class="size-5" />
      </.button>
    </.user_card_info>
    <.user_card_info
      :if={@employee.member.bank_account_number != nil}
      label="Numer konta bankowego"
    >
      <span>{@employee.member.bank_account_number}</span>
      <.button
        id="copy-bank-account-number"
        phx-hook="CopyToClipboard"
        phx-click="copy-bank-account-number"
        phx-value-number={@employee.member.bank_account_number}
        type="button"
        variant="icon"
        class="h-6 w-7 duration-300"
      >
        <.icon name="hero-document-duplicate" class="size-5" />
      </.button>
    </.user_card_info>

    <.user_card_info :if={not Enum.empty?(@employee.member.projects)} label="Projekty">
      <div class="mt-2 flex max-w-sm flex-wrap gap-2 text-sm/tight">
        <.link
          :for={project <- @employee.member.projects}
          kind="unstyled"
          navigate={Navigation.project_path(project.id, %{miesiac: @projects_filter_date})}
          class="rounded-full bg-teal-200 px-4 py-1 text-sm/snug text-teal-700 transition hover:bg-teal-300 hover:text-teal-800"
        >
          {project.name}
        </.link>
      </div>
    </.user_card_info>

    <span
      :if={@employee.member.shared_birthday != nil}
      class="mt-auto inline-flex items-center gap-2 text-sm/snug text-grey-700"
    >
      {format_shared_birthday(@employee.member.shared_birthday)}
      <.icon name="hero-cake" class="size-5" />
    </span>
  </.card>

  <div :if={false} class="col-start-2 flex gap-10 self-end px-6">
    <.link
      :for={
        {path, label, action} <-
          [
            {~p"/zarzadzanie/pracownicy/#{@employee.id}", "Projekty i ewidencja", :projects}
          ]
      }
      kind="unstyled"
      navigate={path}
      class={[
        "rounded-t-md p-3 font-medium text-grey-700 transition-all phx-click-loading:opacity-50",
        "shadow shadow-transparent hover:bg-white hover:text-black hover:shadow-black/10",
        @live_action == action &&
          "bg-grey-50 text-black shadow-black/10"
      ]}
    >
      {label}
    </.link>
  </div>

  <div class="relative z-10 col-start-2 row-start-2 size-full space-y-6">
    <%= case @live_action do %>
      <% :projects -> %>
        <.live_component
          module={FirmowidWeb.Management.Components.ProjectsTab}
          id="projects-tab"
          user={@employee}
          date={@projects_filter_date}
          active_months={@active_months}
          scope={@ash_scope}
        />
      <% :profile -> %>
        <.live_component
          module={FirmowidWeb.Management.Components.ProfileTab}
          id="profile-tab"
          user={@employee}
          scope={@ash_scope}
        />
      <% :documents -> %>
        <.live_component
          module={FirmowidWeb.Documents.Components.DocumentsSection}
          id="documents-tab"
          user={@employee}
          scope={@ash_scope}
          variant={:management}
          dimmed={@employee.member.archived_at != nil}
          current_contract_id={@current_contract && @current_contract.id}
        />
      <% :leaves -> %>
        <.live_component
          module={FirmowidWeb.Management.Components.LeavesTab}
          id="leaves-tab"
          employee={@employee}
          scope={@ash_scope}
        />
      <% :delegations -> %>
        <.card>
          <FirmowidWeb.Management.Components.DelegationsTab.delegations_tab
            employee_id={@employee.id}
            delegations={@employee.member.delegations}
          />
        </.card>
    <% end %>
  </div>
</div>
