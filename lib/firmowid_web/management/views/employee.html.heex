<div class="mx-auto my-4 grid w-full max-w-7xl grid-cols-[max-content_1fr] grid-rows-[repeat(2,min-content)] gap-x-10">
  <.link
    navigate={~p"/zarzadzanie/pracownicy"}
    class="mb-8 flex items-center gap-2 justify-self-start"
  >
    <.icon name="hero-arrow-left-circle-solid" class="size-8" />
    <span class="text-darkGrey">Pracownicy</span>
  </.link>

  <.card class="row-start-2 min-h-[689px] w-full max-w-[380px]">
    <div class="flex gap-3">
      <.avatar>
        <%!-- TODO: add user avatar --%>
        <.icon name="hero-user" class="text-darkGrey size-20" />
      </.avatar>
      <div>
        <h2 class="text-lg font-bold">{get_employee_display_name(@employee)}</h2>
        <div :if={@employee.slack_id != nil} class="text-darkGrey flex items-center gap-2 text-sm">
          <img src="/images/slack.png" alt="slack logo" width={24} height={24} />
          <.link
            href={"#{get_employee_slack_url(@employee)}/team/#{@employee.slack_id}"}
            class="hover:border-darkGrey border-b border-transparent transition-colors"
          >
            napisz na Slacku
          </.link>
        </div>
      </div>
    </div>

    <.user_card_info :if={@employee.phone != nil} label="Numer telefonu">
      {@employee.phone}
    </.user_card_info>
    <.user_card_info label="Adres e-mail">{@employee.email}</.user_card_info>
    <.user_card_info :if={@employee.bank_account_number != nil} label="Numer konta bankowego">
      <span>{@employee.bank_account_number}</span>
      <button
        id="copy-bank-account-number"
        onclick={"navigator.clipboard.writeText('#{@employee.bank_account_number}')"}
        type="button"
        class={[
          "text-darkGrey h-6 w-7 rounded-[3px]",
          "bg-greyButtonBg self-center justify-self-end",
          "flex shrink-0 flex-row items-center justify-center",
          "hover:border-darkGrey border border-transparent",
          "active:bg-darkGrey active:text-lightGreyBg",
          "transition-duration-300 transition-all"
        ]}
      >
        <.icon name="hero-document-duplicate" class="size-5" />
      </button>
    </.user_card_info>

    <.user_card_info :if={not Enum.empty?(@employee.projects)} label="Projekty">
      <div class="mt-2 flex flex-wrap gap-2 text-sm/tight">
        <.link
          :for={project <- @employee.projects}
          navigate={~p"/zarzadzanie/projekty/#{project.id}"}
          class="bg-turquoise-200 hover:bg-turquoise-300 hover:text-turquoise-800 text-turquoise-700 rounded-full px-4 py-1 text-sm/snug transition"
        >
          {project.name}
        </.link>
      </div>
    </.user_card_info>

    <span
      :if={@employee.birthday != nil}
      class="text-grey-700 mt-auto inline-flex items-center gap-2 text-sm/snug"
    >
      {TimeFormatter.format_date(@employee.birthday, "d MMMM")}
      <.icon name="hero-cake" class="size-5" />
    </span>
  </.card>

  <div :if={false} class="col-start-2 flex gap-10 self-end px-6">
    <.link
      :for={
        {path, label, action} <-
          [
            {~p"/zarzadzanie/pracownicy/#{@employee.id}", "Projekty i ewidencja", :projects}
          ]
      }
      navigate={path}
      class={[
        "phx-click-loading:opacity-50 text-darkGrey rounded-t-md p-3 font-medium transition-all",
        "shadow shadow-transparent hover:bg-white hover:text-black hover:shadow-black/10",
        @live_action == action &&
          "bg-grey-50 text-black shadow-black/10"
      ]}
    >
      {label}
    </.link>
  </div>

  <div class="col-start-2 row-start-2 w-full space-y-6">
    <%= case @live_action do %>
      <% :projects -> %>
        <.employee_projects_tab
          employee={@employee}
          projects_filter_date={@projects_filter_date}
          active_months={@active_months}
        />
    <% end %>
  </div>
</div>
