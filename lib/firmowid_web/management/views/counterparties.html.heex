<div class="flex w-full flex-col px-4 py-6 md:px-10 md:pt-8 md:pb-12">
  <header class="flex items-end justify-between gap-4">
    <h1 class="text-3xl/[1.3] font-bold text-grey-900">
      {pgettext("management navigation", "Counterparties")}
    </h1>
    <.page_actions>
      <:action>
        <.link
          navigate={
            Navigation.counterparty_new_path(%{
              powrot_do: Navigation.counterparties_path(@live_action, @params)
            })
          }
          kind="button"
          variant="special"
          data-fab
        >
          <Lucideicons.plus class="size-5" aria-hidden="true" />
          <span class="max-md:sr-only">{gettext("Add counterparty")}</span>
        </.link>
      </:action>
    </.page_actions>
  </header>

  <%!-- 24px around the toolbar, as between the title, the toolbar and the table. --%>
  <div class="sticky top-0 z-10 flex flex-wrap items-center justify-between gap-4 bg-grey-100 py-6 max-md:static max-md:z-auto max-md:flex-col max-md:items-stretch">
    <form class="flex flex-wrap items-center gap-4 max-md:gap-3" phx-submit="search">
      <.scope_switch label={gettext("Counterparty scope")}>
        <:option
          patch={Navigation.counterparties_path(:index, @params)}
          active={@live_action == :index}
        >
          {pgettext("people list tab", "Active")}
        </:option>
        <:option
          patch={Navigation.counterparties_path(:archive, @params)}
          active={@live_action == :archive}
        >
          {pgettext("people list tab", "Archived")}
        </:option>
        <%!-- Figma "Przełącznik „Do przejrzenia”": the third option counts the new buyers, stays
             without a count while only skipped ones are left, and goes away with neither. --%>
        <:option
          :if={@suggestions.waiting + @suggestions.skipped > 0}
          navigate={Navigation.counterparty_suggestions_path()}
          active={false}
          count={if(@suggestions.waiting > 0, do: @suggestions.waiting)}
        >
          {pgettext("people list tab", "New counterparties")}
        </:option>
      </.scope_switch>

      <.filter_pills label={nil} class="w-auto shrink-0">
        <:pill
          active={@type_filter == :individual}
          phx-click="toggle_type"
          phx-value-typ={Navigation.encode_counterparty_type(:individual)}
        >
          <Lucideicons.user /> {gettext("Individuals")}
        </:pill>
        <:pill
          active={@type_filter == :company}
          phx-click="toggle_type"
          phx-value-typ={Navigation.encode_counterparty_type(:company)}
        >
          <Lucideicons.building_2 /> {gettext("Company")}
        </:pill>
      </.filter_pills>

      <.expanding_search search={@search} search_label={gettext("Search counterparties")} />
    </form>

    <.switch
      class="flex-row-reverse max-md:hidden"
      field={@form[:view_cooperation_value]}
      phx-click="toggle_cooperation_value_view"
    >
      <:label_slot>
        <span class="text-sm/[1.35] text-grey-700">{gettext("Total paid")}</span>
      </:label_slot>
    </.switch>
  </div>

  <%!-- Figma "Wiersz kontrahenta": the counterparty fills the row, the identifier and the
       cooperation value take 200px each, the archive date 120px, 24px apart. On phones the
       identifier goes under the name. --%>
  <%!-- Figma "duży ekran (1920)": from 1800px the list in numbers stands beside the table,
       24px apart, level with the first row. --%>
  <div class="flex min-[1800px]:gap-6">
    <div
      id="counterparties-list"
      class={[
        "grid min-w-0 flex-1 content-start gap-x-6 gap-y-2 max-md:grid-cols-[minmax(0,1fr)_min-content]",
        grid_columns(@live_action, @view)
      ]}
    >
      <div
        id="counterparties-list-header"
        class={
          [
            "sticky top-21 z-1 col-span-full grid grid-cols-subgrid bg-grey-100 px-4 py-1 text-sm/[1.35] text-grey-500 transition-all duration-75 max-md:static",
            # An empty list keeps the heading's room, so the empty state stays in place.
            @counterparties == [] && "invisible"
          ]
        }
        phx-hook="ScrollStyle"
        data-classes="border-b-4 border-solid border-grey-700/40 pt-3"
        data-scroll-offset="90"
      >
        <p>{gettext("Counterparty")}</p>
        <p class="text-right max-md:hidden">{gettext("Identifier")}</p>
        <%!-- The column slides in as in the Team's payroll view. --%>
        <p
          :if={@view == :cooperation_value}
          class="text-right transition-[opacity,translate] duration-300 ease-out motion-reduce:transition-none max-md:hidden starting:translate-x-1 starting:opacity-0"
        >
          {gettext("Total paid")}
        </p>
        <%= if @live_action == :archive do %>
          <p class="text-right text-nowrap max-md:hidden">{gettext("Archived on")}</p>
          <span class="max-md:hidden" />
        <% end %>
        <span />
      </div>

      <%= if @counterparties == [] do %>
        <.empty_state
          size="small"
          title={
            cond do
              @search != "" or not is_nil(@type_filter) ->
                gettext("We could not find the counterparty you are looking for.")

              @live_action == :archive ->
                gettext("You have no archived counterparties to show.")

              true ->
                gettext("You have no active counterparties to show.")
            end
          }
          class="col-span-full gap-4! py-16! [&>div>p]:leading-[normal]"
        >
          <:icon><Lucideicons.building_2 class="text-grey-400" /></:icon>
        </.empty_state>
      <% else %>
        <%!-- An archived counterparty is greyed out, all but its archive date. --%>
        <div
          :for={{counterparty, index} <- Enum.with_index(@counterparties)}
          :key={counterparty.id}
          style={"--row: #{min(index, 12)}"}
          class={[
            "col-span-full grid grid-cols-subgrid items-center rounded-sm bg-white px-4 max-md:py-3 md:h-[57px]",
            if(@live_action == :archive, do: "text-grey-500", else: "text-grey-900")
          ]}
        >
          <div class="flex min-w-0 items-center gap-4">
            <.counterparty_icon counterparty={counterparty} archived={@live_action == :archive} />
            <div class="min-w-0">
              <.link
                kind="unstyled"
                navigate={counterparty_path(counterparty, @live_action, @params)}
                class="block truncate text-base/[1.35] hover:underline"
                title={counterparty.display_label}
              >
                {counterparty.display_label}
              </.link>
              <p
                :if={CounterpartyHelpers.identifier(counterparty) != "—"}
                class={[
                  "truncate text-sm/[1.35] md:hidden",
                  if(@live_action == :archive, do: "text-grey-500", else: "text-grey-700")
                ]}
              >
                {CounterpartyHelpers.identifier(counterparty)}
              </p>
            </div>
          </div>

          <p class={[
            "truncate text-right text-base/[1.35] max-md:hidden",
            identifier_color(counterparty, @live_action)
          ]}>
            {CounterpartyHelpers.identifier(counterparty)}
          </p>

          <p
            :if={@view == :cooperation_value}
            class={[
              "text-right text-base/[1.35] text-nowrap tabular-nums transition-[opacity,translate] delay-[calc(var(--row)*20ms)] duration-300 ease-out motion-reduce:transition-none max-md:hidden starting:translate-x-1 starting:opacity-0",
              if(@live_action == :archive, do: "text-grey-500", else: "text-grey-700")
            ]}
          >
            {cooperation_value_cell(counterparty.cooperation_value)}
          </p>

          <%= if @live_action == :archive do %>
            <p class="text-right text-base/[1.35] text-grey-900 max-md:hidden">
              {Calendar.strftime(counterparty.archived_at, "%d.%m.%Y")}
            </p>
            <.button
              type="button"
              variant="tertiary"
              size="small"
              class="max-md:hidden"
              phx-click="unarchive_counterparty"
              phx-value-id={counterparty.id}
            >
              {gettext("Restore")}
            </.button>
          <% end %>

          <.link
            kind="unstyled"
            navigate={counterparty_path(counterparty, @live_action, @params)}
            class="flex items-center"
            aria-label={gettext("Open counterparty %{name}", name: counterparty.display_label)}
          >
            <Lucideicons.chevron_right class="size-4 shrink-0 text-black" />
          </.link>
        </div>
      <% end %>
    </div>

    <aside
      :if={@counterparties != []}
      class="hidden w-80 shrink-0 flex-col gap-2.5 pt-8.75 min-[1800px]:flex"
    >
      <%= if @live_action == :archive do %>
        <.archive_summary counterparties={@counterparties} />
        <.panel_card title={pgettext("counterparties archive", "Restoring")}>
          <p class="text-sm/[1.35] text-grey-500">
            {gettext(
              "A restored counterparty returns to the active list with its whole history of invoices and transactions."
            )}
          </p>
        </.panel_card>
      <% else %>
        <.active_summary counterparties={@counterparties} />
        <.companies_without_identifier
          counterparties={@counterparties}
          live_action={@live_action}
          params={@params}
        />
      <% end %>
    </aside>
  </div>
</div>
