<div :if={not @zero_state?} class="mx-auto flex w-full max-w-7xl flex-1 flex-col gap-6 pb-4">
  <div class="sticky top-10.5 z-10 flex flex-col gap-6 bg-grey-100 py-4 max-md:static max-md:z-auto">
    <div class="flex items-center justify-between gap-4 max-md:flex-wrap">
      <form class="flex gap-4 max-md:w-full" phx-submit="search">
        <div class="flex h-11 w-[360px] items-center gap-2 rounded-lg border border-grey-200 bg-grey-100 p-1 focus-within:ring-2 max-md:w-full">
          <Lucideicons.search class="size-6 shrink-0 text-grey-500" />
          <.input
            type="text"
            name="szukaj"
            value={@search}
            placeholder={gettext("Search counterparties")}
            phx-change="search"
            phx-debounce="300"
            input_class="h-full bg-transparent! border-none py-0 px-1 text-sm"
            class="w-full border-transparent focus:border-none focus:ring-0 focus:outline-hidden"
          />
        </div>
      </form>

      <.page_actions>
        <:action>
          <.link
            navigate={
              Navigation.counterparty_new_path(%{
                powrot_do: Navigation.counterparties_path(@live_action, @params)
              })
            }
            kind="button"
            variant="special"
            data-fab
          >
            <Lucideicons.plus /> <span class="max-md:sr-only">{gettext("Add counterparty")}</span>
          </.link>
        </:action>
      </.page_actions>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-6 max-md:w-full max-md:flex-wrap max-md:gap-y-3">
        <.filter_tabs label={gettext("Counterparty scope")}>
          <:tab
            patch={Navigation.counterparties_path(:index, @params)}
            active={@live_action == :index}
          >
            {pgettext("people list tab", "Active")}
          </:tab>
          <:tab
            patch={Navigation.counterparties_path(:archive, @params)}
            active={@live_action == :archive}
          >
            {pgettext("people list tab", "Archived")}
          </:tab>
        </.filter_tabs>

        <.filter_pills divider>
          <:pill
            active={@type_filter == :individual}
            phx-click="toggle_type"
            phx-value-typ={Navigation.encode_counterparty_type(:individual)}
          >
            <Lucideicons.user /> {gettext("Individuals")}
          </:pill>
          <:pill
            active={@type_filter == :company}
            phx-click="toggle_type"
            phx-value-typ={Navigation.encode_counterparty_type(:company)}
          >
            <Lucideicons.building_2 /> {gettext("Company")}
          </:pill>
        </.filter_pills>
      </div>
      <.switch
        class="ml-auto flex-row-reverse gap-4 select-none max-md:hidden"
        label={gettext("Cooperation value")}
        field={@form[:view_cooperation_value]}
        phx-click="toggle_cooperation_value_view"
      />
    </div>
  </div>

  <%= cond do %>
    <% @counterparties_empty? -> %>
      <div class="flex flex-1 flex-col items-center justify-center gap-4 rounded-lg border border-grey-200 p-6">
        <%= if @search != "" or not is_nil(@type_filter) do %>
          <Lucideicons.file_x class="size-26 text-grey-300" />
          <p class="text-sm/snug text-grey-700">
            {gettext("We could not find the counterparty you are looking for.")}
          </p>
        <% else %>
          <Lucideicons.building_2 class="size-26 text-grey-300" />
          <p class="text-sm/snug text-grey-700">
            {case @live_action do
              :index -> gettext("You have no active counterparties to show.")
              :archive -> gettext("You have no archived counterparties to show.")
            end}
          </p>
        <% end %>
      </div>
    <% @live_action == :index -> %>
      <div
        id="counterparties-list"
        data-view={@view}
        class={[
          "group grid gap-x-6 gap-y-2",
          if(@view == :cooperation_value,
            do: "grid-cols-[3fr_1.2fr_1.2fr_min-content]",
            else: "grid-cols-[3fr_1.2fr_min-content]"
          )
        ]}
      >
        <div
          id="counterparties-list-header-active"
          class="sticky top-41 z-1 col-span-full grid grid-cols-subgrid bg-grey-100 px-4 pb-3 text-sm/snug text-grey-700 transition-all duration-75 max-md:static"
          phx-hook="ScrollStyle"
          data-classes="border-b-4 border-solid border-grey-700/40 pt-3"
          data-scroll-offset="90"
        >
          <p>{gettext("Counterparty")}</p>

          <p class="text-right">{gettext("Identifier")}</p>

          <%= if @view == :cooperation_value do %>
            <p class="text-right">{gettext("Cooperation value")}</p>
          <% end %>
        </div>

        <div
          id="counterparties-stream-active"
          phx-update="stream"
          class="col-span-full grid grid-cols-subgrid gap-y-2"
        >
          <div
            :for={{dom_id, counterparty} <- @streams.counterparties}
            id={dom_id}
            class="col-span-full grid h-14 grid-cols-subgrid items-center rounded-sm bg-white px-4 py-3"
          >
            <div class="flex items-center gap-4 truncate">
              <.counterparty_icon counterparty={counterparty} />
              <.link
                kind="unstyled"
                navigate={
                  Navigation.counterparty_path(counterparty.id, %{
                    powrot_do: Navigation.counterparties_path(@live_action, @params)
                  })
                }
                class="truncate hover:underline"
              >
                {counterparty.display_label}
              </.link>
            </div>
            <p class="text-right text-grey-700">
              <.counterparty_identifier counterparty={counterparty} />
            </p>
            <p class="hidden text-right text-grey-700 group-data-[view=cooperation\_value]:block">
              {cooperation_value_cell(counterparty.cooperation_value)}
            </p>
            <.link
              kind="unstyled"
              navigate={
                Navigation.counterparty_path(counterparty.id, %{
                  powrot_do: Navigation.counterparties_path(@live_action, @params)
                })
              }
              class="text-grey-500 hover:text-grey-700"
              aria-label={gettext("Open counterparty %{name}", name: counterparty.display_label)}
            >
              <Lucideicons.chevron_right class="size-4" />
            </.link>
          </div>
        </div>
      </div>
    <% true -> %>
      <div
        data-view={@view}
        class={[
          "group grid gap-x-6 gap-y-2",
          if(@view == :cooperation_value,
            do: "grid-cols-[3fr_1.2fr_1fr_1.2fr_min-content]",
            else: "grid-cols-[3fr_1.2fr_1fr_min-content]"
          )
        ]}
        id="counterparties-list"
      >
        <div
          id="counterparties-list-header-archive"
          class="sticky top-41 z-1 col-span-full grid grid-cols-subgrid bg-grey-100 px-4 pb-3 text-sm/snug text-grey-700 transition-all duration-75 max-md:static"
          phx-hook="ScrollStyle"
          data-classes="border-b-4 border-solid border-grey-700/40 pt-3"
          data-scroll-offset="90"
        >
          <p>{gettext("Counterparty")}</p>
          <p class="text-right">{gettext("Identifier")}</p>
          <p class="text-right text-nowrap">{gettext("Archived on")}</p>
          <%= if @view == :cooperation_value do %>
            <p class="text-right">{gettext("Cooperation value")}</p>
          <% end %>
        </div>

        <div
          id="counterparties-stream-archive"
          phx-update="stream"
          class="col-span-full grid grid-cols-subgrid gap-y-2"
        >
          <div
            :for={{dom_id, counterparty} <- @streams.counterparties}
            id={dom_id}
            class="col-span-full grid h-14 grid-cols-subgrid items-center rounded-sm bg-white px-4 py-3"
          >
            <div class="flex items-center gap-4 truncate">
              <.counterparty_icon counterparty={counterparty} />
              <.link
                kind="unstyled"
                navigate={
                  Navigation.counterparty_path(counterparty.id, %{
                    powrot_do: Navigation.counterparties_path(@live_action, @params)
                  })
                }
                class="truncate hover:underline"
              >
                {counterparty.display_label}
              </.link>
            </div>
            <p class="text-right text-grey-700">
              <.counterparty_identifier counterparty={counterparty} />
            </p>
            <p class="text-right text-grey-700">
              {Calendar.strftime(counterparty.archived_at, "%d.%m.%Y")}
            </p>
            <p class="hidden text-right text-grey-700 group-data-[view=cooperation\_value]:block">
              {cooperation_value_cell(counterparty.cooperation_value)}
            </p>
            <div class="flex items-center gap-3 justify-self-end">
              <.button
                type="button"
                variant="secondary"
                size="small"
                phx-click="unarchive_counterparty"
                phx-value-id={counterparty.id}
              >
                {gettext("Restore")}
              </.button>
              <.link
                kind="unstyled"
                navigate={
                  Navigation.counterparty_path(counterparty.id, %{
                    powrot_do: Navigation.counterparties_path(@live_action, @params)
                  })
                }
                class="text-grey-500 hover:text-grey-700"
                aria-label={
                  gettext("Open counterparty %{name}", name: counterparty.display_label)
                }
              >
                <Lucideicons.chevron_right class="size-4" />
              </.link>
            </div>
          </div>
        </div>
      </div>
  <% end %>
</div>

<div
  :if={@zero_state?}
  class="mx-auto flex size-full max-w-7xl flex-1 flex-col items-center justify-center rounded-lg border border-grey-200 p-8"
>
  <Lucideicons.building_2 class="size-26 text-grey-300" size={48} />

  <p class="mt-4 text-center text-sm/snug text-balance text-grey-700">
    {gettext("You do not have any counterparties yet. Add the first one by clicking below.")}
  </p>

  <.link
    navigate={
      Navigation.counterparty_new_path(%{
        powrot_do: Navigation.counterparties_path(@live_action, @params)
      })
    }
    kind="button"
    variant="secondary"
    class="mt-6"
  >
    <Lucideicons.plus /> <span class="max-md:sr-only">{gettext("Add counterparty")}</span>
  </.link>
</div>
