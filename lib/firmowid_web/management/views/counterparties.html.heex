<div :if={not @zero_state?} class="mx-auto flex w-full max-w-7xl flex-1 flex-col gap-6 pb-4">
  <div class="sticky top-10.5 z-10 flex flex-col gap-6 bg-grey-100 py-4">
    <div class="flex items-center justify-between gap-4">
      <form class="flex gap-4" phx-submit="search">
        <.search_field
          name="szukaj"
          value={@search}
          placeholder="Wyszukaj kontrahenta"
          size="big"
          phx-change="search"
          phx-debounce="300"
          class="w-[360px]"
        />
      </form>

      <.link
        navigate={
          Navigation.counterparty_new_path(%{
            powrot_do: Navigation.counterparties_path(@live_action, @params)
          })
        }
        kind="button"
        variant="special"
      >
        <Lucideicons.plus /> Dodaj kontrahenta
      </.link>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap items-center gap-6">
        <.segmented_control label="Zakres listy">
          <:option
            patch={Navigation.counterparties_path(:index, @params)}
            active={@live_action == :index}
          >
            Aktywni
          </:option>
          <:option
            patch={Navigation.counterparties_path(:archive, @params)}
            active={@live_action == :archive}
          >
            Zarchiwizowani
          </:option>
        </.segmented_control>

        <div class="mx-2 h-6 w-px bg-grey-200"></div>

        <div class="flex items-center gap-3">
          <span class="text-sm font-normal text-grey-700/70">Filtry:</span>

          <div class="flex flex-wrap items-center gap-2">
            <.button
              type="button"
              variant="filter"
              data-active={@type_filter == :individual}
              phx-click="toggle_type"
              phx-value-typ={Navigation.encode_counterparty_type(:individual)}
            >
              <Lucideicons.user class="size-4" /> Osoby fizyczne
            </.button>

            <.button
              type="button"
              variant="filter"
              data-active={@type_filter == :company}
              phx-click="toggle_type"
              phx-value-typ={Navigation.encode_counterparty_type(:company)}
            >
              <Lucideicons.building_2 class="size-4" /> Firma
            </.button>
          </div>
        </div>
      </div>
      <.switch
        class="ml-auto flex-row-reverse gap-4 select-none"
        label="Wartość współpracy"
        field={@form[:view_cooperation_value]}
        phx-click="toggle_cooperation_value_view"
      />
    </div>
  </div>

  <%= cond do %>
    <% @counterparties_empty? -> %>
      <%= if @search != "" or not is_nil(@type_filter) do %>
        <.empty_state
          title="Nie znaleźliśmy szukanego kontrahenta."
          class="flex-1 justify-center"
        >
          <:icon><Lucideicons.file_x /></:icon>
        </.empty_state>
      <% else %>
        <.empty_state
          title={
            case @live_action do
              :index -> "Nie masz aktywnych kontrahentów do wyświetlenia."
              :archive -> "Nie masz zarchiwizowanych kontrahentów do wyświetlenia."
            end
          }
          class="flex-1 justify-center"
        >
          <:icon><Lucideicons.building_2 /></:icon>
        </.empty_state>
      <% end %>
    <% @live_action == :index -> %>
      <div
        id="counterparties-list"
        data-view={@view}
        class={[
          "group grid gap-x-6 gap-y-2",
          if(@view == :cooperation_value,
            do: "grid-cols-[3fr_1.2fr_1.2fr_min-content]",
            else: "grid-cols-[3fr_1.2fr_min-content]"
          )
        ]}
      >
        <div
          id="counterparties-list-header-active"
          class="sticky top-41 z-1 col-span-full grid grid-cols-subgrid bg-grey-100 px-4 pb-3 text-sm/snug text-grey-700 transition-all duration-75"
          phx-hook="ScrollStyle"
          data-classes="border-b-4 border-solid border-grey-700/40 pt-3"
          data-scroll-offset="90"
        >
          <p>Kontrahent</p>

          <p class="text-right">Identyfikator</p>

          <%= if @view == :cooperation_value do %>
            <p class="text-right">Wartość współpracy</p>
          <% end %>
        </div>

        <div
          id="counterparties-stream-active"
          phx-update="stream"
          class="col-span-full grid grid-cols-subgrid gap-y-2"
        >
          <div
            :for={{dom_id, counterparty} <- @streams.counterparties}
            id={dom_id}
            class="col-span-full grid h-14 grid-cols-subgrid items-center rounded-sm bg-white px-4 py-3"
          >
            <div class="flex items-center gap-4 truncate">
              <.counterparty_icon counterparty={counterparty} />
              <.link
                kind="unstyled"
                navigate={
                  Navigation.counterparty_path(counterparty.id, %{
                    powrot_do: Navigation.counterparties_path(@live_action, @params)
                  })
                }
                class="truncate hover:underline"
              >
                {counterparty.display_label}
              </.link>
            </div>
            <p class="text-right text-grey-700">
              <.counterparty_identifier counterparty={counterparty} />
            </p>
            <p class="hidden text-right text-grey-700 group-data-[view=cooperation\_value]:block">
              {cooperation_value_cell(counterparty.cooperation_value)}
            </p>
            <.link
              kind="unstyled"
              navigate={
                Navigation.counterparty_path(counterparty.id, %{
                  powrot_do: Navigation.counterparties_path(@live_action, @params)
                })
              }
              class="text-grey-500 hover:text-grey-700"
            >
              <Lucideicons.chevron_right class="size-4" />
            </.link>
          </div>
        </div>
      </div>
    <% true -> %>
      <div
        data-view={@view}
        class={[
          "group grid gap-x-6 gap-y-2",
          if(@view == :cooperation_value,
            do: "grid-cols-[3fr_1.2fr_1fr_1.2fr_min-content]",
            else: "grid-cols-[3fr_1.2fr_1fr_min-content]"
          )
        ]}
        id="counterparties-list"
      >
        <div
          id="counterparties-list-header-archive"
          class="sticky top-41 z-1 col-span-full grid grid-cols-subgrid bg-grey-100 px-4 pb-3 text-sm/snug text-grey-700 transition-all duration-75"
          phx-hook="ScrollStyle"
          data-classes="border-b-4 border-solid border-grey-700/40 pt-3"
          data-scroll-offset="90"
        >
          <p>Kontrahent</p>
          <p class="text-right">Identyfikator</p>
          <p class="text-right text-nowrap">Data archiwizacji</p>
          <%= if @view == :cooperation_value do %>
            <p class="text-right">Wartość współpracy</p>
          <% end %>
        </div>

        <div
          id="counterparties-stream-archive"
          phx-update="stream"
          class="col-span-full grid grid-cols-subgrid gap-y-2"
        >
          <div
            :for={{dom_id, counterparty} <- @streams.counterparties}
            id={dom_id}
            class="col-span-full grid h-14 grid-cols-subgrid items-center rounded-sm bg-white px-4 py-3"
          >
            <div class="flex items-center gap-4 truncate">
              <.counterparty_icon counterparty={counterparty} />
              <.link
                kind="unstyled"
                navigate={
                  Navigation.counterparty_path(counterparty.id, %{
                    powrot_do: Navigation.counterparties_path(@live_action, @params)
                  })
                }
                class="truncate hover:underline"
              >
                {counterparty.display_label}
              </.link>
            </div>
            <p class="text-right text-grey-700">
              <.counterparty_identifier counterparty={counterparty} />
            </p>
            <p class="text-right text-grey-700">
              {Calendar.strftime(counterparty.archived_at, "%d.%m.%Y")}
            </p>
            <p class="hidden text-right text-grey-700 group-data-[view=cooperation\_value]:block">
              {cooperation_value_cell(counterparty.cooperation_value)}
            </p>
            <div class="flex items-center gap-3 justify-self-end">
              <.button
                type="button"
                variant="secondary"
                size="small"
                phx-click="unarchive_counterparty"
                phx-value-id={counterparty.id}
              >
                Przywróć
              </.button>
              <.link
                kind="unstyled"
                navigate={
                  Navigation.counterparty_path(counterparty.id, %{
                    powrot_do: Navigation.counterparties_path(@live_action, @params)
                  })
                }
                class="text-grey-500 hover:text-grey-700"
              >
                <Lucideicons.chevron_right class="size-4" />
              </.link>
            </div>
          </div>
        </div>
      </div>
  <% end %>
</div>

<.empty_state
  :if={@zero_state?}
  title="Nie masz jeszcze żadnych kontrahentów."
  class="mx-auto size-full max-w-7xl flex-1 justify-center"
>
  <:icon><Lucideicons.building_2 /></:icon>
  Dodaj pierwszego, klikając poniżej.
  <:action>
    <.link
      navigate={
        Navigation.counterparty_new_path(%{
          powrot_do: Navigation.counterparties_path(@live_action, @params)
        })
      }
      kind="button"
      variant="secondary"
    >
      <Lucideicons.plus /> Dodaj kontrahenta
    </.link>
  </:action>
</.empty_state>
