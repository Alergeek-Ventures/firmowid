<div class="mx-auto flex w-full max-w-7xl flex-col gap-3 pb-4">
  <% # top -> collapsed navbar height (56px) / TODO: refactor %>
  <div class="sticky top-10.5 z-10 flex flex-col gap-6 bg-grey-100 py-4">
    <div class="flex items-center justify-between max-md:flex-col max-md:items-stretch max-md:gap-3">
      <form class="flex gap-4 max-md:gap-3" phx-submit="search">
        <.month_picker
          id="month"
          show_on_mobile
          selected_date={@selected_date}
          active_months={@active_months}
          class="max-md:flex-1"
        />

        <div
          id="search-container"
          data-expanded={to_string(@search != "")}
          class="group flex min-w-10 items-center justify-center rounded-lg bg-grey-200 transition-shadow data-[expanded=true]:focus-within:ring-2"
        >
          <.input
            type="text"
            name="szukaj"
            value={@search}
            placeholder="Szukaj pracownika"
            phx-change="search"
            phx-debounce="300"
            input_class="py-0 px-1 bg-transparent border-none"
            class="w-0 border-transparent px-0 opacity-0 transition-[width,opacity,padding] duration-200 ease-in-out group-data-[expanded=true]:w-64 group-data-[expanded=true]:px-2 group-data-[expanded=true]:py-1 group-data-[expanded=true]:opacity-100 focus:border-none focus:ring-0 focus:outline-hidden max-md:group-data-[expanded=true]:w-36"
          />
          <.button
            type="button"
            phx-click={
              JS.toggle_attribute({"data-expanded", "true", "false"}, to: "#search-container")
              |> JS.focus(to: "#search-container input")
            }
            variant="secondary"
          >
            <Lucideicons.search />
          </.button>
        </div>
      </form>

      <div class="flex gap-4">
        <.link
          :if={@can_export_csv}
          kind="button"
          variant="secondary"
          size="big"
          download
          redirect={TimetrackerNavigation.salaries_csv_path(@selected_date)}
          class="max-md:hidden"
        >
          <Lucideicons.file_text /> Raport wypłat
        </.link>
        <.link
          navigate={~p"/zaproszenia"}
          kind="button"
          variant="special"
          class="max-md:w-full max-md:justify-center"
        >
          <.icon name="hero-plus-mini" class="size-6" /> Dodaj pracownika
        </.link>
      </div>
    </div>

    <div class="flex gap-4">
      <.link
        :for={
          {path, live_action, label} <- [
            {Navigation.employees_path(:index, @params), :index, "Aktywni"},
            {Navigation.employees_path(:archive, @params), :archive, "Zarchiwizowani"}
          ]
        }
        patch={path}
        kind="button"
        variant="ghost"
        size="small"
        class={[
          "max-md:flex-1",
          @live_action == live_action && "bg-grey-700 text-white hover:text-grey-900"
        ]}
      >
        {label}
      </.link>
      <.switch
        class="ml-auto flex-row-reverse gap-4 max-md:hidden"
        label="Widok wypłat"
        field={@form[:viewing_wages]}
        phx-click="toggle_wages_view"
      />
    </div>
  </div>

  <form
    phx-submit="save_wages"
    class={[
      "grid gap-x-6 gap-y-2",
      @view == :standard && @live_action == :index &&
        "grid-cols-[1fr_min-content_min-content_min-content] max-md:grid-cols-[1fr_min-content_min-content]",
      @view == :standard && @live_action == :archive &&
        "grid-cols-[1fr_min-content_min-content_min-content_min-content] max-md:grid-cols-[1fr_min-content_min-content_min-content]",
      @view != :standard && @live_action == :index &&
        "grid-cols-[minmax(10rem,2fr)_max-content_repeat(3,minmax(6rem,1fr))_min-content_min-content]",
      @view != :standard && @live_action == :archive &&
        "grid-cols-[minmax(10rem,2fr)_max-content_max-content_repeat(3,minmax(6rem,1fr))_min-content_min-content]"
    ]}
  >
    <div
      id="employees-list-header"
      class="sticky top-41 z-1 col-span-full grid h-11 grid-cols-subgrid items-center bg-grey-100 px-4 text-sm/snug text-grey-700 transition-all duration-75"
      phx-hook="ScrollStyle"
      data-classes="border-b-4 border-solid border-grey-700/40 pt-3"
      data-scroll-offset="90"
    >
      <p>Pracownik</p>
      <p class="text-end text-nowrap">{gettext("Hours")}</p>

      <%= if @live_action == :archive do %>
        <p class="text-right text-nowrap">Data archiwizacji</p>
      <% end %>

      <%= if @view in [:wages, :wage_editor] do %>
        <%= case @view do %>
          <% :wages -> %>
            <%= if @selected_date in @editable_months do %>
              <.button
                phx-click="toggle_wage_editor"
                type="button"
                variant="ghost"
                size="small"
                class="justify-self-end"
              >
                Stawka <.icon name="hero-pencil-square-solid" class="size-4" />
              </.button>
            <% else %>
              <p class="text-right text-nowrap">Stawka</p>
            <% end %>
          <% :wage_editor -> %>
            <div class="flex gap-2 justify-self-end">
              <.button
                id="wage-editor-toggle"
                variant="secondary"
                size="small"
                class="size-8 p-0 text-grey-700"
                phx-click="toggle_wage_editor"
                phx-hook="ConfirmLeave"
                data-confirm-leave
                data-unsaved={true}
                type="button"
                aria-label={gettext("Cancel editing rates")}
              >
                <.icon name="hero-arrow-uturn-left-micro" class="size-4" />
              </.button>
              <.button
                variant="secondary"
                accent="rust"
                size="small"
                class="w-22 text-caps-sm/tight font-medium uppercase"
                type="submit"
              >
                Zapisz
              </.button>
            </div>
        <% end %>

        <p class="text-end text-nowrap">{gettext("Gross")}</p>
        <p class="text-end text-nowrap">{gettext("Net forecast")}</p>
      <% end %>
      <span />
      <p class="text-end text-nowrap max-md:hidden">{gettext("Timesheet")}</p>
    </div>

    <%= if Enum.empty?(@employees) do %>
      <div class="col-span-full py-10 text-center text-grey-700">
        <%= if @search != "" do %>
          Brak wyników. Spróbuj zmienić kryteria wyszukiwania.
        <% else %>
          <%= case @live_action do %>
            <% :index -> %>
              Brak aktywnych pracowników do wyświetlenia.
            <% :archive -> %>
              Brak zarchiwizowanych pracowników do wyświetlenia.
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div
        :for={employee <- @employees}
        :key={employee.user.id}
        class="col-span-full grid h-14 grid-cols-subgrid"
      >
        <div class={[
          "grid grid-cols-subgrid items-center rounded-sm bg-white px-4",
          cond do
            @view == :standard and @live_action == :index -> "col-span-3"
            @view == :standard and @live_action == :archive -> "col-span-4"
            @view != :standard and @live_action == :index -> "col-span-6"
            true -> "col-span-7"
          end
        ]}>
          <div class="flex min-w-0 items-center gap-3">
            <.avatar class="size-8 shrink-0 ring-1 ring-grey-200/50">
              <.avatar_image
                :if={Map.get(employee.user.member.avatar_blob || %{}, :url)}
                src={Map.get(employee.user.member.avatar_blob || %{}, :url)}
                alt="Avatar"
              />
              <.avatar_fallback class="bg-teal-200 text-teal-800">
                {to_string(employee.user.member.name || employee.user.email || "")
                |> String.slice(0, 1)
                |> String.upcase()}
              </.avatar_fallback>
            </.avatar>
            <%= if @can_export_csv do %>
              <.link
                kind="unstyled"
                navigate={Navigation.employee_path(employee.user.id, %{miesiac: @selected_date})}
                class="min-w-0 truncate hover:underline"
                title={employee.user.member.name || to_string(employee.user.email)}
              >
                {employee.user.member.name || employee.user.email}
              </.link>
            <% else %>
              <span>{employee.user.member.name || employee.user.email}</span>
            <% end %>
            <span
              :if={@view != :standard and employee.payout_estimate}
              class="shrink-0 rounded-sm bg-grey-100 px-1.5 py-0.5 text-xs/snug text-grey-700"
            >
              {PayoutEstimates.contract_label(employee.payout_estimate.variant)}
            </span>
          </div>

          <p class="text-right">
            {Timetracker.seconds_to_hours(employee.time_worked)} h
          </p>

          <%= if @live_action == :archive do %>
            <p class="text-right text-black">
              <%= if employee.user.member.archived_at do %>
                {Calendar.strftime(employee.user.member.archived_at, "%d.%m.%Y")}
              <% end %>
            </p>
          <% end %>

          <%= if @view in [:wages, :wage_editor] do %>
            <%= case @view do %>
              <% :wages -> %>
                <p class="mx-2 text-right">
                  {Decimal.round(employee.hourly_rate || 0)} zł/godz.
                </p>
              <% :wage_editor -> %>
                <div class="mx-2 flex items-center gap-1 justify-self-end">
                  <.input
                    type="number"
                    class="w-14"
                    input_class="text-right"
                    step="0.01"
                    min="0"
                    name={"employee[#{employee.user.id}][wage]"}
                    value={Decimal.round(employee.hourly_rate || 0)}
                  />
                  <p>zł/godz.</p>
                </div>
            <% end %>

            <p class="text-end text-nowrap text-grey-700 tabular-nums">
              {employee.monthly_gross}
            </p>
            <p
              class="text-end font-medium text-nowrap text-teal-700 tabular-nums"
              title={
                if employee.payout_estimate,
                  do: PayoutEstimates.variant_label(employee.payout_estimate.variant),
                  else: gettext("Unknown contract type — only gross pay is shown")
              }
            >
              {if employee.payout_estimate, do: employee.payout_estimate.amount, else: "—"}
            </p>
          <% end %>

          <div class="flex items-center justify-end gap-3">
            <.button
              :if={@live_action == :archive}
              type="button"
              variant="secondary"
              size="small"
              phx-click="unarchive_employee"
              phx-value-id={employee.user.id}
            >
              Przywróć
            </.button>
            <%= if @can_export_csv do %>
              <.link
                kind="unstyled"
                navigate={Navigation.employee_path(employee.user.id, %{miesiac: @selected_date})}
                class="flex items-center"
                aria-label={
                  gettext("Show details of employee %{name}",
                    name: employee.user.member.name || employee.user.email
                  )
                }
              >
                <Lucideicons.chevron_right class="size-4 shrink-0 text-grey-700" />
              </.link>
            <% else %>
              <div />
            <% end %>
          </div>
        </div>

        <div class="ml-2 flex items-center gap-4 rounded-sm bg-white p-4 max-md:hidden">
          <.hours_record_status hours_record={employee.hours_record} user={employee.user} />

          <.button
            type="button"
            variant="unstyled"
            id={"copy-bank-number-#{employee.user.id}"}
            phx-hook="CopyToClipboard"
            disabled={is_nil(employee.user.member.bank_account_number)}
            phx-click="copy-bank-number"
            phx-value-number={employee.user.member.bank_account_number}
            aria-label={gettext("Copy bank account number")}
            class="inline-flex items-center justify-center text-grey-700 transition hover:text-grey-800 active:scale-95 active:text-grey-900 disabled:text-grey-400"
          >
            <.icon name="hero-credit-card-micro" class="size-6 shrink-0" />
          </.button>
        </div>
      </div>
    <% end %>
  </form>
</div>
