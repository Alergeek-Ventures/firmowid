<div class="mx-auto my-4 flex w-full max-w-7xl flex-col gap-6">
  <div class="flex items-center justify-between">
    <form class="flex gap-5" phx-submit="search">
      <.date_picker
        id="month"
        selected_date={@selected_date}
        active_months={@active_months}
      />
      <div class={[
        @search_expanded && "focus-within:ring-2",
        "bg-greyButtonBg flex min-w-10 items-center justify-center rounded-[5px] transition-shadow"
      ]}>
        <.input
          type="text"
          name="q"
          value={@search}
          placeholder="Szukaj pracownika"
          phx-change="search"
          phx-debounce="300"
          input_class="py-0 px-1 bg-transparent border-none"
          class={[
            "border-transparent transition-[width,opacity,padding] duration-300 ease-in-out",
            "focus:border-none focus:ring-0 focus:outline-hidden",
            @search_expanded && "w-64 px-2 py-1 opacity-100",
            !@search_expanded && "w-0 px-0 opacity-0"
          ]}
        />
        <.button
          type="button"
          phx-click="toggle_search"
          color="none"
          class="text-darkGrey flex border-none bg-transparent p-2"
          id="search-button"
        >
          <.icon name="hero-magnifying-glass" class="size-5" />
        </.button>
      </div>
    </form>

    <div class="flex gap-4">
      <.link
        :if={@can_export_csv}
        class={button_styles(%{variant: "ghost", size: "small", new: true})}
        download
        href={
          ~p"/czasosledz/projekty/csv?month=#{@selected_date.month}&year=#{@selected_date.year}"
        }
      >
        <Lucideicons.cloud_download class="size-4" /> Pobierz raport wypłat
      </.link>
      <.link
        navigate="/zaproszenia"
        class={button_styles(%{new: true, color: "light_grey", size: "medium"})}
      >
        <.icon name="hero-plus-mini" class="size-6" /> Dodaj pracownika
      </.link>
    </div>
  </div>

  <div class="flex gap-4">
    <.switch
      class="ml-auto flex-row-reverse gap-4"
      label="Widok wypłat"
      field={@form[:viewing_wages]}
      phx-click="toggle_wages_view"
    />
  </div>

  <form
    phx-submit="save_wages"
    class={[
      "grid gap-x-6 gap-y-2",
      @view == :standard && "grid-cols-[1fr_min-content_min-content_min-content]",
      @view != :standard && "grid-cols-[2fr_1fr_1fr_1fr_min-content_min-content]"
    ]}
  >
    <div class="text-grey-700 col-span-full grid h-11 grid-cols-subgrid items-center px-4 text-sm/snug">
      <p>Pracownik</p>
      <p class="text-right text-nowrap">Przepracowane godziny</p>

      <%= if @view in [:wages, :wage_editor] do %>
        <%= case @view do %>
          <% :wages -> %>
            <button
              phx-click="toggle_wage_editor"
              type="button"
              class="hover:bg-grey-200 flex items-center gap-1.5 justify-self-end rounded-sm px-2 py-1 transition"
            >
              Stawka <.icon name="hero-pencil-square-solid" class="size-4" />
            </button>
          <% :wage_editor -> %>
            <div class="flex gap-2 justify-self-end">
              <button
                id="wage-editor-toggle"
                class="bg-grey-200 text-grey-700 inline-flex rounded-sm px-3 py-1"
                phx-click="toggle_wage_editor"
                phx-hook="ConfirmLeave"
                data-unsaved={true}
                type="button"
              >
                <.icon name="hero-arrow-uturn-left-micro" class="size-4" />
              </button>
              <button
                class="text-caps-sm/tight w-22 rounded-sm bg-orange-200 px-3 py-1 font-medium text-orange-700 uppercase"
                type="submit"
              >
                Zapisz
              </button>
            </div>
        <% end %>

        <p class="text-right">Wynagrodzenie</p>
      <% end %>
    </div>

    <%= if Enum.empty?(@employees) do %>
      <div class="text-darkGrey col-span-full py-10 text-center">
        Brak wyników. Spróbuj zmienić kryteria wyszukiwania.
      </div>
    <% else %>
      <div
        :for={employee <- @employees}
        :key={employee.user.id}
        class="col-span-full grid h-14 grid-cols-subgrid"
      >
        <div class={[
          "grid grid-cols-subgrid items-center rounded-sm bg-white px-4",
          if(@view == :standard, do: "col-span-3", else: "col-span-5")
        ]}>
          <div class="flex items-center gap-4">
            <.avatar><.icon name="hero-user" class="size-8" /></.avatar>
            <%= if @can_export_csv do %>
              <.link
                navigate={~p"/zarzadzanie/pracownicy/#{employee.user.id}"}
                class="hover:underline"
              >
                {employee.user.name || employee.user.email}
              </.link>
            <% else %>
              <span>{employee.user.name || employee.user.email}</span>
            <% end %>
          </div>

          <p class="text-right">
            {Timetracker.seconds_to_hours(employee.time_worked)} h
          </p>

          <%= if @view in [:wages, :wage_editor] do %>
            <%= case @view do %>
              <% :wages -> %>
                <p class="mx-2 text-right">
                  {Decimal.round(employee.hourly_rate || 0)} zł/godz.
                </p>
              <% :wage_editor -> %>
                <div class="mx-2 flex items-center gap-1 justify-self-end">
                  <.input
                    type="number"
                    class="w-14"
                    input_class="text-right"
                    new={true}
                    step="0.01"
                    min="0"
                    name={"employee[#{employee.user.id}][wage]"}
                    value={Decimal.round(employee.hourly_rate || 0)}
                  />
                  <p>zł/godz.</p>
                </div>
            <% end %>

            <p class="text-right font-medium">
              {:PLN
              |> Money.new(
                employee.time_worked
                |> Timetracker.seconds_to_hours()
                |> Decimal.new()
                |> Decimal.mult(employee.hourly_rate || 0)
              )
              |> Money.to_string!(fractional_digits: 0, currency_symbol: "PLN")}
            </p>
          <% end %>

          <%= if @can_export_csv do %>
            <.link
              navigate={~p"/zarzadzanie/pracownicy/#{employee.user.id}"}
              class="flex items-center"
            >
              <Lucideicons.chevron_right class="text-grey-700 size-4 shrink-0" />
            </.link>
          <% else %>
            <div />
          <% end %>
        </div>

        <div class="ml-2 flex items-center gap-4 rounded-sm bg-white p-4">
          <.hours_record_status hours_record={employee.hours_record} user={employee.user} />

          <button
            type="button"
            id={"copy-bank-number-#{employee.user.id}"}
            phx-hook="Tippy"
            data-tippy-content="Skopiuj numer konta"
            disabled={is_nil(employee.user.bank_account_number)}
            onclick={"navigator.clipboard.writeText('#{employee.user.bank_account_number}')"}
            class="active:text-grey-900 disabled:text-grey-400 hover:text-grey-800 text-grey-700 inline-flex transition active:scale-95"
          >
            <.icon name="hero-credit-card-micro" class="size-6 shrink-0" />
          </button>
        </div>
      </div>
    <% end %>
  </form>
</div>
