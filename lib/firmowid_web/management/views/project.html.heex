<div class="mx-auto my-4 grid w-full max-w-screen-2xl grid-cols-[96px_minmax(0,1fr)_96px] items-start gap-x-10 max-md:my-0 max-md:grid-cols-1 max-md:gap-y-6">
  <.back
    navigate={Navigation.projects_path(:index, %{miesiac: @selected_date})}
    class="pt-0.5 max-md:justify-self-start"
  />
  <div class="mx-auto w-full max-w-7xl space-y-8">
    <div class="flex flex-row items-start justify-between gap-4 max-md:flex-col">
      <div class="min-w-0 space-y-1">
        <p class="text-sm/snug text-grey-500">
          {CounterpartyHelpers.party_label(@project.counterparty, @current_org)}
        </p>
        <p class="flex flex-row flex-wrap items-center gap-x-4 gap-y-2 text-2xl/tight font-medium wrap-break-word">
          {@project.name}
          <span
            :if={@project.archived_at}
            class="inline-flex items-center gap-2 rounded-full bg-grey-200 px-4 py-1 text-sm/snug font-normal text-grey-700"
          >
            <Lucideicons.archive class="size-4" /> zarchiwizowany
          </span>
        </p>
      </div>

      <div
        :if={!@project.archived_at}
        class="flex flex-row gap-4 max-md:w-full max-md:flex-wrap max-md:gap-3"
      >
        <.button variant="outline" type="button" phx-click="archive_project">
          Archiwizuj
        </.button>
        <.link
          navigate={~p"/zarzadzanie/projekty/#{@project.id}/edycja"}
          kind="button"
          variant="outline"
        >
          <Lucideicons.square_pen /> Edytuj
        </.link>

        <.month_picker
          id="project_date_picker"
          show_on_mobile
          selected_date={@selected_date}
          active_months={@active_months}
          class="ml-2 max-md:order-first max-md:ml-0 max-md:w-full"
        />
      </div>
    </div>

    <div
      :if={@project.archived_at}
      class="flex flex-row items-center gap-4 rounded-lg bg-grey-200 p-4 text-grey-700 shadow-card max-md:flex-wrap"
    >
      <Lucideicons.info class="size-4 shrink-0" />

      <p class="text-sm/snug text-balance max-md:basis-[calc(100%-2rem)]">
        Projekt został zarchiwizowany {Firmowid.Cldr.Date.to_string!(@project.archived_at,
          format: :long
        )}. Dane są dostępne tylko do odczytu. Aby edytować projekt lub rejestrować czas, przywróć go do aktywnych.
      </p>

      <.button
        :if={@current_user.member.role == :admin}
        variant="tertiary"
        size="small"
        type="button"
        phx-click="unarchive_project"
      >
        Przywróć projekt
      </.button>
      <.button
        :if={@can_delete_project}
        variant="destructive"
        size="small"
        type="button"
        phx-click={show_modal("delete_project_modal")}
      >
        Usuń projekt
      </.button>
    </div>

    <div class="flex flex-col gap-8">
      <div class="grid grid-cols-4 gap-4 max-md:grid-cols-2 max-md:gap-3">
        <div class="rounded-sm bg-white p-4">
          <p class="mb-6 leading-snug text-grey-500">Przepracowane godziny</p>
          <p class="mb-1 text-lg/tight font-medium text-black">
            {format_hours(@total_time_worked)}
          </p>

          <%= cond do %>
            <% @project.archived_at -> %>
              <p class="text-sm/snug text-grey-500">
                Stan końcowy
              </p>
            <% @cost_delta -> %>
              <p class={[
                "text-sm/snug",
                case @hours_delta.direction do
                  :increase -> "text-moss-600"
                  :decrease -> "text-brick-700"
                  :same -> "text-grey-500"
                end
              ]}>
                {comparison_text(@hours_delta, @previous_month_label)}
              </p>
            <% true -> %>
          <% end %>
        </div>

        <div class="rounded-sm bg-white p-4">
          <p class="mb-6 leading-snug text-grey-500">Koszty pracowników</p>
          <p class="mb-1 text-lg/tight font-medium text-black">
            <%= if @total_cost do %>
              {:PLN
              |> Money.new(@total_cost)
              |> Money.to_string!(fractional_digits: 0)}
            <% else %>
              —
            <% end %>
          </p>

          <%= cond do %>
            <% @project.archived_at -> %>
              <p class="text-sm/snug text-grey-500">
                Stan końcowy
              </p>
            <% @cost_delta -> %>
              <p class={[
                "text-sm/snug",
                case @cost_delta.direction do
                  :increase -> "text-brick-700"
                  :decrease -> "text-moss-600"
                  :same -> "text-grey-500"
                end
              ]}>
                {comparison_text(@cost_delta, @previous_month_label)}
              </p>
            <% true -> %>
          <% end %>
        </div>
      </div>
      <div class="space-y-4 rounded-sm bg-white p-4">
        <div class="flex flex-row items-center justify-between">
          <p class="text-lg/tight">
            Pracownicy
          </p>

          <.button
            :if={!@project.archived_at}
            disabled={Enum.empty?(@project.members)}
            type="button"
            variant="ghost"
            size="small"
            phx-hook="DownloadPdf"
            data-download-url={
              TimetrackerNavigation.project_csv_path(@project.id, @selected_date)
            }
          >
            <span data-download-idle class="inline-flex items-center gap-1.5">
              <Lucideicons.cloud_download /> Pobierz raport
            </span>
            <span data-download-loading class="hidden items-center gap-1.5">
              <Lucideicons.loader_circle class="size-4 animate-spin" /> Pobieranie…
            </span>
          </.button>
        </div>

        <%= if not Enum.empty?(@project.members) do %>
          <div class="grid grid-cols-[1fr_repeat(3,minmax(min-content,6rem))_min-content] items-center gap-x-4 gap-y-2 max-md:grid-cols-[minmax(0,1fr)_repeat(2,max-content)_min-content] max-md:gap-x-3">
            <div class="col-span-full grid grid-cols-subgrid px-2 py-1 text-sm text-grey-500">
              <p>Imię i nazwisko</p>
              <p class="text-right max-md:hidden">Stawka</p>

              <p class="text-right">Godziny</p>
              <p class="text-right">Koszt</p>
              <div></div>
            </div>

            <div class="col-span-full grid grid-cols-subgrid gap-y-0 divide-y-2 divide-grey-100">
              <div
                :for={user <- @users}
                class="col-span-full grid grid-cols-subgrid items-center border-grey-100 py-3 pr-4 pl-2 first:border-t-2 last:border-b-2 max-md:pr-2"
              >
                <div class="flex min-w-0 flex-row items-center gap-4 max-md:gap-2">
                  <.avatar class="size-8 shrink-0 ring-1 ring-grey-200/50">
                    <.avatar_image
                      :if={Map.get(user.member.avatar_blob || %{}, :url)}
                      src={Map.get(user.member.avatar_blob || %{}, :url)}
                      alt="Avatar"
                    />
                    <.avatar_fallback class="bg-teal-200 text-teal-800">
                      {to_string(user.member.name || user.email || "")
                      |> String.slice(0, 1)
                      |> String.upcase()}
                    </.avatar_fallback>
                  </.avatar>
                  <p class="min-w-0 leading-snug wrap-break-word">
                    {user.member.name || user.email}
                  </p>
                </div>

                <p class="text-right text-grey-500 max-md:hidden">
                  <%= if user.hourly_rate do %>
                    {:PLN
                    |> Money.new(user.hourly_rate)
                    |> Money.to_string!(fractional_digits: 0)}/godz.
                  <% else %>
                    —
                  <% end %>
                </p>

                <p class="text-right text-grey-900">
                  {format_hours(user.time_worked)}
                </p>

                <p class="text-right text-grey-900">
                  <%= if user.cost do %>
                    {:PLN
                    |> Money.new(user.cost)
                    |> Money.to_string!(fractional_digits: 0)}
                  <% else %>
                    —
                  <% end %>
                </p>
                <.button
                  :if={!@project.archived_at}
                  phx-click="toggle-user"
                  type="button"
                  variant="unstyled"
                  phx-value-id={user.id}
                  disabled={user.time_worked == 0}
                  aria-label={
                    if user.expanded, do: gettext("Hide sessions"), else: gettext("Show sessions")
                  }
                  aria-expanded={to_string(user.expanded)}
                  class="inline-flex items-center justify-center disabled:opacity-50"
                >
                  <%= if user.expanded do %>
                    <Lucideicons.chevron_up class="size-4 text-grey-900" />
                  <% else %>
                    <Lucideicons.chevron_down class="size-4 text-grey-900" />
                  <% end %>
                </.button>

                <div
                  :if={user.expanded}
                  class="col-span-full grid grid-cols-subgrid gap-y-4 pt-4 pb-3"
                >
                  <div
                    :for={session <- user.sessions_with_duration}
                    class="col-span-full grid grid-cols-subgrid pl-12 leading-snug text-grey-700 max-md:pl-10"
                  >
                    <p>{session.title}</p>
                    <p class="col-start-3 text-right max-md:col-start-2">
                      {TimeFormatter.format_duration(session.duration)}
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-span-full grid grid-cols-subgrid items-center p-2 leading-snug">
              <p class="text-sm text-grey-500">
                Suma
              </p>

              <div class="max-md:hidden" />

              <p class="text-right font-bold">
                {format_hours(@total_time_worked)}
              </p>
              <p class="text-right font-bold">
                <%= if @total_cost do %>
                  {:PLN
                  |> Money.new(@total_cost)
                  |> Money.to_string!(fractional_digits: 0)}
                <% else %>
                  —
                <% end %>
              </p>

              <div />
            </div>
          </div>
        <% else %>
          <div class="flex flex-col items-center justify-center gap-4 py-8">
            <p class="text-center text-sm text-grey-700">
              Żaden pracownik nie jest przypisany do projektu. <br />Dodaj członków zespołu.
            </p>
            <.link
              navigate={~p"/zarzadzanie/projekty/#{@project.id}/edycja"}
              kind="button"
              size="small"
              variant="tertiary"
            >
              Dodaj pracowników
            </.link>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<.modal :if={@can_delete_project} id="delete_project_modal">
  <div class="space-y-6">
    <h3 class="text-lg font-medium">
      Czy na pewno chcesz usunąć projekt <b>{@project.name}</b>?
    </h3>
    <p class="text-sm text-grey-700">
      Ta operacja jest nieodwracalna. Wszystkie dane związane z tym projektem zostaną trwale usunięte.
    </p>
    <div class="flex justify-end gap-4">
      <.button
        type="button"
        variant="outline"
        phx-click={hide_modal("delete_project_modal")}
      >
        Anuluj
      </.button>
      <.button
        type="button"
        variant="destructive"
        phx-click="delete_project"
        phx-disable-with="Usuwam..."
      >
        Usuń projekt
      </.button>
    </div>
  </div>
</.modal>
