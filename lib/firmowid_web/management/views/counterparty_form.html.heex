<div class="mx-auto flex w-full max-w-7xl flex-1 flex-col gap-8">
  <.form
    id="counterparty-form"
    for={@form}
    phx-change="validate"
    phx-submit="save"
    class="flex flex-col gap-8 pt-4"
  >
    <div class="flex flex-row items-start justify-between">
      <div class="space-y-1">
        <p :if={@live_action == :edit} class="text-sm/snug text-grey-500">
          {@counterparty.display_label}
        </p>
        <p class="text-2xl/tight font-medium">
          {case @live_action do
            :new -> "Nowy kontrahent"
            :edit -> "Edycja kontrahenta"
          end}
        </p>
      </div>

      <div class="flex flex-row gap-4">
        <.link
          navigate={@cancel_path}
          kind="button"
          variant="outline"
        >
          Anuluj
        </.link>

        <.button variant="tertiary">
          {case @live_action do
            :new -> "Dodaj kontrahenta"
            :edit -> "Zapisz zmiany"
          end}
        </.button>
      </div>
    </div>

    <div class="grid grid-rows-2 gap-16 md:grid-cols-2 md:grid-rows-1">
      <section class="flex flex-col gap-8">
        <div class="flex flex-col gap-4">
          <h2 class="mb-6 text-base/tight font-medium text-grey-900">Informacje podstawowe</h2>
          <div class="grid grid-cols-[min-content_1fr] items-start gap-x-5 gap-y-3">
            <label class="pt-1.5 text-sm text-nowrap text-grey-700" for={@form[:tax_id].id}>
              NIP/ID*
            </label>
            <div class="flex gap-3">
              <.input
                field={@form[:tax_id]}
                new={true}
                autocomplete="off"
                class="flex-1"
              />
              <.button
                type="button"
                variant="tertiary"
                size="small"
                phx-click="fetch_by_nip"
                phx-value-nip={@form[:tax_id].value}
                class="w-[107px] bg-grey-200! text-grey-900! hover:bg-grey-300! active:bg-grey-400!"
              >
                Pobierz dane
              </.button>
            </div>

            <label class="text-sm text-nowrap text-grey-700" for={@form[:type].id}>Typ</label>
            <.input
              field={@form[:type]}
              type="select"
              options={[{"Firma", :company}, {"Osoba fizyczna", :individual}]}
              new={true}
            />

            <label class="pt-1.5 text-sm text-nowrap text-grey-700" for={@form[:display_name].id}>
              Nazwa wyświetlana
            </label>
            <.input field={@form[:display_name]} new={true} />

            <%= if to_string(@form[:type].value) == "company" do %>
              <label class="pt-1.5 text-sm text-nowrap text-grey-700" for={@form[:full_name].id}>
                Pełna nazwa*
              </label>
              <.input field={@form[:full_name]} new={true} />
            <% else %>
              <label class="pt-1.5 text-sm text-nowrap text-grey-700" for={@form[:given_name].id}>
                Imię*
              </label>
              <div>
                <.input field={@form[:given_name]} new={true} />
              </div>

              <label class="pt-1.5 text-sm text-nowrap text-grey-700" for={@form[:surname].id}>
                Nazwisko*
              </label>
              <.input field={@form[:surname]} new={true} />

              <label class="pt-1.5 text-sm text-nowrap text-grey-700" for={@form[:pesel].id}>PESEL</label>
              <.input field={@form[:pesel]} new={true} />
            <% end %>
          </div>
        </div>
        <div class="flex flex-col gap-4">
          <h2 class="mb-6 text-base/tight font-medium text-grey-900">Dodatkowe</h2>
          <div class="grid grid-cols-[min-content_1fr] items-start gap-x-5 gap-y-3">
            <label class="text-sm text-nowrap text-grey-700" for={@form[:description].id}>
              Notatki
            </label>
            <.input
              field={@form[:description]}
              type="textarea"
              new={true}
              is_tooltip={true}
              class="h-24"
            />
          </div>
        </div>
      </section>

      <section>
        <div class="flex flex-col gap-4">
          <h2 class="mb-6 text-base/tight font-medium text-grey-900">
            Dane kontaktowe i adresowe
          </h2>
          <div class="grid grid-cols-[min-content_1fr] items-start gap-x-5 gap-y-3">
            <label class="pt-1.5 text-sm text-nowrap text-grey-700" for={@form[:email].id}>Email</label>
            <.input field={@form[:email]} new={true} is_tooltip={true} />

            <label class="pt-1.5 text-sm text-nowrap text-grey-700" for={@form[:phone].id}>Telefon</label>
            <.input field={@form[:phone]} new={true} is_tooltip={true} />

            <label class="pt-1.5 text-sm text-nowrap text-grey-700" for={@form[:address].id}>
              Adres
            </label>
            <.input
              field={@form[:address]}
              type="textarea"
              new={true}
              is_tooltip={true}
              placeholder="Ulica, nr budynku i/lub mieszkania, kod pocztowy, miasto"
            />

            <label class="pt-1.5 text-sm text-nowrap text-grey-700" for={@form[:country].id}>Kraj*</label>
            <.input
              field={@form[:country]}
              type="select"
              options={@country_options}
              prompt="Wybierz kraj"
              required
              new={true}
            />

            <label class="text-sm text-grey-700" for={@form[:is_different_mail_address].id}>Inny adres korespondencyjny</label>
            <.switch
              field={@form[:is_different_mail_address]}
              class="w-12 gap-3! self-center"
              color="turquoise"
            />

            <%= if Phoenix.HTML.Form.normalize_value("switch", @form[:is_different_mail_address].value) do %>
              <label class="text-sm text-grey-700" for={@form[:mail_address].id}>
                Adres
              </label>
              <.input
                field={@form[:mail_address]}
                type="textarea"
                new={true}
                is_tooltip={true}
              />
              <label class="text-sm text-grey-700" for={@form[:mail_country].id}>
                Kraj
              </label>
              <.input
                field={@form[:mail_country]}
                type="select"
                options={@country_options}
                prompt="Wybierz kraj"
                new={true}
              />
            <% end %>
          </div>
        </div>
      </section>
    </div>
  </.form>
</div>
