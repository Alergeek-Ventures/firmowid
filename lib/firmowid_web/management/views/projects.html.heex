<div class="flex w-full flex-col px-4 py-6 md:px-10 md:pt-8 md:pb-12">
  <header class="flex items-end justify-between gap-4">
    <h1 class="text-3xl/[1.3] font-bold text-grey-900">{gettext("Projects")}</h1>
    <.page_actions>
      <:action>
        <.link navigate={~p"/zarzadzanie/projekty/dodaj"} kind="button" variant="special" data-fab>
          <.icon name="hero-plus-mini" class="size-6" />
          <span class="max-md:sr-only">{gettext("Add project")}</span>
        </.link>
      </:action>
    </.page_actions>
  </header>

  <%!-- 24px around the toolbar, as between the title, the toolbar and the table. --%>
  <div class="sticky top-0 z-10 bg-grey-100 py-6 max-md:static max-md:z-auto">
    <.month_and_search
      selected_date={@selected_date}
      active_months={@active_months}
      search={@search}
      search_label={gettext("Search projects")}
    >
      <.scope_switch label={gettext("Project scope")}>
        <:option
          patch={Navigation.projects_path(:index, @params)}
          active={@live_action == :index}
        >
          {pgettext("projects list tab", "Active")}
        </:option>
        <:option
          patch={Navigation.projects_path(:archive, @params)}
          active={@live_action == :archive}
        >
          {pgettext("projects list tab", "Archived")}
        </:option>
      </.scope_switch>
    </.month_and_search>
  </div>

  <%!-- Figma "Wiersz projektu": the project fills the row, the client takes 240px, the hours
       and the archive date 120px each, 24px apart. On phones the client goes under the name. --%>
  <%!-- Figma "duży ekran (1920)": from 1800px the month in numbers and the projects without
       hours stand beside the table, 48px apart, level with the first row. --%>
  <div class="flex min-[1800px]:gap-12">
    <div
      id="projects-list"
      class={[
        "grid min-w-0 flex-1 content-start gap-x-6 gap-y-2 phx-change-loading:opacity-50",
        if(@live_action == :archive,
          do:
            "grid-cols-[minmax(0,1fr)_15rem_7.5rem_7.5rem_max-content_min-content] max-md:grid-cols-[minmax(0,1fr)_max-content_min-content]",
          else:
            "grid-cols-[minmax(0,1fr)_15rem_7.5rem_min-content] max-md:grid-cols-[minmax(0,1fr)_max-content_min-content]"
        )
      ]}
    >
      <div
        id="projects-list-header"
        class={
          [
            "sticky top-21 z-1 col-span-full grid grid-cols-subgrid bg-grey-100 px-4 py-1 text-sm/[1.35] text-grey-500 transition-all duration-75 max-md:static",
            # An empty list keeps the heading's room, so the empty state stays in place.
            @projects == [] && "invisible"
          ]
        }
        phx-hook="ScrollStyle"
        data-classes="border-b-4 border-solid border-grey-700/40 pt-3"
        data-scroll-offset="90"
      >
        <p>{gettext("Project")}</p>
        <p class="max-md:hidden">{gettext("Counterparty")}</p>
        <%= if @live_action == :archive do %>
          <p class="text-right text-nowrap">{gettext("Total hours")}</p>
          <p class="text-right text-nowrap max-md:hidden">{gettext("Archived on")}</p>
          <span class="max-md:hidden" />
        <% else %>
          <p class="text-right">{gettext("Hours")}</p>
        <% end %>
        <span />
      </div>

      <%= if @projects == [] do %>
        <.empty_state
          size="small"
          title={
            cond do
              @search != "" -> gettext("We could not find the project you are looking for.")
              @zero_state? -> gettext("You have no projects yet")
              @live_action == :archive -> gettext("You have no archived projects to show.")
              true -> gettext("You have no active projects to show.")
            end
          }
          class="col-span-full gap-4! py-16! [&>div>p]:leading-[normal]"
        >
          <:icon><Lucideicons.folder_kanban class="text-grey-400" /></:icon>
          <%!-- Figma "Pusty stan / Projekty": with no project at all, what a project is for. --%>
          <p :if={@zero_state? and @search == ""} class="text-sm/[1.35] text-grey-600">
            {gettext("Add a project so your team can assign hours to it.")}
          </p>
        </.empty_state>
      <% else %>
        <%!-- An archived project is greyed out, all but its archive date. --%>
        <div
          :for={project <- @projects}
          :key={project.id}
          class={[
            "col-span-full grid grid-cols-subgrid items-center rounded-sm bg-white px-4 max-md:py-3 md:h-[57px]",
            if(@live_action == :archive, do: "text-grey-500", else: "text-grey-900")
          ]}
        >
          <div class="min-w-0">
            <.link
              kind="unstyled"
              navigate={Navigation.project_path(project.id, Map.take(@params, ["miesiac"]))}
              class="block truncate text-base/[1.35] hover:underline"
              title={project.name}
            >
              {project.name}
            </.link>
            <p class={[
              "truncate text-sm/[1.35] md:hidden",
              if(@live_action == :archive, do: "text-grey-500", else: "text-grey-700")
            ]}>
              {CounterpartyHelpers.party_label(project.counterparty, @current_org)}
            </p>
          </div>

          <p class={[
            "truncate text-sm/[1.35] max-md:hidden",
            if(@live_action == :archive, do: "text-grey-500", else: "text-grey-700")
          ]}>
            {CounterpartyHelpers.party_label(project.counterparty, @current_org)}
          </p>

          <%!-- The units in grey; no time at all is grey as a whole. --%>
          <p class={[
            "flex items-baseline justify-end gap-1.5 text-base/[1.35] text-nowrap",
            project.duration < 60 && "text-grey-500"
          ]}>
            <span
              :for={[value, unit] <- duration_parts(project.duration)}
              class="flex items-baseline gap-0.5"
            >
              {value}<span class={[
                "text-sm",
                if(@live_action == :archive, do: "text-grey-400", else: "text-grey-500")
              ]}>{unit}</span>
            </span>
          </p>

          <%= if @live_action == :archive do %>
            <p class="text-right text-base/[1.35] text-grey-900 max-md:hidden">
              {Calendar.strftime(project.archived_at, "%d.%m.%Y")}
            </p>
            <.button
              type="button"
              variant="tertiary"
              size="small"
              class="max-md:hidden"
              phx-click="unarchive_project"
              phx-value-id={project.id}
            >
              {gettext("Restore")}
            </.button>
          <% end %>

          <.link
            kind="unstyled"
            navigate={Navigation.project_path(project.id, Map.take(@params, ["miesiac"]))}
            class="flex items-center"
            aria-label={gettext("Open project %{name}", name: project.name)}
          >
            <Lucideicons.chevron_right class="size-4 shrink-0 text-black" />
          </.link>
        </div>
      <% end %>
    </div>

    <aside
      :if={@projects != []}
      class="hidden w-80 shrink-0 flex-col gap-2.5 pt-8.75 min-[1800px]:flex"
    >
      <%= if @live_action == :archive do %>
        <.archive_summary projects={@projects} />
        <.restoring_hint />
      <% else %>
        <.month_summary selected_date={@selected_date} projects={@projects} />
        <.projects_without_hours
          projects={@projects}
          month={@selected_date.month}
          params={@params}
        />
      <% end %>
    </aside>
  </div>
</div>
