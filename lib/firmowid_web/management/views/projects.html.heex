<div :if={not @zero_state?} class="mx-auto flex w-full max-w-7xl flex-1 flex-col gap-6 pb-4">
  <% # top -> collapsed navbar height (56px) / TODO: refactor %>
  <div class="sticky top-10.5 z-10 flex flex-col gap-6 bg-grey-100 py-4">
    <div class="flex flex-row justify-between">
      <form class="flex gap-4">
        <.month_picker
          id="project_date_picker"
          selected_date={@selected_date}
          active_months={@active_months}
        />

        <.search_field
          name="szukaj"
          value={@params["szukaj"] || ""}
          placeholder="Szukaj projektu"
          size="big"
          phx-change={JS.push("search", loading: "#projects-list")}
          phx-debounce="300"
          class="w-64"
        />
      </form>

      <.link
        navigate={~p"/zarzadzanie/projekty/dodaj"}
        kind="button"
        variant="special"
      >
        <Lucideicons.plus /> Dodaj projekt
      </.link>
    </div>

    <.segmented_control label="Zakres listy">
      <:option patch={Navigation.projects_path(:index, @params)} active={@live_action == :index}>
        Aktywne
      </:option>
      <:option
        patch={Navigation.projects_path(:archive, @params)}
        active={@live_action == :archive}
      >
        Zarchiwizowane
      </:option>
    </.segmented_control>
  </div>

  <%= cond do %>
    <% Enum.empty?(@projects) -> %>
      <%= if @params["szukaj"] do %>
        <.empty_state
          title="Nie znaleźliśmy szukanego przez Ciebie projektu."
          class="flex-1 justify-center"
        >
          <:icon><Lucideicons.file_x /></:icon>
        </.empty_state>
      <% else %>
        <.empty_state
          title={
            case @live_action do
              :index -> "Nie masz aktywnych projektów do wyświetlenia."
              :archive -> "Nie masz zarchiwizowanych projektów do wyświetlenia."
            end
          }
          class="flex-1 justify-center"
        >
          <:icon><Lucideicons.presentation /></:icon>
        </.empty_state>
      <% end %>
    <% @live_action == :index -> %>
      <div
        id="projects-list"
        class="grid grid-cols-[4fr_8.125rem_1fr_min-content] gap-x-6 gap-y-2 phx-change-loading:opacity-50"
      >
        <div
          id="projects-list-header-active"
          class="sticky top-41 z-1 col-span-full grid grid-cols-subgrid bg-grey-100 px-4 pb-3 text-sm/snug text-grey-700 transition-all duration-75"
          phx-hook="ScrollStyle"
          data-classes="border-b-4 border-solid border-grey-700/40 pt-3"
          data-scroll-offset="90"
        >
          <p>Projekt</p>
          <p class="text-right">
            <!--Rentowność-->
          </p>
          <p class="text-right">Godziny</p>
        </div>

        <div class="col-span-full grid grid-cols-subgrid gap-y-2">
          <div
            :for={project <- @projects}
            :key={project.id}
            class="col-span-full grid grid-cols-subgrid items-center rounded-sm bg-white p-4"
          >
            <div class="space-y-1 truncate">
              <.link
                kind="unstyled"
                navigate={Navigation.project_path(project.id, Map.take(@params, ["miesiac"]))}
                class="hover:underline"
              >
                <p class="text-base/snug">{project.name}</p>
              </.link>
              <p class="text-sm/snug text-grey-500">
                {CounterpartyHelpers.party_label(project.counterparty, @current_org)}
              </p>
            </div>
            <p class="text-right">
              <!--Rentowność-->
            </p>
            <p class="text-right">{project.hours} h</p>
            <.link
              kind="unstyled"
              navigate={Navigation.project_path(project.id, Map.take(@params, ["miesiac"]))}
              class="text-grey-500 hover:text-grey-700"
            >
              <Lucideicons.chevron_right class="size-4" />
            </.link>
          </div>
        </div>
      </div>
    <% @live_action == :archive -> %>
      <div
        id="projects-list"
        class="grid grid-cols-[4fr_8.125rem_1fr_min-content_min-content] gap-x-10 gap-y-2 phx-change-loading:opacity-50"
      >
        <div
          id="projects-list-header-archive"
          class="sticky top-41 z-1 -order-1 col-span-full grid grid-cols-subgrid bg-grey-100 px-4 pb-3 text-sm/snug transition-all duration-75"
          phx-hook="ScrollStyle"
          data-classes="border-b-4 border-solid border-grey-700/40 pt-3"
          data-scroll-offset="90"
        >
          <p>Projekt</p>
          <p class="text-right">
            <!--Rentowność-->
          </p>
          <p class="text-right">Suma godzin</p>
          <p class="text-right text-nowrap">Data archiwizacji</p>
        </div>

        <div class="col-span-full grid grid-cols-subgrid gap-y-2">
          <div
            :for={project <- @projects}
            :key={project.id}
            class="col-span-full grid grid-cols-subgrid items-center rounded-sm bg-white p-4"
          >
            <div class="space-y-1 truncate">
              <.link
                kind="unstyled"
                navigate={Navigation.project_path(project.id, Map.take(@params, ["miesiac"]))}
                class="hover:underline"
              >
                <p class="text-base/snug">{project.name}</p>
              </.link>
              <p class="text-sm/snug text-grey-500">
                {case project.counterparty && project.counterparty.display_label do
                  "" -> @current_org.name
                  nil -> @current_org.name
                  label -> label
                end}
              </p>
            </div>
            <p class="text-right">
              <!--Rentowność-->
            </p>
            <p class="text-right">{project.hours} h</p>
            <p class="text-right text-black">
              {Calendar.strftime(project.archived_at, "%d.%m.%Y")}
            </p>
            <div class="flex flex-row items-center gap-3">
              <.button
                :if={@current_user.member.role == :admin}
                type="button"
                variant="secondary"
                size="small"
                phx-click="unarchive_project"
                phx-value-id={project.id}
              >
                Przywróć
              </.button>
              <.link
                kind="unstyled"
                navigate={Navigation.project_path(project.id, Map.take(@params, ["miesiac"]))}
                class="text-grey-500 hover:text-grey-700"
              >
                <Lucideicons.chevron_right class="size-4" />
              </.link>
            </div>
          </div>
        </div>
      </div>
  <% end %>
</div>

<.empty_state
  :if={@zero_state?}
  title="Nie masz aktywnych projektów do wyświetlenia."
  class="mx-auto size-full max-w-7xl flex-1 justify-center"
>
  <:icon><Lucideicons.presentation /></:icon>
  Dodaj nowy klikając poniżej.
  <:action>
    <.link navigate={~p"/zarzadzanie/projekty/dodaj"} kind="button" variant="secondary">
      <Lucideicons.plus /> Dodaj projekt
    </.link>
  </:action>
</.empty_state>
