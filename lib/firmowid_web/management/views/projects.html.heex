<div :if={not @zero_state?} class="mx-auto flex w-full max-w-7xl flex-1 flex-col gap-6 pb-4">
  <% # top -> collapsed navbar height (56px) / TODO: refactor %>
  <div class="sticky top-10.5 z-10 flex flex-col gap-6 bg-grey-100 py-4 max-md:static">
    <div class="flex flex-row justify-between max-md:flex-col max-md:items-stretch max-md:gap-3">
      <form class="flex gap-4 max-md:gap-3">
        <.month_picker
          id="project_date_picker"
          show_on_mobile
          selected_date={@selected_date}
          active_months={@active_months}
          class="max-md:flex-1"
        />

        <div
          id="search-container"
          data-expanded={to_string(@params["szukaj"] != nil and @params["szukaj"] != "")}
          class="group flex min-w-10 items-center justify-center rounded-lg bg-grey-200 transition-shadow data-[expanded=true]:focus-within:ring-2"
        >
          <.input
            name="szukaj"
            value={@params["szukaj"] || ""}
            placeholder="Szukaj projektu"
            phx-change={JS.push("search", loading: "#projects-list")}
            phx-debounce="300"
            input_class="py-0 px-1 bg-transparent border-none"
            class="w-0 border-transparent px-0 opacity-0 transition-[width,opacity,padding] duration-200 ease-in-out group-data-[expanded=true]:w-64 group-data-[expanded=true]:px-2 group-data-[expanded=true]:py-1 group-data-[expanded=true]:opacity-100 focus:border-none focus:ring-0 focus:outline-hidden max-md:group-data-[expanded=true]:w-36"
          />
          <.button
            type="button"
            phx-click={
              JS.toggle_attribute({"data-expanded", "true", "false"}, to: "#search-container")
              |> JS.focus(to: "#search-container input")
            }
            variant="secondary"
          >
            <Lucideicons.search />
          </.button>
        </div>
      </form>

      <.link
        navigate={~p"/zarzadzanie/projekty/dodaj"}
        kind="button"
        variant="special"
        class="max-md:w-full max-md:justify-center"
      >
        <Lucideicons.plus /> Dodaj projekt
      </.link>
    </div>

    <div class="flex gap-4">
      <.link
        :for={
          {path, live_action, label} <- [
            {Navigation.projects_path(:index, @params), :index, "Aktywne"},
            {Navigation.projects_path(:archive, @params), :archive, "Zarchiwizowane"}
          ]
        }
        patch={path}
        kind="button"
        variant="ghost"
        size="small"
        class={[
          "max-md:flex-1",
          @live_action == live_action && "bg-grey-700 text-white hover:text-grey-900"
        ]}
      >
        {label}
      </.link>
    </div>
  </div>

  <%= cond do %>
    <% Enum.empty?(@projects) -> %>
      <div class="flex flex-1 flex-col items-center justify-center gap-4 rounded-lg border border-grey-200 p-6">
        <%= if @params["szukaj"] do %>
          <Lucideicons.file_x class="size-26 text-grey-300" />
          <p class="text-sm/snug text-grey-700">
            Nie znaleźliśmy szukanego przez Ciebie projektu.
          </p>
        <% else %>
          <Lucideicons.presentation class="size-26 text-grey-300" />
          <p class="text-sm/snug text-grey-700">
            {case @live_action do
              :index -> "Nie masz aktywnych projektów do wyświetlenia."
              :archive -> "Nie masz zarchiwizowanych projektów do wyświetlenia."
            end}
          </p>
        <% end %>
      </div>
    <% @live_action == :index -> %>
      <div
        id="projects-list"
        class="grid grid-cols-[4fr_8.125rem_1fr_min-content] gap-x-6 gap-y-2 max-md:grid-cols-[minmax(0,1fr)_max-content_min-content] max-md:gap-x-4 phx-change-loading:opacity-50"
      >
        <div
          id="projects-list-header-active"
          class="sticky top-41 z-1 col-span-full grid grid-cols-subgrid bg-grey-100 px-4 pb-3 text-sm/snug text-grey-700 transition-all duration-75 max-md:static"
          phx-hook="ScrollStyle"
          data-classes="border-b-4 border-solid border-grey-700/40 pt-3"
          data-scroll-offset="90"
        >
          <p>Projekt</p>
          <p class="text-right max-md:hidden">
            <!--Rentowność-->
          </p>
          <p class="text-right">Godziny</p>
        </div>

        <div class="col-span-full grid grid-cols-subgrid gap-y-2">
          <div
            :for={project <- @projects}
            :key={project.id}
            class="col-span-full grid grid-cols-subgrid items-center rounded-sm bg-white p-4"
          >
            <div class="min-w-0 space-y-1 wrap-break-word">
              <.link
                kind="unstyled"
                navigate={Navigation.project_path(project.id, Map.take(@params, ["miesiac"]))}
                class="hover:underline"
              >
                <p class="text-base/snug">{project.name}</p>
              </.link>
              <p class="text-sm/snug text-grey-500">
                {CounterpartyHelpers.party_label(project.counterparty, @current_org)}
              </p>
            </div>
            <p class="text-right max-md:hidden">
              <!--Rentowność-->
            </p>
            <p class="text-right">{project.hours} h</p>
            <.link
              kind="unstyled"
              navigate={Navigation.project_path(project.id, Map.take(@params, ["miesiac"]))}
              class="text-grey-500 hover:text-grey-700"
              aria-label={gettext("Open project %{name}", name: project.name)}
            >
              <Lucideicons.chevron_right class="size-4" />
            </.link>
          </div>
        </div>
      </div>
    <% @live_action == :archive -> %>
      <div
        id="projects-list"
        class="grid grid-cols-[4fr_8.125rem_1fr_min-content_min-content] gap-x-10 gap-y-2 max-md:grid-cols-[minmax(0,1fr)_max-content_min-content] max-md:gap-x-4 phx-change-loading:opacity-50"
      >
        <div
          id="projects-list-header-archive"
          class="sticky top-41 z-1 -order-1 col-span-full grid grid-cols-subgrid bg-grey-100 px-4 pb-3 text-sm/snug transition-all duration-75 max-md:static"
          phx-hook="ScrollStyle"
          data-classes="border-b-4 border-solid border-grey-700/40 pt-3"
          data-scroll-offset="90"
        >
          <p>Projekt</p>
          <p class="text-right max-md:hidden">
            <!--Rentowność-->
          </p>
          <p class="text-right">Suma godzin</p>
          <p class="text-right text-nowrap max-md:hidden">Data archiwizacji</p>
        </div>

        <div class="col-span-full grid grid-cols-subgrid gap-y-2">
          <div
            :for={project <- @projects}
            :key={project.id}
            class="col-span-full grid grid-cols-subgrid items-center rounded-sm bg-white p-4"
          >
            <div class="min-w-0 space-y-1 wrap-break-word">
              <.link
                kind="unstyled"
                navigate={Navigation.project_path(project.id, Map.take(@params, ["miesiac"]))}
                class="hover:underline"
              >
                <p class="text-base/snug">{project.name}</p>
              </.link>
              <p class="text-sm/snug text-grey-500">
                {case project.counterparty && project.counterparty.display_label do
                  "" -> @current_org.name
                  nil -> @current_org.name
                  label -> label
                end}
              </p>
            </div>
            <p class="text-right max-md:hidden">
              <!--Rentowność-->
            </p>
            <p class="text-right">{project.hours} h</p>
            <p class="text-right text-black max-md:hidden">
              {Calendar.strftime(project.archived_at, "%d.%m.%Y")}
            </p>
            <div class="flex flex-row items-center gap-3">
              <.button
                :if={@current_user.member.role == :admin}
                type="button"
                variant="secondary"
                size="small"
                class="max-md:hidden"
                phx-click="unarchive_project"
                phx-value-id={project.id}
              >
                Przywróć
              </.button>
              <.link
                kind="unstyled"
                navigate={Navigation.project_path(project.id, Map.take(@params, ["miesiac"]))}
                class="text-grey-500 hover:text-grey-700"
                aria-label={gettext("Open project %{name}", name: project.name)}
              >
                <Lucideicons.chevron_right class="size-4" />
              </.link>
            </div>
          </div>
        </div>
      </div>
  <% end %>
</div>

<div
  :if={@zero_state?}
  class="mx-auto flex size-full max-w-7xl flex-1 flex-col items-center justify-center rounded-lg border border-grey-200 p-8"
>
  <Lucideicons.presentation class="size-26 text-grey-300" size={48} />

  <p class="mt-4 text-center text-sm/snug text-balance text-grey-700">
    Nie masz aktywnych projektów do wyświetlenia. Dodaj nowy klikając poniżej.
  </p>

  <.link
    navigate={~p"/zarzadzanie/projekty/dodaj"}
    kind="button"
    variant="secondary"
    class="mt-6"
  >
    <Lucideicons.plus /> Dodaj projekt
  </.link>
</div>
