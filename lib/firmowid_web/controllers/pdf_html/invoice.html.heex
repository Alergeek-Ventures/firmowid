<div class="w-[531px] h-[748px] relative p-8 box-content mx-auto bg-white">
  <!-- Header -->
  <div class="flex justify-between">
    <div class="grid grid-cols-[auto,1fr] gap-x-2 text-[10px]">
      <span class="mt-1">
        <%= case @invoice.invoice_type do
          :poland -> "Numer faktury:"
          :foreign -> "Numer faktury / Invoice number:"
        end %>
      </span>
      <span class="font-bold text-sm"><%= @invoice.invoice_number %></span>

      <span class="mt-4">
        <%= case @invoice.invoice_type do
          :poland -> "Data wystawienia:"
          :foreign -> "Data wystawienia / Issue date:"
        end %>
      </span>
      <span class="font-bold mt-4">
        <%= @invoice.issue_date |> Calendar.strftime("%d.%m.%Y") %>
      </span>

      <span class="text-[10px] mt-1">
        <%= case @invoice.invoice_type do
          :poland -> "Data sprzedaży:"
          :foreign -> "Data sprzedaży / Sale date:"
        end %>
      </span>
      <span class="font-bold mt-1">
        <%= @invoice.sale_date |> Calendar.strftime("%d.%m.%Y") %>
      </span>
    </div>
    <div class="flex gap-4">
      <div class="text-right">
        <div class="font-bold text-sm">FAKTURA VAT</div>
        <%= if @invoice.invoice_type == :foreign do %>
          <div class="font-bold text-sm">VAT INVOICE</div>
        <% end %>
        <div class="text-[10px]">
          <%= if @invoice.is_cash_account do %>
            METODA KASOWA
          <% end %>
        </div>
      </div>
      <img src="/images/av_logo.png" class="w-8 h-8 mt-1" />
    </div>
  </div>
  <hr class="border-greyButtonBg my-8" />
  <!-- Seller and Buyer -->
  <div class="grid grid-cols-2 gap-7">
    <div class="leading-[14px]">
      <h2 class="text-[8px] text-darkGrey text-opacity-70 font-bold mb-2">
        <%= case @invoice.invoice_type do
          :poland -> "SPRZEDAWCA"
          :foreign -> "SPRZEDAWCA / SELLER"
        end %>
      </h2>
      <div class="grid grid-cols-[auto,_1fr] gap-1">
        <span class="text-[8px]">
          <%= case @invoice.invoice_type do
            :poland -> "Nazwa:"
            :foreign -> "Nazwa / Name:"
          end %>
        </span>
        <span class="font-bold text-[10px]">
          <%= @invoice.seller_display_name %>
        </span>

        <span class="text-[8px]">
          <%= case @invoice.invoice_type do
            :poland -> "Adres:"
            :foreign -> "Adres / Address:"
          end %>
        </span>
        <span class="text-[10px]"><%= @invoice.seller_address %></span>

        <span class="text-[8px]">
          <%= case @invoice.invoice_type do
            :poland -> "NIP:"
            :foreign -> "VAT-ID:"
          end %>
        </span>
        <span class="text-[10px]"><%= @invoice.seller_nip %></span>
      </div>
    </div>
    <div class="leading-[14px]">
      <h2 class="text-[8px] text-darkGrey text-opacity-70 font-bold mb-2">
        <%= case @invoice.invoice_type do
          :poland -> "NABYWCA"
          :foreign -> "NABYWCA / BUYER"
        end %>
      </h2>
      <div class="grid grid-cols-[auto,_1fr] gap-1">
        <span class="text-[8px]">
          <%= case @invoice.invoice_type do
            :poland -> "Nazwa:"
            :foreign -> "Nazwa / Name:"
          end %>
        </span>
        <span class="font-bold text-[10px]">
          <%= @invoice.buyer_display_name %>
        </span>

        <span class="text-[8px]">
          <%= case @invoice.invoice_type do
            :poland -> "Adres:"
            :foreign -> "Adres / Address:"
          end %>
        </span>
        <%=  %>
        <span class="text-[10px]">
          <%= address =
            case [
              @invoice.buyer_street,
              @invoice.buyer_house_number
            ] do
              [nil, nil] -> ""
              [street, nil] -> street
              [nil, _house_number] -> ""
              [street, house_number] -> street <> " " <> house_number
            end

          address =
            case @invoice.buyer_apartment_number do
              nil ->
                address

              apartment_number ->
                address <> "/" <> apartment_number
            end

          case [@invoice.buyer_postal_code, @invoice.buyer_city] do
            [nil, nil] -> address
            [nil, city] -> address <> ", " <> city
            [postal_code, nil] -> address <> ", " <> postal_code
            [postal_code, city] -> address <> ", " <> postal_code <> " " <> city
          end %>
        </span>

        <span class="text-[8px]">
          <%= case @invoice.invoice_type do
            :poland -> "NIP:"
            :foreign -> "VAT-ID:"
          end %>
        </span>
        <span class="text-[10px]"><%= @invoice.buyer_nip %></span>
      </div>
    </div>
  </div>
  <hr class="border-greyButtonBg my-8" />
  <!-- Items Table -->
  <div>
    <h2 class="text-[8px] text-darkGrey text-opacity-70 font-bold">
      <%= case @invoice.invoice_type do
        :poland -> "TOWARY LUB USŁUGI"
        :foreign -> "TOWARY LUB USŁUGI / GOODS OR SERVICES"
      end %>
    </h2>
    <table class="w-full">
      <thead>
        <%= if @invoice.invoice_type == :poland do %>
          <tr class="text-[8px] text-darkGrey text-opacity-70">
            <th class="py-2 text-left">Lp.</th>
            <th class="py-2 text-left">Nazwa</th>
            <th class="py-2 text-right">Ilość</th>
            <th class="py-2 text-right">Jednostka</th>
            <th class="py-2 text-right">Cena netto</th>
            <th class="py-2 text-center w-12 pl-5">Vat</th>
            <th class="py-2 text-right">Wartość netto</th>
            <th class="py-2 text-right">Wartość brutto</th>
          </tr>
        <% end %>
        <%= if @invoice.invoice_type == :foreign do %>
          <tr class="text-[8px] text-darkGrey text-opacity-70">
            <th class="pt-2 text-left">Lp.</th>
            <th class="pt-2 text-left">Nazwa</th>
            <th class="pt-2 text-right">Ilość</th>
            <th class="pt-2 text-right">Jednostka</th>
            <th class="pt-2 text-right">Cena jednostkowa</th>
            <th class="pt-2 text-right">Cena sumaryczna</th>
          </tr>
          <tr class="text-[8px] text-darkGrey text-opacity-70">
            <th class="pb-2 text-left">No.</th>
            <th class="pb-2 text-left">Name</th>
            <th class="pb-2 text-right">Count</th>
            <th class="pb-2 text-right">Unit</th>
            <th class="pb-2 text-right">Unit price</th>
            <th class="pb-2 text-right">Total price</th>
          </tr>
        <% end %>
      </thead>
      <tbody class="text-[10px]">
        <%= for {item, index} <- Enum.with_index(@invoice.invoice_items, 1) do %>
          <tr>
            <td class="py-2"><%= index %>.</td>
            <td class="py-2"><%= item.name %></td>
            <td class="py-2 text-right"><%= item.quantity %></td>
            <td class="py-2 text-right"><%= item.unit %></td>
            <%= if @invoice.invoice_type == :poland do %>
              <td class="py-2 text-right">
                <%= Money.new(
                  @invoice.currency,
                  item.unit_price,
                  currency_symbol: ""
                ) %>
              </td>
              <td class="py-2 text-right"><%= item.vat_rate %>%</td>
              <td class="py-2 text-right">
                <%= Money.new(
                  @invoice.currency,
                  item |> Firmowid.Invoices.InvoiceItem.get_net_value(),
                  currency_symbol: ""
                ) %>
              </td>
              <td class="py-2 text-right">
                <%= Money.new(
                  @invoice.currency,
                  item |> Firmowid.Invoices.InvoiceItem.get_gross_value(),
                  currency_symbol: ""
                ) %>
              </td>
            <% end %>
            <%= if @invoice.invoice_type == :foreign do %>
              <td class="py-2 text-right">
                <%= Money.to_currency!(Money.new("PLN", item.unit_price), @invoice.currency)
                |> Money.to_string!(currency_symbol: "") %>
              </td>
              <td class="py-2 text-right">
                <%= Money.to_currency!(
                  Money.new("PLN", item |> Firmowid.Invoices.InvoiceItem.get_net_value()),
                  @invoice.currency
                )
                |> Money.to_string!(currency_symbol: "") %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <!-- Summary -->
  <div class="bg-greyButtonBg w-[255px] rounded-md px-4 py-2 mt-10 bg-opacity-30 ml-auto">
    <h2 class="text-[8px] text-darkGrey text-opacity-70 font-bold mb-2 uppercase">
      <%= case @invoice.invoice_type do
        :poland -> "Podsumowanie"
        :foreign -> "Podsumowanie / Summary"
      end %>
    </h2>
    <div class="flex flex-col justify-end text-[8px] mt-3">
      <%= if @invoice.invoice_type == :poland do %>
        <div class="flex justify-between items-center">
          <span>Wartość netto:</span>
          <span class="text-[10px]">
            <%= Money.new(
              @invoice.currency,
              @invoice |> Firmowid.Invoices.Invoice.get_net_value()
            ) %>
          </span>
        </div>
        <div class="flex justify-between mt-2 items-center">
          <span>VAT:</span>
          <span class="text-[10px]">
            <%= Money.new(
              @invoice.currency,
              @invoice |> Firmowid.Invoices.Invoice.get_vat_value()
            ) %>
          </span>
        </div>
        <div class="flex justify-between items-center mt-3">
          <span>Wartość brutto:</span>
          <span class="font-bold leading-tight text-sm">
            <%= Money.new(
              @invoice.currency,
              @invoice |> Firmowid.Invoices.Invoice.get_gross_value()
            ) %>
          </span>
        </div>
      <% end %>
      <%= if @invoice.invoice_type == :foreign do %>
        <div class="flex justify-between mt-2 items-center">
          <span>VAT:</span>
          <span class="text-[10px]">
            <%= Money.new(@invoice.currency, 0) %>
          </span>
        </div>
        <div class="flex justify-between items-center mt-3">
          <span>Koszt całkowity / Total cost:</span>
          <span class="font-bold leading-tight text-sm">
            <%= Money.to_currency!(
              Money.new("PLN", @invoice |> Firmowid.Invoices.Invoice.get_net_value()),
              @invoice.currency
            ) %>
          </span>
        </div>
      <% end %>
    </div>
  </div>
  <hr class="border-greyButtonBg my-8" />
  <!-- Payment Details -->
  <h2 class="text-[8px] text-darkGrey text-opacity-70 font-bold mb-3 uppercase">
    Płatność
  </h2>
  <div class="grid grid-cols-[auto,1fr] gap-x-1 gap-y-2 w-fit text-[10px] leading-[14px]">
    <span>
      <%= case @invoice.invoice_type do
        :poland -> "Metoda płatności:"
        :foreign -> "Metoda płatności / Payment method:"
      end %>
    </span>
    <%= if @invoice.invoice_type == :poland do %>
      <span>
        <%= @invoice.payment_method %> | nr konta: <%= @invoice.seller_account_number %>
      </span>
    <% end %>
    <%= if @invoice.invoice_type == :foreign do %>
      <span>
        <p>
          PRZELEW / TRANSFER
        </p>
        <p>nr konta / bank account number: <%= @invoice.seller_account_number %></p>
      </span>
    <% end %>
    <span>
      <%= case @invoice.invoice_type do
        :poland -> "Termin płatności:"
        :foreign -> "Termin płatności / Payment deadline:"
      end %>
    </span>
    <span>
      <span class="font-bold">
        <%= @invoice.due_date |> Calendar.strftime("%d.%m.%Y") %>
      </span>
    </span>
  </div>
  <%= if @invoice.is_reverse_charge do %>
    <p class="font-bold text-[10px] leading-[14px]">
      Odwrotne obciążenie / Reverse charge
    </p>
  <% end %>
  <!-- Footer -->
  <div class="absolute inset-0 flex items-end justify-center text-[8px] bottom-8">
    <div class="flex flex-col items-center">
      <img src="/images/invoice_firmowid_logo.png" class="w-10 h-10 mb-2" />
      <p>
        Faktura wygenerowana za pomocą
        <a class="font-black" href="https://firmowid.pl" target="_blank" rel="noreferrer noopener">
          Firmowid.pl
        </a>
      </p>
    </div>
  </div>
</div>
