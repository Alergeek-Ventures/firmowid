<.shared_page
  lang={to_string(@lang)}
  title={"#{if @lang == :en, do: "Invoice", else: "Faktura"} #{@invoice.invoice_number || ""} — #{Firmowid.SalesInvoices.buyer_display_name(@invoice) || ""}"}
>
  <div class="max-w-6xl w-full mx-auto flex-1 flex flex-col my-4">
    <div class="px-9">
      <div class="mt-8 flex gap-6">
        <div class="flex-1 max-w-[650px]">
          <FirmowidWeb.PdfHTML.sales_invoice
            sales_invoice={@invoice}
            currency_rate={@currency_rate}
            show_vat={@show_vat}
            reference_invoice={@reference_invoice}
          />
        </div>
        <div class="space-y-6 min-w-[350px]">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-medium text-grey-700">
              {if @lang == :en, do: "Invoice details", else: "Dane faktury"}
            </h2>
            <div :if={@invoice.invoice_type == :foreign} class="flex gap-1">
              <a
                href={~p"/faktura/#{@conn.params["token"]}?lang=pl"}
                class={[
                  "px-2 py-1 text-xs font-medium rounded transition-colors",
                  if(@lang == :pl,
                    do: "bg-black text-white",
                    else: "bg-greyButtonBg text-darkGrey hover:bg-grey-300"
                  )
                ]}
              >
                🇵🇱 PL
              </a>
              <a
                href={~p"/faktura/#{@conn.params["token"]}?lang=en"}
                class={[
                  "px-2 py-1 text-xs font-medium rounded transition-colors",
                  if(@lang == :en,
                    do: "bg-black text-white",
                    else: "bg-greyButtonBg text-darkGrey hover:bg-grey-300"
                  )
                ]}
              >
                🇬🇧 EN
              </a>
            </div>
          </div>

          <FirmowidWeb.Components.Invoicing.InvoiceDetails.sales_invoice_metadata
            invoice={@invoice}
            lang={@lang}
          />
          <a
            href={~p"/faktura/#{@conn.params["token"]}/pdf"}
            class="flex items-center justify-center gap-2 w-full px-4 py-3 text-sm font-medium text-white bg-black rounded-lg hover:bg-orangeText transition-colors"
          >
            <.icon name="hero-arrow-down-tray" class="w-4 h-4" />
            {if @lang == :en, do: "Download PDF", else: "Pobierz PDF"}
          </a>
          <a
            :if={not is_nil(@invoice.ksef_number)}
            href={Firmowid.Ksef.invoice_url!(@invoice)}
            target="_blank"
            class="flex items-center justify-center gap-2 w-full px-4 py-3 text-sm font-medium text-white bg-black rounded-lg hover:bg-orangeText transition-colors"
          >
            <.icon name="hero-arrow-trending-up" class="w-4 h-4" />
            {if @lang == :en, do: "View in KSeF", else: "Zobacz w KSeF"}
          </a>
        </div>
      </div>
    </div>
  </div>
</.shared_page>
