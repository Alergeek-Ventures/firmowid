<!DOCTYPE html>
<html class="h-full scrollbar-gutter-auto" lang={Gettext.get_locale(Firmowid.Gettext)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f0eae6" />
    <meta name="description" content={meta_description(assigns)} />
    <meta
      name="robots"
      content={
        if assigns[:public_marketing?],
          do: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
          else: "noindex, nofollow"
      }
    />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix={if assigns[:public_marketing?], do: "", else: " · Firmowid"}>
      {if assigns[:public_marketing?],
        do: meta_title(assigns),
        else: assigns[:page_title] || "Firmowid"}
    </.live_title>
    <link rel="canonical" href={canonical_url(assigns)} />
    <link
      :if={assigns[:public_marketing?] && canonical_path(assigns) == "/"}
      rel="alternate"
      type="text/plain"
      href="/llms.txt"
      title="llms.txt"
    />
    <meta
      :if={assigns[:public_marketing?]}
      property="og:type"
      content={if assigns[:article], do: "article", else: "website"}
    />
    <meta :if={assigns[:public_marketing?]} property="og:site_name" content="Firmowid" />
    <meta :if={assigns[:public_marketing?]} property="og:locale" content="pl_PL" />
    <meta :if={assigns[:public_marketing?]} property="og:title" content={meta_title(assigns)} />
    <meta
      :if={assigns[:public_marketing?]}
      property="og:description"
      content={meta_description(assigns)}
    />
    <meta :if={assigns[:public_marketing?]} property="og:url" content={canonical_url(assigns)} />
    <meta
      :if={assigns[:public_marketing?]}
      property="og:image"
      content={social_image(assigns).url}
    />
    <meta :if={assigns[:public_marketing?]} property="og:image:type" content="image/png" />
    <meta
      :if={assigns[:public_marketing?]}
      property="og:image:width"
      content={social_image(assigns).width}
    />
    <meta
      :if={assigns[:public_marketing?]}
      property="og:image:height"
      content={social_image(assigns).height}
    />
    <meta
      :if={assigns[:public_marketing?]}
      property="og:image:alt"
      content={social_image(assigns).alt}
    />
    <meta
      :if={assigns[:article]}
      property="article:published_time"
      content={Date.to_iso8601(@article.published)}
    />
    <meta
      :if={assigns[:article]}
      property="article:modified_time"
      content={Date.to_iso8601(@article.updated)}
    />
    <meta :if={assigns[:public_marketing?]} name="twitter:card" content="summary_large_image" />
    <meta :if={assigns[:public_marketing?]} name="twitter:site" content="@firmowid" />
    <meta :if={assigns[:public_marketing?]} name="twitter:title" content={meta_title(assigns)} />
    <meta
      :if={assigns[:public_marketing?]}
      name="twitter:description"
      content={meta_description(assigns)}
    />
    <meta
      :if={assigns[:public_marketing?]}
      name="twitter:image"
      content={social_image(assigns).url}
    />
    <meta
      :if={assigns[:public_marketing?]}
      name="twitter:image:alt"
      content={social_image(assigns).alt}
    />
    <script :if={assigns[:public_marketing?]} type="application/ld+json">
      <%= structured_data(assigns) %>
    </script>
    {Application.get_env(:live_debugger, :live_debugger_tags)}
    <link rel="icon" type="image/png" href={~p"/images/favicon.png"} />
    <link rel="apple-touch-icon" href={~p"/images/favicon.png"} />
    <%!-- the landing page is set in Lexend, the app in Geist --%>
    <link
      :if={assigns[:public_marketing?]}
      rel="preload"
      as="font"
      type="font/woff2"
      href={~p"/fonts/lexend-latin.woff2"}
      crossorigin
    />
    <link
      :if={assigns[:public_marketing?]}
      rel="preload"
      as="font"
      type="font/woff2"
      href={~p"/fonts/lexend-latin-ext.woff2"}
      crossorigin
    />
    <link
      :if={!assigns[:public_marketing?]}
      rel="preload"
      as="font"
      type="font/woff2"
      href={~p"/fonts/geist-latin.woff2"}
      crossorigin
    />
    <link
      :if={!assigns[:public_marketing?]}
      rel="preload"
      as="font"
      type="font/woff2"
      href={~p"/fonts/geist-latin-ext.woff2"}
      crossorigin
    />
    <%!-- restores the collapsed sidebar before the first paint, see `FirmowidWeb.Inbox.Components.Sidebar` --%>
    <script nonce={assigns[:csp_nonce]}>
      try {
        if (localStorage.getItem("sidebar") === "collapsed") document.documentElement.dataset.sidebar = "collapsed";
      } catch {}
    </script>
    <%!-- Public pages load a smaller bundle with only the styles and hooks they render. --%>
    <link
      phx-track-static
      rel="stylesheet"
      href={if assigns[:public_marketing?], do: ~p"/assets/landing.css", else: ~p"/assets/app.css"}
    />
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={if assigns[:public_marketing?], do: ~p"/assets/landing.js", else: ~p"/assets/app.js"}
      data-telemetry-config="true"
      data-public-marketing={to_string(assigns[:public_marketing?] == true)}
      data-posthog-enabled={to_string(posthog_enabled?(assigns[:current_user]))}
      data-posthog-api-key={
        Keyword.get(
          Application.get_env(:firmowid, :frontend_observability, []),
          :posthog_api_key,
          ""
        )
      }
      data-sentry-dsn={
        Keyword.get(Application.get_env(:firmowid, :frontend_observability, []), :sentry_dsn, "")
      }
      data-sentry-environment={
        Keyword.get(
          Application.get_env(:firmowid, :frontend_observability, []),
          :sentry_environment,
          ""
        )
      }
      data-sentry-release={
        Keyword.get(
          Application.get_env(:firmowid, :frontend_observability, []),
          :sentry_release,
          ""
        )
      }
      data-current-user-id={if assigns[:current_user], do: assigns.current_user.id, else: ""}
      data-current-user-role={
        case assigns[:current_user] do
          %{member: %{role: role}} -> to_string(role)
          _ -> ""
        end
      }
      data-current-organization-id={
        case assigns[:current_user] do
          %{member: %{organization_id: organization_id}} -> organization_id
          _ -> ""
        end
      }
      data-current-organization-plan={
        case assigns[:current_org] do
          %{billing_plan: billing_plan} when not is_nil(billing_plan) -> to_string(billing_plan)
          _ -> ""
        end
      }
    >
    </script>
  </head>
  <body class="h-full">
    {@inner_content}
    <FirmowidWeb.Landing.Components.CookieConsent.cookie_consent_banner />
    <.impersonation_banner current_user={assigns[:current_user]} />
  </body>
</html>
