<!DOCTYPE html>
<html class="h-full [scrollbar-gutter:auto]" lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix=" · Firmowid">
      {assigns[:page_title] || "Firmowid"}
    </.live_title>
    {Application.get_env(:live_debugger, :live_debugger_tags)}
    <link rel="icon" type="image/png" href={~p"/images/favicon.png"} />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/air-datepicker@3.5.3/air-datepicker.min.css"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={~p"/assets/app.js"}
      data-posthog-enabled={
        to_string(
          Keyword.get(
            Application.get_env(:firmowid, :frontend_observability, []),
            :posthog_enabled,
            false
          )
        )
      }
      data-posthog-api-key={
        Keyword.get(
          Application.get_env(:firmowid, :frontend_observability, []),
          :posthog_api_key,
          ""
        )
      }
      data-posthog-api-host={
        Keyword.get(
          Application.get_env(:firmowid, :frontend_observability, []),
          :posthog_api_host,
          ""
        )
      }
      data-sentry-dsn={
        Keyword.get(Application.get_env(:firmowid, :frontend_observability, []), :sentry_dsn, "")
      }
      data-sentry-environment={
        Keyword.get(
          Application.get_env(:firmowid, :frontend_observability, []),
          :sentry_environment,
          ""
        )
      }
      data-current-user-id={if assigns[:current_user], do: assigns.current_user.id, else: ""}
      data-current-user-email={
        if assigns[:current_user], do: assigns.current_user.email, else: ""
      }
    >
    </script>
    <script
      src="https://browser.sentry-cdn.com/10.22.0/bundle.tracing.replay.min.js"
      crossorigin="anonymous"
    >
    </script>
    <script src="https://cdn.jsdelivr.net/npm/posthog-js@1.296.0/dist/module.full.no-external.min.js">
    </script>
  </head>
  <body class="h-full">
    {@inner_content}
    <FirmowidWeb.Landing.Components.CookieConsent.cookie_consent_banner />
  </body>
  <script src="https://cdn.jsdelivr.net/npm/air-datepicker@3.5.3/air-datepicker.min.js">
  </script>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js">
  </script>
  <script
    type="module"
    src="https://cdn.jsdelivr.net/npm/pdfjs-dist@4.7.76/build/pdf.min.mjs"
  >
  </script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js">
  </script>
  <script src="https://cdn.jsdelivr.net/npm/tippy.js@4.3.5/umd/index.all.min.js">
  </script>
  <script src="https://cdn.jsdelivr.net/npm/@floating-ui/core@1.7.3">
  </script>
  <script src="https://cdn.jsdelivr.net/npm/@floating-ui/dom@1.7.4">
  </script>
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js">
  </script>
  <script src="https://cdn.jsdelivr.net/npm/modern-screenshot/dist/index.js">
  </script>
  <script src="https://cdn.jsdelivr.net/npm/@tarekraafat/autocomplete.js@10.2.9/dist/autoComplete.min.js">
  </script>
</html>
