<%= if app_navigation?(assigns) do %>
  <FirmowidWeb.Inbox.Components.Sidebar.sidebar
    current_user={@current_user}
    current_org={@current_org}
    organizations={@organizations}
    current_uri={@current_uri}
    analysis_enabled={flag_enabled?(:analysis_dashboard, assigns)}
    delegations_enabled={flag_enabled?(:delegations, assigns)}
    taxes_enabled={flag_enabled?(:taxes, assigns)}
    scope={@ash_scope}
  />
  <.live_component
    module={FirmowidWeb.Support.Components.Form}
    id="support-form"
    current_user={@current_user}
  />
<% end %>

<main
  data-layout={app_navigation?(assigns) && "sidebar"}
  class={
    [
      is_nil(assigns[:no_padding]) &&
        "p-4 sm:px-6 lg:px-8",
      "flex flex-1 flex-col bg-grey-100",
      # room below the content for the floating action button on phones, see `page_actions/1`
      "max-md:has-data-page-actions:pb-28",
      # the sidebar replaces the navbar on desktop, so sticky headers stick to the top;
      # the margin follows the sidebar's width as it collapses
      app_navigation?(assigns) &&
        "md:ms-64 md:ease-out-quint md:[--navbar-height:0px] md:[--spacing-navbar:0px] md:in-data-[sidebar=collapsed]:ms-14 motion-safe:md:transition-[margin-inline-start] motion-safe:md:duration-250",
      assigns[:main_class]
    ]
  }
>
  <div class="mx-auto flex size-full flex-1 flex-col">
    <LiveToast.toast_group
      flash={@flash}
      kinds={[:info, :error, :success, :notice]}
      connected={assigns[:socket] != nil}
      toasts_sync={assigns[:toasts_sync]}
      toast_class_fn={&FirmowidWeb.Core.Toast.toast_class_fn/1}
      group_class_fn={&FirmowidWeb.Core.Toast.group_class_fn/1}
      toast_component_fn={&FirmowidWeb.Core.Toast.toast_content/1}
      connection_notifications={FirmowidWeb.Core.Toast.connection_notifications()}
    />
    {@inner_content}
  </div>
</main>

<%!--
  The full assistant page renders the same chat itself, so the panel stays out
  of it; pages that link to that page instead (the company inbox) set
  `hide_floating_assistant`.
--%>
<%= if app_navigation?(assigns) and match?(%{member: %{role: role}} when role != :employee, @current_user) and
       @current_uri.path != FirmowidWeb.Assistant.Utilities.Navigation.page_path() and
       !assigns[:hide_floating_assistant] do %>
  {Phoenix.Component.live_render(
    assigns[:socket] || assigns[:conn],
    FirmowidWeb.Assistant.Views.Floating,
    id: "floating-assistant-#{@current_user.member.organization_id}",
    sticky: true,
    container: {:div, []},
    session: %{
      "organization_id" => @current_user.member.organization_id,
      "page_path" => FirmowidWeb.Assistant.Utilities.Navigation.page_path()
    }
  )}
<% end %>
