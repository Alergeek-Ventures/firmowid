<%= if @current_user && !is_nil(@current_user.organization_id) do %>
  <nav class={[
    "px-4 sm:px-6 lg:px-8 bg-black text-white flex",
    "items-center  justify-between h-20 py-6",
    "text-sm sticky top-0 z-50"
  ]}>
    <.link navigate={~p"/"} class="font-bold text-lg inline-block w-[240px]">
      Firmowid
    </.link>

    <div class="flex uppercase items-center gap-16 max-md:hidden">
      <%= if Firmowid.Authorization.authorize(@current_user) do %>
        <.link navigate={~p"/"} class="hover:underline flex items-center gap-2">
          <.icon name="hero-clipboard-document-list" class="w-5 h-5" /> Fakturowanie
        </.link>
      <% end %>
      <.link navigate={~p"/czasosledz"} class="hover:underline flex items-center gap-2">
        <.icon name="hero-clock" class="w-5 h-5" /> Czasośledź
      </.link>
    </div>

    <div class="relative max-md:hidden w-[240px] text-right">
      <button
        phx-click={
          JS.toggle(
            to: "#dropdown_content",
            in:
              {"transition-all transform ease-in", "opacity-0 scale-95", "opacity-100 scale-100"},
            out:
              {"transition-all transform ease-in duration-200",
               "opacity-100 translate-y-0 sm:scale-100",
               "opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"},
            display: "flex"
          )
          |> JS.toggle_class("invert", to: "#dropdown_button")
        }
        id="dropdown_button"
        phx-click-away={
          hide("#dropdown_content") |> JS.remove_class("invert", to: "#dropdown_button")
        }
        phx-window-keydown={
          hide("#dropdown_content") |> JS.remove_class("invert", to: "#dropdown_button")
        }
        phx-key="Escape"
        class="bg-black transition p-2 py-3 hover:invert rounded-md w-full"
      >
        <.icon name="hero-user" class="w-5 h-5 mr-1" />
        <span class="lowercase text-sm max-md:hidden">
          {@current_user.email}
        </span>
      </button>
      <div
        id="dropdown_content"
        style="display: none"
        class="absolute flex-col font-semibold p-3 rounded-md gap-2 left-[50%]
      -translate-x-1/2 w-full top-[70px] bg-black text-left"
      >
        <.link navigate={~p"/ustawienia"} class="rounded-md p-2 hover:bg-darkGrey/50">
          Mój profil
        </.link>
        <%= if Firmowid.Authorization.authorize(@current_user) do %>
          <.link
            navigate={~p"/ustawienia?tab=konta_bankowe"}
            class="rounded-md p-2 hover:bg-darkGrey/50"
          >
            Konta bankowe
          </.link>
        <% end %>
        <.link
          href={~p"/wyloguj"}
          method="delete"
          class="rounded-md p-2 hover:bg-darkGrey/50 flex justify-between"
        >
          Wyloguj się <.icon name="hero-arrow-right-start-on-rectangle" />
        </.link>
      </div>
    </div>
  </nav>
<% end %>

<main class={
  classes([
    is_nil(assigns[:no_padding]) &&
      "px-4 py-4 sm:px-6 lg:px-8",
    "flex-1 bg-lightGreyBg",
    assigns[:main_class]
  ])
}>
  <div class="mx-auto">
    <LiveToast.toast_group
      flash={@flash}
      connected={assigns[:socket] != nil}
      toast_class_fn={&FirmowidWeb.toast_class_fn/1}
    />
    {@inner_content}
  </div>
</main>

<script type="module" src="https://cdn.jsdelivr.net/npm/pdfjs-dist@4.7.76/build/pdf.min.mjs">
</script>
<script src="https://unpkg.com/popper.js@1">
</script>
<script src="https://unpkg.com/tippy.js@4">
</script>
