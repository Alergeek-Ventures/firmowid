<div class="container mt-16">
  <div class="flex gap-16">
    <div class="flex-1 self-end">
      <div class="flex items-center gap-4">
        <form class="relative" phx-submit="upload" phx-change="upload">
          <div class="hidden">
            <.live_file_input upload={@uploads.user_avatar} />
          </div>
          <.avatar class="size-28">
            <.avatar_image
              :if={Map.has_key?(@current_user, :avatar_url)}
              src={@current_user.avatar_url}
              alt="Avatar"
            />
            <.avatar_fallback>
              {String.slice(@current_user.email, 0, 1) |> String.upcase()}
            </.avatar_fallback>
          </.avatar>
          <.edit_button
            tag_name="label"
            for={@uploads.user_avatar.ref}
            class="absolute right-0 bottom-0 rounded-full"
          />
        </form>
        <div>
          <h1 class="text-2xl">
            Cześć{@current_user.name && " #{@current_user.name}"}!
          </h1>
          <p>{@current_user.email}</p>
        </div>
      </div>
      <div class="mt-16 flex gap-10 font-semibold">
        <.link
          patch={~p"/ustawienia/konto"}
          class={[
            @live_action == :account && "text-orangeText",
            "phx-click-loading:opacity-50"
          ]}
        >
          Twoje konto
        </.link>
        <.link
          patch={~p"/ustawienia/bezpieczenstwo"}
          class={[
            @live_action == :security && "text-orangeText",
            "phx-click-loading:opacity-50"
          ]}
        >
          Bezpieczeństwo
        </.link>
        <%= if Bodyguard.permit?(Firmowid.Accounts, :update_organization, @current_user, @current_org) do %>
          <.link
            patch={~p"/ustawienia/organizacja"}
            class={[
              @live_action == :organization && "text-orangeText",
              "phx-click-loading:opacity-50"
            ]}
          >
            Twoja organizacja
          </.link>
        <% end %>
        <%= if @current_user.role == :admin do %>
          <.link
            patch={~p"/ustawienia/konta-bankowe"}
            class={[
              @live_action == :bank_accounts && "text-orangeText",
              "phx-click-loading:opacity-50"
            ]}
          >
            Konta bankowe
          </.link>
        <% end %>
      </div>
      <hr class="border-t-greyButtonBg mt-4 border-t" />
    </div>
  </div>

  <%= case @live_action do %>
    <% :organization -> %>
      <div class="flex flex-col justify-between gap-4 lg:flex-row">
        <div class="flex flex-col gap-4">
          <div class={[
            "mt-6 w-fit rounded-md border p-4",
            if(@editing_basic_info, do: "border-greyButtonBg", else: "border-transparent")
          ]}>
            <div class="flex gap-1">
              <h2 class="mt-0.5 font-bold">Dane firmy</h2>
              <.edit_button
                phx-click="toggle_editing_basic_info"
                class={[
                  @editing_basic_info &&
                    "active:text-orangeText/90 hover:text-orangeText/70 text-orangeText"
                ]}
              />
            </div>
            <%= if @editing_basic_info do %>
              <div class="mt-6 flex flex-col gap-4">
                <.form class="flex flex-col gap-4" phx-submit="save" for={@company_form}>
                  <%= for [field, label, type] <- [
                [:organization_type, "Rodzaj działalności", "text"],
                [:name, "Nazwa organizacji", "text"],
                [:nip, "NIP", "text"],
                [:address, "Adres przedsiębiorstwa", "text"],
                [:phone_number, "Numer telefonu", "text"],
                [:is_vat_payer, "Czy jest płatnikiem VAT?", "checkbox"]
              ] do %>
                    <div class="flex">
                      <label
                        for={@company_form[field].id}
                        class="text-darkGrey flex w-48 items-center justify-end pr-4 text-xs font-medium uppercase"
                      >
                        {label}
                      </label>
                      <div class="flex-1 text-sm">
                        <.input
                          type={type}
                          field={@company_form[field]}
                          class="mt-0 h-8 w-[439px] font-normal"
                          input_class="mt-0 h-8 border-greyButtonBg"
                        />
                      </div>
                    </div>
                  <% end %>

                  <.button
                    color="orange"
                    class="ml-auto w-fit"
                    type="submit"
                    phx-disable-with="Zapisywanie..."
                  >
                    Zatwierdź
                  </.button>
                </.form>
              </div>
            <% else %>
              <div class="mt-6 space-y-4">
                <%= for {label, value} <- [
              {"Rodzaj działalności", @current_org.organization_type},
              {"Nazwa organizacji", @current_org.name},
              {"NIP", @current_org.nip},
              {"Adres przedsiębiorstwa", @current_org.address},
              {"Numer telefonu", @current_org.phone_number},
              {"Płatnik VAT", if(@current_org.is_vat_payer, do: "Tak", else: "Nie")}
            ], value do %>
                  <div class="flex">
                    <div class="text-darkGrey flex w-64 items-center justify-end pr-4 text-xs font-medium uppercase">
                      {label}
                    </div>
                    <div class="flex-1">
                      <%= if is_list(value) do %>
                        <%= for line <- value do %>
                          <div>{line}</div>
                        <% end %>
                      <% else %>
                        {value}
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>

          <div class={[
            "mt-6 w-fit rounded-md border p-4",
            if(@editing_correspondence, do: "border-greyButtonBg", else: "border-transparent")
          ]}>
            <div class="flex gap-1">
              <h2 class="mt-0.5 font-bold">Adres korespondencyjny</h2>
              <.edit_button
                phx-click="toggle_editing_correspondence"
                class={[
                  @editing_correspondence &&
                    "active:text-orangeText/90 hover:text-orangeText/70 text-orangeText"
                ]}
              />
            </div>
            <%= if @editing_correspondence do %>
              <div class="mt-6 flex flex-col gap-4">
                <.form class="flex flex-col gap-4" phx-submit="save" for={@correspondence_form}>
                  <%= for {field, label} <- [
                {:correspondence_name, "Nazwa organizacji"},
                {:correspondence_address, "Adres przedsiębiorstwa"}
              ] do %>
                    <div class="flex">
                      <label
                        for={@correspondence_form[field].id}
                        class="text-darkGrey flex w-48 items-center justify-end pr-4 text-xs font-medium uppercase"
                      >
                        {label}
                      </label>
                      <div class="flex-1 text-sm">
                        <.input
                          field={@correspondence_form[field]}
                          class="mt-0 h-8 w-[439px] font-normal"
                          input_class="mt-0 h-8 border-greyButtonBg"
                        />
                      </div>
                    </div>
                  <% end %>

                  <.button
                    color="orange"
                    class="ml-auto w-fit"
                    type="submit"
                    phx-disable-with="Zapisywanie..."
                  >
                    Zatwierdź
                  </.button>
                </.form>
              </div>
            <% else %>
              <div class="mt-6 space-y-4">
                <%= for {label, value} <- [
              {"Nazwa do korespondencji", @current_org.correspondence_name},
              {"Adres do korespondencji", @current_org.correspondence_address}
            ], value do %>
                  <div class="flex">
                    <div class="text-darkGrey flex w-64 items-center justify-end pr-4 text-xs font-medium uppercase">
                      {label}
                    </div>
                    <div class="flex-1">
                      <%= if is_list(value) do %>
                        <%= for line <- value do %>
                          <div>{line}</div>
                        <% end %>
                      <% else %>
                        {value}
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>

          <div class="mt-6 w-fit rounded-md border border-transparent p-4">
            <h2 class="mt-0.5 font-bold">Adres e-mail do faktur kosztowych</h2>
            <div class="mt-6 space-y-4">
              <div class="flex">
                <div class="text-darkGrey flex w-64 items-center justify-end pr-4 text-xs font-medium uppercase">
                  Adres e-mail
                </div>
                <div class="flex flex-1 items-center gap-4">
                  <code class="rounded bg-gray-100 px-3 py-1 text-sm">
                    {@current_org.inbound_email_nickname}@firmowid.pl
                  </code>
                  <.button
                    color="orange"
                    variant="outline"
                    phx-click="regenerate_inbound_nickname"
                    phx-disable-with="Generowanie..."
                    class="px-3 py-1 text-xs"
                  >
                    Wygeneruj nowy
                  </.button>
                </div>
              </div>
              <div class="flex">
                <div class="text-darkGrey mt-1 flex w-64 items-start justify-end pr-4 text-xs font-medium uppercase">
                  Opis
                </div>
                <div class="max-w-lg flex-1 text-sm text-gray-600">
                  Wysyłaj faktury kosztowe na ten adres, a zostaną automatycznie zaimportowane do systemu.
                  Tylko adresy z dozwolonej listy będą akceptowane.
                </div>
              </div>
            </div>
          </div>

          <div class="mt-6 w-fit rounded-md border border-transparent p-4">
            <h2 class="mt-0.5 font-bold">Dozwolone adresy e-mail</h2>
            <div class="mt-6 space-y-4">
              <div class="flex">
                <div class="text-darkGrey mt-1 flex w-64 items-start justify-end pr-4 text-xs font-medium uppercase">
                  Lista dozwolonych
                </div>
                <div class="flex-1">
                  <%= if @current_org.allowed_sender_emails == [] do %>
                    <p class="text-sm text-gray-500 italic">Brak dozwolonych adresów e-mail</p>
                  <% else %>
                    <div class="space-y-2">
                      <%= for email <- @current_org.allowed_sender_emails do %>
                        <div class="flex items-center gap-2 rounded bg-gray-50 px-3 py-2">
                          <code class="flex-1 text-sm">{email}</code>
                          <button
                            type="button"
                            phx-click="remove_allowed_email"
                            phx-value-email={email}
                            class="text-red-600 hover:text-red-800"
                          >
                            <.icon name="hero-x-mark" class="size-5" />
                          </button>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
              <div class="flex">
                <div class="text-darkGrey flex w-64 items-center justify-end pr-4 text-xs font-medium uppercase">
                  Dodaj nowy adres
                </div>
                <div class="flex-1">
                  <form phx-submit="add_allowed_email" class="flex gap-2">
                    <input
                      type="email"
                      name="email"
                      required
                      placeholder="email@example.com"
                      class="flex-1 rounded-md border-gray-300 text-sm shadow-sm focus:border-orange-500 focus:ring-orange-500"
                    />
                    <.button
                      type="submit"
                      color="orange"
                      variant="outline"
                      class="px-3 py-1 text-xs"
                    >
                      Dodaj
                    </.button>
                  </form>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-6 w-fit rounded-md border border-transparent p-4">
            <h2 class="mt-0.5 font-bold">Integracja z KSeF</h2>
            <div class="mt-6 space-y-4">
              <%= if @ksef_credential do %>
                <div class="flex">
                  <div class="text-darkGrey flex w-64 items-center justify-end pr-4 text-xs font-medium uppercase">
                    Status
                  </div>
                  <div class="flex flex-1 items-center gap-2">
                    <span class="bg-greenText inline-flex size-5 items-center justify-center rounded-full">
                      <.icon name="hero-check-circle-solid" class="text-greenBg size-5" />
                    </span>
                    <span class="text-sm font-medium">Połączono z KSeF</span>
                  </div>
                </div>
                <div class="flex">
                  <div class="text-darkGrey flex w-64 items-center justify-end pr-4 text-xs font-medium uppercase">
                    Typ autoryzacji
                  </div>
                  <div class="flex-1">
                    <%= case @ksef_credential.auth_type do %>
                      <% :token -> %>
                        Token
                      <% :certificate -> %>
                        Certyfikat
                    <% end %>
                  </div>
                </div>
                <div class="flex">
                  <div class="w-64"></div>
                  <div class="flex-1">
                    <.button
                      phx-click={show_modal("confirm_disconnect_ksef")}
                      variant="outline"
                      color="red"
                    >
                      Rozłącz
                    </.button>
                  </div>
                </div>
              <% else %>
                <form phx-submit="save_ksef_token" id="ksef-token-form">
                  <div class="flex">
                    <div class="text-darkGrey flex w-64 items-center justify-end pr-4 text-xs font-medium uppercase">
                      Token autoryzacyjny
                    </div>
                    <div class="flex-1">
                      <input
                        type="password"
                        name="ksef_token"
                        required
                        placeholder="Wprowadź token KSeF"
                        class="w-[439px] rounded-md border-gray-300 text-sm shadow-sm focus:border-orange-500 focus:ring-orange-500"
                      />
                    </div>
                  </div>
                  <div class="mt-4 flex">
                    <div class="text-darkGrey mt-1 flex w-64 items-start justify-end pr-4 text-xs font-medium uppercase">
                      Opis
                    </div>
                    <div class="max-w-lg flex-1 text-sm text-gray-600">
                      Token autoryzacyjny KSeF umożliwia automatyczne pobieranie faktur kosztowych
                      z Krajowego Systemu e-Faktur. Token możesz wygenerować w panelu KSeF.
                    </div>
                  </div>
                  <div class="mt-4 flex">
                    <div class="w-64"></div>
                    <div class="flex-1">
                      <.button type="submit" color="orange" phx-disable-with="Łączenie...">
                        Połącz z KSeF
                      </.button>
                    </div>
                  </div>
                </form>
              <% end %>
            </div>
          </div>

          <.modal id="confirm_disconnect_ksef">
            <h3 class="mb-4 text-lg font-bold">Potwierdź rozłączenie</h3>
            <p class="mb-6">
              Czy na pewno chcesz rozłączyć integrację z KSeF?
              Spowoduje to zatrzymanie automatycznego pobierania faktur.
            </p>
            <div class="flex gap-4">
              <.button
                phx-click="disconnect_ksef"
                variant="outline"
                color="red"
                phx-disable-with="Rozłączanie..."
              >
                Rozłącz
              </.button>
              <.button type="button" phx-click={hide_modal("confirm_disconnect_ksef")}>
                Anuluj
              </.button>
            </div>
          </.modal>

          <div class="mt-6 ml-4">
            <.link navigate={~p"/zaproszenia"} class={button_styles(%{variant: "outline"})}>
              Dodaj współpracowników do organizacji
            </.link>
          </div>
        </div>
        <div class="flex flex-col gap-3 py-8">
          <div class="flex items-center gap-1">
            <p class="text-base font-bold">Logo firmy</p>
            <form id="upload-form" phx-submit="upload" phx-change="upload">
              <div class="hidden">
                <.live_file_input upload={@uploads.organization_avatar} />
              </div>
              <.edit_button
                tag_name="label"
                for={@uploads.organization_avatar.ref}
                class="cursor-pointer"
              />
            </form>
          </div>

          <.avatar class="size-36 rounded-none">
            <.avatar_image src={@current_org.avatar_url} alt="Logo firmy" />
            <.avatar_fallback class="rounded-none">
              {String.slice(@current_org.name, 0, 1) |> String.upcase()}
            </.avatar_fallback>
          </.avatar>

          <div id="limity" class="mt-8 w-full">
            <p class="mb-4 text-sm font-bold">Limity organizacji</p>
            <div class="space-y-4">
              <.usage_limit_bar
                label="Faktury kosztowe"
                used={@usage_summary.cost_invoices.used}
                limit={@usage_summary.cost_invoices.limit}
                over_limit={@usage_summary.cost_invoices.over_limit}
                reset_text={"Odnowienie za #{@days_until_reset} dni"}
              />
              <.usage_limit_bar
                label="Faktury sprzedażowe"
                used={@usage_summary.sales_invoices.used}
                limit={@usage_summary.sales_invoices.limit}
                over_limit={@usage_summary.sales_invoices.over_limit}
                reset_text={"Odnowienie za #{@days_until_reset} dni"}
              />
              <.usage_limit_bar
                label="Połączenia bankowe"
                used={@usage_summary.bank_connections.used}
                limit={@usage_summary.bank_connections.limit}
                over_limit={@usage_summary.bank_connections.over_limit}
                reset_text="(limit stały)"
              />
            </div>
          </div>
        </div>
      </div>
    <% :account -> %>
      <div class="mt-6">
        <div class="ml-4">
          <div class="flex gap-4">
            <h2 class="font-bold">Dane dostępowe</h2>
            <.link class="mt-0.5 text-sm hover:underline" patch={~p"/ustawienia/bezpieczenstwo"}>
              Edytuj
            </.link>
          </div>
          <div class="mt-6 space-y-4">
            <div class="flex">
              <div class="text-darkGrey mt-1 w-64 pr-4 text-right text-xs font-medium uppercase">
                Email
              </div>
              <div class="flex-1">
                {@current_user.email}
              </div>
            </div>
            <div class="flex">
              <div class="text-darkGrey mt-1 w-64 pr-4 text-right text-xs font-medium uppercase">
                Hasło
              </div>
              <div class="flex-1">
                **************
              </div>
            </div>
          </div>
        </div>
        <div class={[
          "mt-6 w-fit rounded-md border p-4",
          if(@editing_personal_info, do: "border-greyButtonBg", else: "border-transparent")
        ]}>
          <div class="flex gap-1">
            <h2 class="mt-0.5 font-bold">Dane osobowe</h2>
            <.edit_button
              phx-click="toggle_editing_personal_info"
              class={[
                @editing_personal_info &&
                  "active:text-orangeText/90 hover:text-orangeText/70 text-orangeText"
              ]}
            />
          </div>
          <%= if @editing_personal_info do %>
            <div class="mt-6 flex flex-col gap-4">
              <.form class="flex flex-col gap-4" phx-submit="save" for={@user_form}>
                <%= for [field, label, type] <- [
                  [:name, "Imię i nazwisko", "text"],
                  [:employment_date, "Data zatrudnienia", "date"]
                ] do %>
                  <div class="flex">
                    <label
                      for={@user_form[field].id}
                      class="text-darkGrey flex w-48 items-center justify-end pr-4 text-xs font-medium uppercase"
                    >
                      {label}
                    </label>
                    <div class="flex-1 text-sm">
                      <.input
                        type={type}
                        field={@user_form[field]}
                        class="mt-0 h-8 w-[439px] font-normal"
                        input_class="mt-0 h-8 border-greyButtonBg"
                      />
                    </div>
                  </div>
                <% end %>

                <.button
                  color="orange"
                  class="ml-auto w-fit"
                  type="submit"
                  phx-disable-with="Zapisywanie..."
                >
                  Zatwierdź
                </.button>
              </.form>
            </div>
          <% else %>
            <div class="mt-6 space-y-4">
              <%= for {label, value} <- [
                {"Imię i nazwisko", @current_user.name},
                {"Data zatrudnienia", @current_user.employment_date}
              ], value do %>
                <div class="flex">
                  <div class="text-darkGrey mt-1 w-64 pr-4 text-right text-xs font-medium uppercase">
                    {label}
                  </div>
                  <div class="flex-1">
                    <%= if is_list(value) do %>
                      <%= for line <- value do %>
                        <div>{line}</div>
                      <% end %>
                    <% else %>
                      {value}
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
        <div class="ml-4">
          <h2 class="mt-6 font-bold">Zgoda marketingowa</h2>
          <div class="mt-6 flex items-center">
            <label
              for="consent"
              class="text-darkGrey flex w-64 items-center justify-end pr-4 text-right text-xs font-medium uppercase"
            >
              Zgoda na przesyłanie informacji o charakterze marketingowym
            </label>
            <div>
              <.input
                phx-click="update_marketing_consent"
                name="consent"
                id="consent"
                value={@current_user.marketing_consent}
                type="checkbox"
              />
            </div>
          </div>
        </div>
        <div class="ml-4">
          <h2 class="mt-6 font-bold">Zamykanie konta</h2>
          <div class="mt-6 flex items-center">
            <div class="text-darkGrey flex w-64 items-center justify-end pr-4 text-xs font-medium uppercase">
              Nazwa konta
            </div>
            <div class="flex flex-1 flex-col">
              {@current_user.email}
            </div>
          </div>
          <div class="mt-4 flex">
            <div class="text-darkGrey flex w-64 items-center justify-end pr-4 text-xs font-medium uppercase">
            </div>
            <div class="flex-1">
              <.button phx-click={show_modal("confirm_modal")} variant="outline" color="red">
                Zamknij konto
              </.button>
              <.modal id="confirm_modal">
                <h3>Czy na pewno chcesz zamknąć konto? <b>Nie da się tego cofnąć!</b></h3>
                <.simple_form
                  for={@delete_account_form}
                  phx-submit="delete_account"
                  id="delete_account_form"
                >
                  <.input
                    field={@delete_account_form[:current_password]}
                    type="password"
                    label="Twoje hasło"
                    required
                  />
                  <:actions>
                    <div class="flex gap-4">
                      <.button variant="outline" color="red" phx-disable-with="Usuwam...">
                        Zamknij konto
                      </.button>
                      <.button type="button" phx-click={hide_modal("confirm_modal")}>
                        Anuluj
                      </.button>
                    </div>
                  </:actions>
                </.simple_form>
              </.modal>
            </div>
          </div>
        </div>
      </div>
    <% :security -> %>
      <div class="mt-6 space-y-12 divide-y">
        <div>
          <h2 class="mb-6 font-bold">Logowanie przez Google</h2>
          <div class="space-y-4">
            <div class="flex items-center gap-4">
              <div class="flex-1">
                <%= if @current_user.google_provider_id do %>
                  <div class="flex items-center gap-2">
                    <span class="bg-greenText inline-flex size-5 items-center justify-center rounded-full">
                      <.icon name="hero-check-circle-solid" class="text-greenBg size-5" />
                    </span>
                    <span class="text-sm font-medium">Konto Google jest połączone</span>
                  </div>
                  <p class="text-darkGrey mt-2 text-sm">
                    Możesz logować się do swojego konta używając Google.
                  </p>
                <% else %>
                  <div class="flex items-center gap-2">
                    <span class="bg-redBg inline-flex size-5 items-center justify-center rounded-full">
                      <.icon name="hero-x-mark-solid" class="text-redText size-5" />
                    </span>
                    <span class="text-sm font-medium">Konto Google nie jest połączone</span>
                  </div>
                  <p class="text-darkGrey mt-2 text-sm">
                    Połącz swoje konto Google, aby móc logować się za pomocą Google.
                  </p>
                <% end %>
              </div>
              <div>
                <%= if @current_user.google_provider_id do %>
                  <.button
                    variant="outline"
                    color="red"
                    phx-click="unlink_google_account"
                    phx-disable-with="Odłączam..."
                  >
                    Odłącz Google
                  </.button>
                <% else %>
                  <.button
                    variant="outline"
                    phx-click="link_google_account"
                    phx-disable-with="Przekierowywanie..."
                  >
                    Połącz z Google
                  </.button>
                <% end %>
              </div>
            </div>
          </div>
        </div>
        <div class="pt-12">
          <h2 class="mb-6 font-bold">Zmiana adresu e-mail</h2>
          <.simple_form
            for={@email_form}
            id="email_form"
            phx-submit="update_email"
            phx-change="validate_email"
          >
            <.input field={@email_form[:email]} type="email" label="Email" required />
            <.input
              field={@email_form[:current_password]}
              name="current_password"
              id="current_password_for_email"
              type="password"
              label="Aktualne hasło"
              value={@email_form_current_password}
              required
            />
            <:actions>
              <.button phx-disable-with="Zmieniam...">Zmień Email</.button>
            </:actions>
          </.simple_form>
        </div>
        <div class="pt-12">
          <h2 class="mb-6 font-bold">Zmiana hasła</h2>
          <.simple_form
            for={@password_form}
            id="password_form"
            action={~p"/zaloguj?_action=password_updated"}
            method="post"
            phx-change="validate_password"
            phx-submit="update_password"
            phx-trigger-action={@trigger_submit}
          >
            <input
              name={@password_form[:email].name}
              type="hidden"
              id="hidden_user_email"
              value={@current_email}
            />
            <.input
              field={@password_form[:password]}
              type="password"
              label="Nowe hasło"
              required
            />
            <.input
              field={@password_form[:password_confirmation]}
              type="password"
              label="Potwierdź nowe hasło"
            />
            <.input
              field={@password_form[:current_password]}
              name="current_password"
              type="password"
              label="Aktualne hasło"
              id="current_password_for_password"
              value={@current_password}
              required
            />
            <:actions>
              <.button phx-disable-with="Zmieniam...">Zmień Hasło</.button>
            </:actions>
          </.simple_form>
        </div>
      </div>
    <% :bank_accounts -> %>
      <div class="mt-6 flex flex-col items-start">
        <div class="flex gap-1">
          <h2 class="mt-0.5 font-bold">Konta bankowe</h2>
        </div>
        <%= if Enum.any?(@bank_accounts) do %>
          <div class="mt-10 space-y-4">
            <%= for {institution, accounts} <- Enum.group_by(@bank_accounts, & &1.institution_name) do %>
              <h3>{if(institution == "Manual", do: "wprowadzone ręcznie", else: institution)}</h3>

              <div class="flex flex-wrap items-start gap-4">
                <%= for account <- accounts do %>
                  <div class={[
                    "border-greyButtonBg rounded-md border p-4",
                    "relative grid grid-cols-[85px_1fr] gap-2",
                    "align-center w-[450px] justify-center"
                  ]}>
                    <%= for {label, value} <- [
                          {"Nazwa", account.name},
                          {"Waluta", account.currency},
                          {"Numer", account.iban}
                        ] do %>
                      <span class={[
                        "text-darkGrey font-medium uppercase",
                        "content-center text-xs"
                      ]}>
                        {label}
                      </span>
                      <%= if label == "Numer" do %>
                        <div class="flex items-center gap-2">
                          <span class="break-all">{value}</span>
                          <span
                            :if={@bank_account_statuses[account.id] == :connected}
                            class="bg-greenText inline-flex size-5 items-center justify-center rounded-full"
                          >
                            <.icon name="hero-check-circle-solid" class="text-greenBg size-5" />
                          </span>
                          <span
                            :if={@bank_account_statuses[account.id] in [:broken, :disconnected]}
                            class="bg-redBg inline-flex size-5 items-center justify-center rounded-full"
                          >
                            <.icon name="hero-x-mark-solid" class="text-redText size-5" />
                          </span>
                          <span
                            :if={@bank_account_statuses[account.id] == :processing}
                            class="bg-blueBg inline-flex size-5 items-center justify-center rounded-full"
                          >
                            <.icon name="hero-ellipsis-horizontal" class="text-blueText size-5" />
                          </span>
                        </div>
                      <% else %>
                        <div class={[
                          !value && "text-darkGrey/30"
                        ]}>
                          {if value do
                            value
                          else
                            "—"
                          end}
                        </div>
                      <% end %>
                    <% end %>
                    <button
                      :if={
                        @bank_account_statuses[account.id] == :broken or
                          @bank_account_statuses[account.id] == :disconnected
                      }
                      phx-click="reconnect_bank_account"
                      phx-value-account_id={account.id}
                      class={[
                        "bg-greyButtonBg text-greyButtonText w-full uppercase",
                        "border-greyButtonBg border hover:bg-white hover:text-black",
                        "transform transition-all duration-200 ease-out",
                        "flex h-8 items-center rounded-md text-xs",
                        "col-span-full mt-4 justify-center gap-1"
                      ]}
                    >
                      <.icon name="hero-arrow-path" class="inline-block size-4" /> Powiąż
                    </button>
                    <div
                      :if={account.is_default}
                      class="bg-orangeBg text-orangeText col-span-full mt-4 flex h-8 w-full items-center justify-center rounded-md text-xs uppercase"
                    >
                      Domyślne dla
                      <span class="inline-block pl-1 font-bold">{account.currency}</span>
                    </div>
                    <div class="absolute top-2 right-2">
                      <.dropdown id={account.id}>
                        <:trigger>
                          <.icon class="text-darkGrey" name="hero-ellipsis-horizontal" />
                        </:trigger>
                        <div class={[
                          "text-darkGrey flex flex-col gap-2 text-sm",
                          "bg-lightGreyBg z-10 w-44 rounded font-semibold shadow-2xl",
                          "border-darkGrey/30 overflow-hidden border"
                        ]}>
                          <button
                            phx-click={show_modal("rename_modal_#{account.id}")}
                            class={[
                              "px-4 py-2 text-left transition",
                              "hover:text-white",
                              "hover:bg-darkGrey phx-click-loading:opacity-50",
                              "phx-click-loading:cursor-wait"
                            ]}
                          >
                            Zmień nazwę
                          </button>
                          <button
                            :if={!is_nil(account.institution_id)}
                            phx-click="reconnect_bank_account"
                            phx-value-account_id={account.id}
                            class={[
                              "px-4 py-2 text-left transition",
                              "hover:text-white",
                              "hover:bg-darkGrey phx-click-loading:opacity-50",
                              "phx-click-loading:cursor-wait"
                            ]}
                          >
                            Połącz ponownie
                          </button>

                          <button
                            phx-click={show_modal("confirm_delete_bank_account_#{account.id}")}
                            class={[
                              "px-4 py-2 text-left transition",
                              "hover:text-white",
                              "hover:bg-darkGrey phx-click-loading:opacity-50",
                              "phx-click-loading:cursor-wait"
                            ]}
                          >
                            Usuń
                          </button>
                          <button
                            :if={!account.is_default}
                            phx-click="make_default_account"
                            phx-value-account_id={account.id}
                            class={[
                              "px-4 py-2 text-left transition",
                              "hover:text-white",
                              "hover:bg-darkGrey phx-click-loading:opacity-50",
                              "phx-click-loading:cursor-wait"
                            ]}
                          >
                            Domyślne dla {account.currency}
                          </button>
                        </div>
                      </.dropdown>
                    </div>
                  </div>
                  <.modal id={"rename_modal_#{account.id}"}>
                    <.form
                      for={%{}}
                      phx-submit="rename_bank_account"
                      id={"rename_form_#{account.id}"}
                    >
                      <.input name="name" label="Nowa nazwa" value={account.name} />
                      <input type="hidden" name="account_id" value={account.id} />
                      <div class="mt-4 flex gap-4">
                        <.button
                          type="submit"
                          phx-click={hide_modal("rename_modal_#{account.id}")}
                          phx-disable-with="Zapisywanie..."
                        >
                          Zapisz
                        </.button>
                        <.button
                          type="button"
                          phx-click={hide_modal("rename_modal_#{account.id}")}
                        >
                          Anuluj
                        </.button>
                      </div>
                    </.form>
                  </.modal>
                  <.modal id={"confirm_delete_bank_account_#{account.id}"}>
                    <h3 class="mb-4 text-lg font-bold">Potwierdź usunięcie</h3>
                    <p class="mb-6">
                      Czy na pewno chcesz usunąć to konto bankowe?
                      Spowoduje to również usunięcie wszystkich powiązanych transakcji.
                    </p>
                    <div class="flex gap-4">
                      <.button
                        phx-click="delete_bank_account"
                        phx-value-account_id={account.id}
                        variant="outline"
                        color="red"
                        phx-disable-with="Usuwam..."
                        class="phx-click-loading:cursor-wait phx-click-loading:opacity-50"
                      >
                        Usuń
                      </.button>
                      <.button
                        type="button"
                        phx-click={hide_modal("confirm_delete_bank_account_#{account.id}")}
                        class="phx-click-loading:cursor-wait phx-click-loading:opacity-50"
                      >
                        Anuluj
                      </.button>
                    </div>
                  </.modal>
                <% end %>
              </div>
            <% end %>
          </div>
          <div class="mt-16 ml-auto flex gap-2">
            <.link
              navigate={~p"/ustawienia/bank/dodaj"}
              class={button_styles(%{variant: "outline"})}
            >
              Podepnij kolejne konto
            </.link>
            <.button variant="outline" phx-click={show_modal("manual_bank_account_modal")}>
              Dodaj konto ręcznie
            </.button>
          </div>
          <.modal
            id="manual_bank_account_modal"
            on_cancel={hide_modal("manual_bank_account_modal")}
          >
            <div class="flex flex-col gap-4">
              <h3 class="text-lg font-semibold">Dodaj konto bankowe ręcznie</h3>
              <p class="text-darkGrey text-sm">
                Ta funkcja pozwala dodać konto bez integracji z bankiem. Synchronizacja transakcji będzie wyłączona.
              </p>
              <.form
                for={%{}}
                phx-submit="create_manual_bank_account"
                id="manual_bank_account_form"
              >
                <.input name="name" label="Nazwa konta" value="" />
                <.input name="iban" label="IBAN" value="" />
                <.input name="currency" label="Waluta" value="" />
                <div class="mt-4 flex gap-4">
                  <.button
                    type="submit"
                    phx-click={hide_modal("manual_bank_account_modal")}
                    phx-disable-with="Dodawanie..."
                  >
                    Zapisz
                  </.button>
                  <.button type="button" phx-click={hide_modal("manual_bank_account_modal")}>
                    Anuluj
                  </.button>
                </div>
              </.form>
            </div>
          </.modal>
        <% else %>
          <div class="text-darkGrey py-6 text-left">
            <p>Nie masz jeszcze żadnych kont bankowych.</p>
            <p class="mt-2 text-sm">
              Dodaj swoje pierwsze konto bankowe, aby móc wystawiać faktury.
            </p>
            <div class="mt-6">
              <.link
                navigate={~p"/ustawienia/bank/dodaj"}
                class={button_styles(%{variant: "outline"})}
              >
                Podepnij konto
              </.link>
            </div>
          </div>
        <% end %>
      </div>
  <% end %>
</div>
