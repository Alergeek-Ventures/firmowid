<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <div class="mb-8">
    <div class="flex justify-between items-center">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Analiza finansowa</h1>
        <p class="mt-2 text-gray-600">Przegląd przychodów i kosztów organizacji</p>
      </div>
      <div class="flex items-center gap-3">
        <div :if={@tag_definitions != []} class="relative">
          <label
            id="tag-filter-trigger"
            phx-click={show_popover("tag-filter-popover")}
            class={[
              "transition duration-100 ease-out inline-flex flex-row items-center justify-center",
              "cursor-pointer border whitespace-nowrap",
              "text-base/tight font-medium h-11 rounded-lg py-2 px-2.75 gap-2.5 [&>svg]:size-6",
              if(@tag_filters != [],
                do: "bg-orange-100 text-orange-800 border-orange-200",
                else:
                  "text-grey-900 bg-grey-200 hover:bg-grey-300 active:bg-grey-400 border-transparent"
              )
            ]}
          >
            <Lucideicons.tag />
            <span>
              Tagi
              <span :if={@tag_filters != []} class="ml-0.5">
                ({length(@tag_filters)})
              </span>
            </span>
          </label>
          <.popover
            id="tag-filter-popover"
            reference_id="tag-filter-trigger"
            placement="bottom-end"
            class="bg-grey-50 border border-grey-200 rounded-lg w-64"
          >
            <div class="p-1 max-h-80 overflow-y-auto">
              <div class="px-2 py-1.5 text-caps-sm text-darkGrey uppercase font-medium">
                Kategorie
              </div>
              <label class="flex items-center gap-2 px-2 py-1.5 rounded cursor-pointer transition hover:bg-orange-100 hover:text-orange-800">
                <input
                  type="checkbox"
                  checked={tag_filter_active?(@tag_filters, {:company})}
                  phx-click="toggle-tag"
                  phx-value-tag="company"
                  class="w-4 h-4 border border-darkGrey text-darkGrey rounded-[3px] focus:ring-0"
                />
                <span class="text-sm text-darkGrey">Firma</span>
              </label>

              <div
                :if={@tag_definitions != []}
                class="px-2 py-1.5 text-caps-sm text-darkGrey uppercase font-medium mt-1"
              >
                Projekty
              </div>
              <label
                :for={tag_def <- @tag_definitions}
                class="flex items-center gap-2 px-2 py-1.5 rounded cursor-pointer transition hover:bg-orange-100 hover:text-orange-800"
              >
                <input
                  type="checkbox"
                  checked={tag_filter_active?(@tag_filters, {:project, tag_def.id})}
                  phx-click="toggle-tag"
                  phx-value-tag={"project:#{tag_def.id}"}
                  class="w-4 h-4 border border-darkGrey rounded-[3px] focus:ring-0"
                  style={"color: #{tag_def.color}"}
                />
                <span
                  class="inline-block w-2 h-2 rounded-full shrink-0"
                  style={"background-color: #{tag_def.color}"}
                >
                </span>
                <span class="text-sm text-darkGrey truncate">{tag_def.name}</span>
              </label>

              <button
                :if={@tag_filters != []}
                phx-click="clear-tag-filters"
                class="w-full mt-1 px-2 py-1.5 text-xs text-darkGrey hover:text-orange-800 text-center border-t border-grey-200 cursor-pointer transition"
              >
                Wyczyść filtry
              </button>
            </div>
          </.popover>
        </div>
        <.date_picker
          id="month"
          active_months={@active_months}
          selected_date={@params.month}
          class="w-48 gap-2"
        />
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-3 mb-8">
    <.summary_card
      section="income"
      label="Przychody"
      amount={@total_income}
      icon="hero-arrow-trending-up"
      active={@expanded_section == :income}
      bg="bg-blueBg"
      border="border-blueBg"
      text="text-blueText"
      active_border="border-blueText"
      ring="ring-blueText/20"
      hover_border="hover:border-blueText/50"
    />

    <.summary_card
      section="expenses"
      label="Koszty"
      amount={@total_expenses}
      icon="hero-arrow-trending-down"
      active={@expanded_section == :expenses}
      bg="bg-orangeBg"
      border="border-orangeBg"
      text="text-orangeText"
      active_border="border-orangeText"
      ring="ring-orangeText/20"
      hover_border="hover:border-orangeText/50"
    />

    <div class={[
      "border-2 rounded-lg p-6",
      if(@profitable?,
        do: "bg-greenBg border-greenBg text-greenText",
        else: "bg-redBg border-redBg text-redText"
      )
    ]}>
      <div class="flex items-center">
        <div class="shrink-0">
          <.icon
            name="hero-calculator"
            class={"h-8 w-8 #{if(@profitable?, do: "text-greenText", else: "text-redText")}"}
          />
        </div>
        <div class="ml-4">
          <p class={[
            "text-sm font-medium",
            if(@profitable?, do: "text-greenText", else: "text-redText")
          ]}>
            Zysk netto
          </p>
          <p class={[
            "text-2xl font-bold",
            if(@profitable?, do: "text-greenText", else: "text-redText")
          ]}>
            {Money.new(:PLN, @net_profit)}
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="mb-8">
    <FirmowidWeb.Analysis.Components.EntriesTable.table
      entries={entries_for_section(assigns)}
      tag_definitions={@tag_definitions}
    />
  </div>
</div>
