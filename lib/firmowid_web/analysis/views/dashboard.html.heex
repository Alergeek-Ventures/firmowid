<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <div class="mb-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Analiza finansowa</h1>
        <p class="mt-2 text-gray-600">Przegląd przychodów i kosztów organizacji</p>
      </div>
      <div class="flex items-center gap-3">
        <div :if={@tag_definitions != []} class="relative">
          <label
            id="tag-filter-trigger"
            phx-click={show_popover("tag-filter-popover")}
            class={[
              "inline-flex flex-row items-center justify-center transition duration-100 ease-out",
              "cursor-pointer border whitespace-nowrap",
              "h-11 gap-2.5 rounded-lg px-2.75 py-2 text-base/tight font-medium [&>svg]:size-6",
              if(@tag_filters != [],
                do: "border-orange-200 bg-orange-100 text-orange-800",
                else:
                  "active:bg-grey-400 bg-grey-200 hover:bg-grey-300 text-grey-900 border-transparent"
              )
            ]}
          >
            <Lucideicons.tag />
            <span>
              Tagi
              <span :if={@tag_filters != []} class="ml-0.5">
                ({length(@tag_filters)})
              </span>
            </span>
          </label>
          <.popover
            id="tag-filter-popover"
            reference_id="tag-filter-trigger"
            placement="bottom-end"
            class="bg-grey-50 border-grey-200 w-64 rounded-lg border"
          >
            <div class="max-h-80 overflow-y-auto p-1">
              <div class="text-caps-sm text-darkGrey px-2 py-1.5 font-medium uppercase">
                Kategorie
              </div>
              <label class="flex cursor-pointer items-center gap-2 rounded px-2 py-1.5 transition hover:bg-orange-100 hover:text-orange-800">
                <input
                  type="checkbox"
                  checked={tag_filter_active?(@tag_filters, {:company})}
                  phx-click="toggle-tag"
                  phx-value-tag="firma"
                  class="border-darkGrey text-darkGrey size-4 rounded-[3px] border focus:ring-0"
                />
                <span class="text-darkGrey text-sm">Firma</span>
              </label>

              <div
                :if={@tag_definitions != []}
                class="text-caps-sm text-darkGrey mt-1 px-2 py-1.5 font-medium uppercase"
              >
                Projekty
              </div>
              <label
                :for={tag_def <- @tag_definitions}
                class="flex cursor-pointer items-center gap-2 rounded px-2 py-1.5 transition hover:bg-orange-100 hover:text-orange-800"
              >
                <input
                  type="checkbox"
                  checked={tag_filter_active?(@tag_filters, {:project, tag_def.id})}
                  phx-click="toggle-tag"
                  phx-value-tag={"projekt:#{tag_def.id}"}
                  class="border-darkGrey size-4 rounded-[3px] border focus:ring-0"
                  style={"color: #{tag_def.color}"}
                />
                <span
                  class="inline-block size-2 shrink-0 rounded-full"
                  style={"background-color: #{tag_def.color}"}
                ></span>
                <span class="text-darkGrey truncate text-sm">{tag_def.name}</span>
              </label>

              <FirmowidWeb.DesignSystem.Components.Button.button
                :if={@tag_filters != []}
                type="button"
                variant="unstyled"
                phx-click="clear-tag-filters"
                class="border-grey-200 text-darkGrey mt-1 block w-full cursor-pointer border-t px-2 py-1.5 text-center text-xs hover:text-orange-800"
              >
                Wyczyść filtry
              </FirmowidWeb.DesignSystem.Components.Button.button>
            </div>
          </.popover>
        </div>
        <.month_picker
          id="month"
          active_months={@active_months}
          selected_date={@params.month}
        />
      </div>
    </div>
  </div>

  <div class="mb-8 grid grid-cols-1 gap-6 sm:grid-cols-3">
    <.summary_card
      section="income"
      label="Przychody"
      amount={@total_income}
      icon="hero-arrow-trending-up"
      active={@expanded_section == :income}
      bg="bg-blueBg"
      border="border-blueBg"
      text="text-blueText"
      active_border="border-blueText"
      ring="ring-blueText/20"
      hover_border="hover:border-blueText/50"
    />

    <.summary_card
      section="expenses"
      label="Koszty"
      amount={@total_expenses}
      icon="hero-arrow-trending-down"
      active={@expanded_section == :expenses}
      bg="bg-orangeBg"
      border="border-orangeBg"
      text="text-orangeText"
      active_border="border-orangeText"
      ring="ring-orangeText/20"
      hover_border="hover:border-orangeText/50"
    />

    <div class={[
      "rounded-lg border-2 p-6",
      if(@profitable?,
        do: "bg-greenBg border-greenBg text-greenText",
        else: "bg-redBg border-redBg text-redText"
      )
    ]}>
      <div class="flex items-center">
        <div class="shrink-0">
          <.icon
            name="hero-calculator"
            class={"size-8 #{if(@profitable?, do: "text-greenText", else: "text-redText")}"}
          />
        </div>
        <div class="ml-4">
          <p class={[
            "text-sm font-medium",
            if(@profitable?, do: "text-greenText", else: "text-redText")
          ]}>
            Zysk netto
          </p>
          <p class={[
            "text-2xl font-bold",
            if(@profitable?, do: "text-greenText", else: "text-redText")
          ]}>
            {Money.new(:PLN, @net_profit)}
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="mb-8">
    <FirmowidWeb.Analysis.Components.EntriesTable.table
      entries={entries_for_section(assigns)}
      tag_definitions={@tag_definitions}
    />
  </div>
</div>
