<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <div class="mb-8">
    <div class="flex justify-between items-center">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Analiza finansowa</h1>
        <p class="mt-2 text-gray-600">Przegląd przychodów i kosztów organizacji</p>
      </div>
      <div>
        <.date_picker
          id="month"
          active_months={@active_months}
          selected_date={@params.month}
          class="w-48 gap-2"
        />
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-3 mb-8">
    <button
      phx-click="toggle-section"
      phx-value-section="income"
      class={[
        "rounded-lg p-6 text-left cursor-pointer transition-all duration-200",
        "bg-blueBg border-2 text-blueText",
        if(@expanded_section == :income,
          do: "border-blueText ring-2 ring-blueText/20",
          else: "border-blueBg hover:border-blueText/50"
        )
      ]}
    >
      <div class="flex items-center">
        <div class="shrink-0">
          <.icon name="hero-arrow-trending-up" class="h-8 w-8 text-blueText" />
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-blueText">Przychody</p>
          <p class="text-2xl font-bold text-blueText">
            {Money.new(:PLN, @total_income)}
          </p>
        </div>
      </div>
    </button>

    <button
      phx-click="toggle-section"
      phx-value-section="expenses"
      class={[
        "rounded-lg p-6 text-left cursor-pointer transition-all duration-200",
        "bg-orangeBg border-2 text-orangeText",
        if(@expanded_section == :expenses,
          do: "border-orangeText ring-2 ring-orangeText/20",
          else: "border-orangeBg hover:border-orangeText/50"
        )
      ]}
    >
      <div class="flex items-center">
        <div class="shrink-0">
          <.icon name="hero-arrow-trending-down" class="h-8 w-8 text-orangeText" />
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-orangeText">Koszty</p>
          <p class="text-2xl font-bold text-orangeText">
            {Money.new(:PLN, @total_expenses)}
          </p>
        </div>
      </div>
    </button>

    <div class={[
      "border-2 rounded-lg p-6",
      if(Decimal.positive?(@net_profit),
        do: "bg-greenBg border-greenBg text-greenText",
        else: "bg-redBg border-redBg text-redText"
      )
    ]}>
      <div class="flex items-center">
        <div class="shrink-0">
          <.icon
            name="hero-calculator"
            class={"h-8 w-8 #{if(Decimal.positive?(@net_profit), do: "text-greenText", else: "text-redText")}"}
          />
        </div>
        <div class="ml-4">
          <p class={[
            "text-sm font-medium",
            if(Decimal.positive?(@net_profit), do: "text-greenText", else: "text-redText")
          ]}>
            Zysk netto
          </p>
          <p class={[
            "text-2xl font-bold",
            if(Decimal.positive?(@net_profit), do: "text-greenText", else: "text-redText")
          ]}>
            {Money.new(:PLN, @net_profit)}
          </p>
        </div>
      </div>
    </div>
  </div>

  <div :if={@expanded_section} class="mb-8">
    <FirmowidWeb.AnalysisLive.EntriesTable.table entries={entries_for_section(assigns)} />
  </div>
</div>
