<div class="mx-8">
  <div class="flex gap-8">
    <p class="text-darkGrey">Rodzaj faktury</p>
    <div class="flex gap-2">
      <%= for {label, value} <- [{"Polska", :poland}, {"Zagraniczna",:foreign}] do %>
        <.button
          phx-click={
            JS.push("submit",
              value: %{
                "invoice" => %{
                  "invoice_type" => value
                }
              }
            )
          }
          class={[
            "h-7 !px-2 !py-1 leading-tight rounded-md border border-[#dddddd] justify-end items-center",
            @invoice.invoice_type == value && "bg-darkGrey text-greyButtonBg",
            @invoice.invoice_type != value && "bg-lightGreyBg !text-darkGrey"
          ]}
        >
          <div class="text-sm font-medium"><%= label %></div>
        </.button>
      <% end %>
    </div>
  </div>
  <p class="text-darkGrey mt-8">Dane podstawowe</p>

  <.form
    for={@form}
    phx-submit="submit"
    class="flex items-end mt-4 bg-greyButtonBg bg-opacity-50 p-4 gap-8 rounded-md"
  >
    <.input field={@form[:invoice_number]} type="text" label="Numer faktury" required />
    <.input field={@form[:issue_date]} type="date" label="Data wystawienia" required />
    <.input field={@form[:sale_date]} type="date" label="Data sprzedaży" required />
    <.input field={@form[:is_basic_info_confirmed]} type="hidden" />
    <div class="flex gap-2 items-end">
      <.input field={@form[:payment_method]} type="text" label="Sposób płatności" required />
      <.input
        field={@form[:currency]}
        type="select"
        required
        options={
          case @invoice.invoice_type do
            :poland -> ["PLN"]
            :foreign -> ["EUR"]
          end
        }
      />
    </div>
    <.input field={@form[:due_date]} type="date" label="Termin zapłaty" required />
    <.button type="submit" class="bg-blueText font-bold py-2 px-4 rounded">
      Zatwierdź
    </.button>
  </.form>
  <div class="flex mt-16 gap-16">
    <FirmowidWeb.InvoicesLive.SellerFormLive.render seller_form={@form} />
    <FirmowidWeb.InvoicesLive.BuyerFormLive.render buyer_form={@form} />
  </div>
  <div class="mt-16">
    <.form phx-submit="submit" phx-change="change" for={@form}>
      <div class="flex justify-between">
        <p class="text-darkGrey mb-4">
          Pozycje na fakturze
          <%= if @invoice.are_invoice_items_confirmed do %>
            Confirmed
          <% end %>
        </p>
        <.button
          type="button"
          name="invoice[items_sort][]"
          value="true"
          phx-click={JS.dispatch("change")}
          class="bg-greyButtonBg size-8 !p-0"
        >
          <.icon name="hero-plus" class="text-darkGrey h-4 w-4" />
        </.button>
      </div>
      <div class="bg-greyButtonBg bg-opacity-50 p-4 rounded-md">
        <div class="grid grid-cols-[repeat(13,_1fr)] gap-4">
          <div class="col-span-2 text-darkGrey">
            Nazwa towaru/usługi
          </div>
          <div class="col-span-1 text-darkGrey">
            Ilość
          </div>
          <div class="col-span-2 text-darkGrey">
            Jednostka
          </div>
          <div class="col-span-2 text-darkGrey">
            Cena netto
          </div>
          <div class="col-span-1 text-darkGrey">
            VAT %
          </div>
          <%= if  @invoice.invoice_type == :poland do %>
            <div class="col-span-2 text-darkGrey">
              Wartość netto
            </div>
            <div class="col-span-2 text-darkGrey">
              Wartość brutto
            </div>
          <% end %>
          <%= if @invoice.invoice_type == :foreign do %>
            <div class="col-span-4 text-darkGrey">
              Wartość
            </div>
          <% end %>
          <.inputs_for :let={item} field={@form[:invoice_items]}>
            <input type="hidden" name="invoice[items_sort][]" value={item.index} />
            <div class="col-span-2">
              <.input field={item[:name]} type="text" required />
            </div>
            <div class="col-span-1">
              <.input field={item[:quantity]} type="number" required />
            </div>
            <div class="col-span-2">
              <.input field={item[:unit]} type="text" required />
            </div>
            <div class="col-span-2">
              <.input field={item[:unit_price]} type="number" required />
            </div>
            <div class="col-span-1">
              <%= if  @invoice.invoice_type == :poland do %>
                <.input field={item[:vat_rate]} type="number" required />
              <% end %>
              <%= if @invoice.invoice_type == :foreign do %>
                <.input name={item[:vat_rate].name} type="text" disabled readonly value="np." />
              <% end %>
            </div>
            <%= if  @invoice.invoice_type == :poland do %>
              <div class="col-span-2">
                <.input
                  type="text"
                  name={"net_value_#{item.index}"}
                  readonly
                  value={
                    Money.new(
                      :PLN,
                      Decimal.mult(item[:quantity].value, item[:unit_price].value)
                    )
                    |> Money.to_string!(currency_symbol: "")
                  }
                />
              </div>
              <div class="col-span-2">
                <.input
                  type="text"
                  name={"gross_value_#{item.index}"}
                  readonly
                  value={
                    Money.new(
                      :PLN,
                      Decimal.mult(item[:quantity].value, item[:unit_price].value)
                      |> Decimal.mult(
                        item[:vat_rate].value
                        |> Decimal.div(100)
                        |> Decimal.add(1)
                      )
                    )
                    |> Money.to_string!(currency_symbol: "")
                  }
                />
              </div>
            <% end %>
            <%= if @invoice.invoice_type == :foreign do %>
              <div class="col-span-4">
                <.input
                  type="text"
                  class="max-w-56"
                  name={"gross_value_#{item.index}"}
                  readonly
                  value={
                    Money.new(
                      @invoice.currency,
                      Decimal.mult(item[:quantity].value, item[:unit_price].value)
                    )
                    |> Money.to_string!(currency_symbol: "")
                  }
                />
              </div>
            <% end %>
            <.button
              type="button"
              name="invoice[items_drop][]"
              value={item.index}
              phx-click={JS.dispatch("change")}
              class="col-span-1 bg-redBg self-center border-redBg hover:border hover:border-redText hover:border-solid hover:bg-redBg size-8 ml-4 mt-2 !p-0"
            >
              <.icon name="hero-trash" class="w-4 h-4 text-redText" />
            </.button>
          </.inputs_for>
        </div>
        <input type="hidden" name="invoice[items_drop][]" />
        <div class="flex justify-between mt-6">
          <.button
            type="button"
            name="invoice[items_sort][]"
            value="true"
            phx-click={JS.dispatch("change")}
            class="border-greyButtonBg border h-8 flex items-center gap-1 hover:bg-greyButtonBg !text-darkGrey text-sm bg-lightGreyBg font-medium uppercase !px-2 !py-1"
          >
            Dodaj pozycję <.icon name="hero-plus" class="text-darkGrey h-4 w-4" />
          </.button>
          <.input type="hidden" field={@form[:are_invoice_items_confirmed]} value="true" />
          <.button type="submit" class="bg-blueText font-bold py-2 px-4 rounded">
            Zatwierdź
          </.button>
        </div>
      </div>
    </.form>
    <div class="flex justify-between">
      <.form phx-change="submit" for={@form} class="mt-4">
        <%= if  @invoice.invoice_type == :poland do %>
          <.input field={@form[:is_cash_account]} type="checkbox" label="Metoda kasowa" />
        <% end %>
        <%= if  @invoice.invoice_type == :foreign do %>
          <.input
            field={@form[:is_reverse_charge]}
            type="checkbox"
            label="Odwrotne obciążenie i nieopodatkowanie VAT"
          />
        <% end %>
      </.form>
      <div class="bg-greyButtonBg w-96 rounded-md px-4 py-2 mt-10 bg-opacity-30 ml-auto">
        <div class="flex flex-col justify-end mt-3">
          <%= if  @invoice.invoice_type == :poland do %>
            <div class="flex justify-between items-center">
              <span class="text-sm">Wartość netto:</span>
              <span>
                <%= Money.new(
                  @invoice.currency,
                  @invoice |> Firmowid.Invoices.Invoice.get_net_value()
                ) %>
              </span>
            </div>
            <div class="flex justify-between mt-2 items-center">
              <span class="text-sm">VAT:</span>
              <span>
                <%= Money.new(
                  @invoice.currency,
                  @invoice |> Firmowid.Invoices.Invoice.get_vat_value()
                ) %>
              </span>
            </div>
            <div class="flex justify-between items-center mt-3">
              <span class="text-sm">Wartość brutto:</span>
              <span class="font-bold text-xl">
                <%= Money.new(
                  @invoice.currency,
                  @invoice |> Firmowid.Invoices.Invoice.get_gross_value()
                ) %>
              </span>
            </div>
          <% end %>
          <%= if  @invoice.invoice_type == :foreign do %>
            <div class="flex justify-between items-center">
              <span class="text-sm">Suma PLN:</span>
              <span>
                <%= Money.new(
                  "PLN",
                  @invoice |> Firmowid.Invoices.Invoice.get_net_value()
                ) %>
              </span>
            </div>
            <div class="flex gap-2 justify-between mt-2 items-center">
              <div class="flex flex-col">
                <span class="text-sm">Kurs 1 EUR</span>
                <span class="text-sm">
                  Przewalutowanie wg NBP <br />
                  z dnia: <%= Money.ExchangeRates.last_updated()
                  |> elem(1)
                  |> Calendar.strftime("%d.%m.%Y") %>
                </span>
              </div>
              <span>
                <%= Money.cross_rate!("EUR", "PLN") |> Decimal.round(4) %> zł
              </span>
            </div>
            <div class="flex justify-between items-center mt-3">
              <span class="text-sm">Suma EUR:</span>
              <span class="font-bold text-xl">
                <%= Money.to_currency!(
                  Money.new(
                    "PLN",
                    @invoice |> Firmowid.Invoices.Invoice.get_net_value()
                  ),
                  @invoice.currency
                ) %>
              </span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    <div class="flex justify-end items-center gap-6 mb-8 mt-4">
      <%= if not is_nil(@invoice_id) do %>
        <a
          href={"/invoices/#{@invoice_id}/download"}
          download="fakturka.pdf"
          class="hover:text-darkGrey transition-colors"
        >
          Pobierz
        </a>
      <% end %>
      <.button class="bg-blueText w-40 font-bold py-2 px-4 rounded">
        Zapisz fakturę
      </.button>
    </div>
  </div>
</div>
