<div class="max-w-6xl w-full mx-auto flex-1 flex flex-col my-4 relative">
  <.link
    patch={~p"/sprzedazowe?draft=#{@draft_id}&step=#{@step_number - 1}"}
    class="flex items-center gap-2 text-sm absolute -left-[calc(68px+1.5rem)] -top-[2.5px]"
  >
    <Lucideicons.circle_chevron_left /> Wróć
  </.link>

  <div class="px-9">
    <.render_header invoice={@invoice} step={@step_number} title="Podgląd faktury" />

    <div class="mt-8 flex gap-6">
      <div class="flex-1 max-w-[650px]">
        <div class="border border-grey-200 rounded-lg bg-white shadow-sm overflow-hidden">
          <FirmowidWeb.PdfHTML.sales_invoice
            sales_invoice={@preview_invoice}
            currency_rate={@currency_rate}
            show_vat={@organization.is_vat_payer}
          />
        </div>
      </div>

      <div class="space-y-6">
        <h2 class="text-lg font-medium text-grey-700 mb-4">Dane faktury</h2>
        <form phx-change="update_invoice_number">
          <label class="block text-sm text-grey-500 mb-2">Numer faktury</label>
          <input
            type="text"
            name="invoice_number"
            value={@invoice_number}
            phx-debounce="300"
            class="w-full border border-grey-200 rounded-lg px-3 py-2 text-sm text-grey-700 placeholder:text-grey-400 focus:outline-none focus:ring-2 focus:ring-turquoise-500 focus:border-transparent"
          />
        </form>

        <%!-- Invoice number warnings or series suggestions --%>
        <%= if @invoice_warnings != [] do %>
          <div class="space-y-3">
            <%= for warning <- @invoice_warnings do %>
              <div class="p-3 bg-amber-50 bg-orangeBg rounded-lg text-sm">
                <div class="flex items-start gap-2 text-orangeText">
                  <Lucideicons.alert_triangle class="w-4 h-4 text-amber-500 mt-0.5 shrink-0" />
                  <span>
                    <%= case warning do %>
                      <% {:invalid_format, _} -> %>
                        Format numeru może być nieprawidłowy.
                      <% {:duplicate, _} -> %>
                        Numer faktury już istnieje.
                      <% {:gap, _} -> %>
                        Numer tworzy lukę w numeracji.
                    <% end %>
                  </span>
                </div>
                <div class="mt-2 flex flex-wrap gap-2 ml-6">
                  <%= for suggestion <- warning_suggestions(warning) do %>
                    <button
                      type="button"
                      phx-click="select_series"
                      phx-value-number={suggestion}
                      class="px-3 py-1 text-xs rounded bg-turquoise-300 text-turquoise-900 transition"
                    >
                      Użyj {suggestion}
                    </button>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="flex flex-wrap gap-2">
            <%= for {_series, next_number} <- Enum.sort_by(@series_suggestions, fn {s, _} -> if s == nil, do: "", else: s end) do %>
              <button
                type="button"
                phx-click="select_series"
                phx-value-number={next_number}
                class={"px-3 py-1.5 text-sm rounded-lg border #{if @invoice_number == next_number, do: "border-turquoise-500 bg-turquoise-50 text-turquoise-700", else: "border-grey-200 bg-white text-grey-600 hover:bg-grey-50"}"}
              >
                {next_number}
              </button>
            <% end %>
          </div>
        <% end %>

        <label class="block text-sm text-grey-500 mb-2">Komentarz</label>
        <textarea
          rows="4"
          class="w-full border border-grey-200 rounded-lg px-3 py-2 text-sm
              text-grey-700 placeholder:text-grey-400 focus:outline-none
              focus:ring-2 focus:ring-turquoise-500 focus:border-transparent
              resize-none cursor-not-allowed"
          placeholder="Dodaj komentarz do faktury... (wkrótce dostępne)"
          disabled
        ></textarea>

        <%!-- Action buttons --%>
        <div class="flex flex-row gap-4 pt-4">
          <.button
            type="button"
            phx-click="save_as_draft"
            phx-disable-with="Zapisywanie..."
            class="w-full h-11"
            color="light_grey"
            new={true}
          >
            Zapisz wersję roboczą
          </.button>

          <%= if @ksef_connected? do %>
            <.button
              type="button"
              phx-click="send_to_ksef"
              phx-disable-with="Wysyłanie..."
              class="w-full h-11"
              color="turquoise"
              new={true}
            >
              Zapisz i wyślij do KSeF
            </.button>
          <% else %>
            <.button
              type="button"
              phx-click="confirm_invoice"
              phx-disable-with="Zapisywanie..."
              class="w-full h-11"
              color="turquoise"
              new={true}
            >
              Zatwierdź fakturę
            </.button>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
