<div class="max-w-6xl w-full mx-auto flex-1 flex flex-col my-4 relative">
  <.link
    patch={~p"/sprzedazowe?creator_draft=#{@creator_draft_id}&step=#{@step_number - 1}"}
    class="flex items-center gap-2 text-sm absolute -left-[calc(68px+1.5rem)] -top-[2.5px]"
  >
    <Lucideicons.circle_chevron_left /> Wróć
  </.link>

  <.form
    for={@payment_form}
    phx-change="validate_payment"
    phx-submit="submit_payment"
    class="px-9"
  >
    <.render_header invoice={@invoice} step={@step_number} title="Termin i forma płatności" />

    <div class="grid grid-cols-[min-content,1fr] gap-x-5 gap-y-4 items-center mt-8">
      <label class="text-grey-700 whitespace-nowrap">Data sprzedaży</label>
      <.input
        field={@payment_form[:sale_date]}
        type="date"
        phx-debounce
        class="w-min"
        new={true}
      />

      <label class="text-grey-700 whitespace-nowrap">Termin płatności</label>
      <div class="flex items-center gap-3">
        <.input
          field={@payment_form[:due_date_days]}
          type="select"
          options={[{"7 dni", 7}, {"14 dni", 14}, {"21 dni", 21}, {"30 dni", 30}, {"60 dni", 60}]}
          class="w-min"
          new={true}
        />
        <span :if={@payment_form[:due_date].value} class="text-grey-700">
          {Calendar.strftime(@payment_form[:due_date].value, "%d.%m.%Y")}
        </span>
      </div>

      <label class="text-grey-700 whitespace-nowrap">Forma płatności</label>
      <.input
        field={@payment_form[:payment_method]}
        type="select"
        options={[
          {"Przelew", :transfer},
          {"Gotówka", :cash},
          {"Karta", :card}
        ]}
        class="w-min"
        new={true}
      />

      <div class={[
        "col-start-2 border border-grey-200 p-4 rounded-lg w-min min-w-[400px]",
        "grid grid-cols-[min-content,1fr] gap-4 gap-y-2 items-center",
        "transition-opacity duration-200",
        if(Ecto.Changeset.get_field(@payment_form.source, :payment_method) == :transfer,
          do: "opacity-100",
          else: "opacity-0 pointer-events-none"
        )
      ]}>
        <.input field={@payment_form[:seller_account_number]} type="hidden" class="hidden" />

        <%= if Enum.empty?(@bank_accounts) do %>
          <p class="col-span-2 text-sm/snug text-grey-700">
            Żadne z Twoich kont nie jest podpięte.
          </p>
          <.link
            class={
              classes([
                button_styles(%{size: "small", color: "light_grey", new: true}),
                "inline-flex items-center gap-1.5"
              ])
            }
            target="_blank"
            href="/ustawienia/konta-bankowe"
          >
            <Lucideicons.plus class="size-4 inline-flex" /> Podepnij konto
          </.link>
        <% end %>

        <%= if not Enum.empty?(@bank_accounts) and @selected_bank_account == nil do %>
          <p class="col-span-2">
            Brak domyślnego konta dla tej waluty
            ({@payment_form[:currency].value}).
          </p>

          <.button
            type="button"
            size="small"
            color="light_grey"
            new={true}
            class="col-span-2 mt-4"
            phx-click={show_modal("bank_account_selector_modal")}
          >
            Wybierz konto
          </.button>
        <% end %>

        <%= if not Enum.empty?(@bank_accounts) and @selected_bank_account != nil do %>
          <div class="pb-2 pr-2">
            <Lucideicons.landmark class="size-[42px] text-grey-700" />
          </div>

          <div class="flex flex-row gap-2 items-center">
            <p
              :if={
                @selected_bank_account.is_default and
                  @selected_bank_account.currency == @invoice.currency
              }
              class="h-min py-1 px-4 rounded-full text-sm/snug text-green-700 bg-green-200"
            >
              domyślny <strong>{@selected_bank_account.currency}</strong>
            </p>

            <p
              :if={@selected_bank_account.currency != @invoice.currency}
              class="h-min py-1 px-4 rounded-full text-sm/snug text-redText bg-redBg"
            >
              waluta konta: <strong>{@selected_bank_account.currency}</strong>
            </p>

            <.button
              type="button"
              size="small"
              color="light_grey"
              new={true}
              class="h-min ml-auto"
              phx-click={show_modal("bank_account_selector_modal")}
            >
              Zmień
            </.button>
          </div>

          <p class="text-grey-500 text-sm/snug">Bank</p>
          <p class="text-grey-700 text-sm/snug">{@selected_bank_account.institution_name}</p>

          <p class="text-grey-500 text-sm/snug">Numer</p>
          <p class="text-grey-700 text-sm/snug">{@selected_bank_account.iban}</p>
        <% end %>
      </div>
    </div>

    <div class="w-full flex flex-row justify-end mt-20">
      <.button
        type="submit"
        phx-disable-with="Przetwarzanie..."
        class="max-w-44 w-full h-11"
        color="turquoise"
        new={true}
        disabled={not @payment_form.source.valid?}
      >
        Dalej
      </.button>
    </div>
  </.form>

  <%!-- Bank account selector modal --%>
  <.modal id="bank_account_selector_modal" class="max-w-4xl">
    <h2 class="text-xl font-medium mb-2">Zmiana rachunku</h2>
    <p class="text-grey-600 mb-6">Wybierz rachunek bankowy, na który chcesz otrzymać wpłatę.</p>

    <div class="space-y-3">
      <%= for account <- @bank_accounts do %>
        <div class={[
          "grid grid-cols-[min-content,min-content,1fr,min-content,min-content] items-center gap-2 p-4 border rounded-lg transition-colors",
          if(@selected_bank_account && @selected_bank_account.id == account.id,
            do: "border-grey-400 bg-grey-50",
            else: "border-grey-200 hover:border-grey-300"
          )
        ]}>
          <Lucideicons.landmark class="size-10 text-grey-600 shrink-0 mr-4" />

          <div class="flex flex-col gap-2 text-sm">
            <span class="block text-grey-500">Bank</span>
            <span class="block text-grey-500">Numer</span>
          </div>

          <div class="flex flex-col gap-2 text-sm">
            <span class="block text-grey-700 truncate">{account.institution_name}</span>
            <span class="block text-grey-700">{account.iban}</span>
          </div>

          <p
            :if={account.is_default}
            class="py-1 px-3 rounded-full text-sm/snug text-green-700
        bg-green-200 whitespace-nowrap mx-4"
          >
            domyślny <strong>{account.currency}</strong>
          </p>

          <%= if @selected_bank_account && @selected_bank_account.id == account.id do %>
            <span class="py-1.5 px-3 rounded-md text-sm font-medium text-white bg-grey-800">
              Wybrany
            </span>
          <% else %>
            <.button
              type="button"
              size="small"
              variant="outline"
              new={true}
              phx-click="select_bank_account"
              phx-value-account_id={account.id}
            >
              Wybierz
            </.button>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="mt-6 flex justify-end">
      <.button
        type="button"
        color="turquoise"
        new={true}
        phx-click={hide_modal("bank_account_selector_modal")}
      >
        Dalej
      </.button>
    </div>
  </.modal>
</div>
