<div class="grid grid-cols-[max-content_1fr] grid-rows-[repeat(2,min-content)] gap-x-10 w-full max-w-7xl mx-auto my-4">
  <.link
    navigate={~p"/zarzadzanie/pracownicy"}
    class="flex gap-2 items-center justify-self-start mb-8"
  >
    <.icon name="hero-arrow-left-circle-solid" class="size-8" />
    <span class="text-darkGrey">Pracownicy</span>
  </.link>

  <.card class="w-full max-w-[380px] min-h-[689px] row-start-2">
    <div class="flex gap-3">
      <.avatar>
        <%!-- TODO: add user avatar --%>
        <.icon name="hero-user" class="size-20 text-darkGrey" />
      </.avatar>
      <div>
        <h2 class="text-lg font-bold">{get_employee_display_name(@employee)}</h2>
        <div :if={@employee.slack_id != nil} class="text-darkGrey text-sm flex gap-2 items-center">
          <img src="/images/slack.png" alt="slack logo" width={24} height={24} />
          <.link
            href={"#{get_employee_slack_url(@employee)}/team/#{@employee.slack_id}"}
            class="border-b border-transparent hover:border-darkGrey transition-colors"
          >
            napisz na Slacku
          </.link>
        </div>
      </div>
    </div>

    <.user_card_info :if={@employee.phone != nil} label="Numer telefonu">
      {@employee.phone}
    </.user_card_info>
    <.user_card_info label="Adres e-mail">{@employee.email}</.user_card_info>
    <.user_card_info :if={@employee.bank_account_number != nil} label="Numer konta bankowego">
      <span>{@employee.bank_account_number}</span>
      <button
        id="copy-bank-account-number"
        onclick={"navigator.clipboard.writeText('#{@employee.bank_account_number}')"}
        type="button"
        class={[
          "h-6 w-7 text-darkGrey rounded-[3px]",
          "bg-greyButtonBg self-center justify-self-end",
          "shrink-0 flex flex-row justify-center items-center",
          "hover:border-darkGrey border border-transparent",
          "active:bg-darkGrey active:text-lightGreyBg",
          "transition-all transition-duration-300"
        ]}
      >
        <.icon name="hero-document-duplicate" class="size-5" />
      </button>
    </.user_card_info>

    <.user_card_info :if={not Enum.empty?(@employee.projects)} label="Projekty">
      <div class="flex flex-wrap gap-2 mt-2 text-sm/tight">
        <.link
          :for={project <- @employee.projects}
          navigate={~p"/zarzadzanie/projekty/#{project.id}"}
          class="bg-turquoise-200 text-turquoise-700 rounded-full px-4 py-1 text-sm/snug hover:bg-turquoise-300 hover:text-turquoise-800 transition"
        >
          {project.name}
        </.link>
      </div>
    </.user_card_info>

    <span
      :if={@employee.birthday != nil}
      class="mt-auto text-sm/snug text-grey-700 inline-flex gap-2 items-center"
    >
      {TimeFormatter.format_date(@employee.birthday, "d MMMM")}
      <.icon name="hero-cake" class="size-5" />
    </span>
  </.card>

  <div :if={false} class="flex gap-10 px-6 self-end col-start-2">
    <.link
      :for={
        {path, label, action} <-
          [
            {~p"/zarzadzanie/pracownicy/#{@employee.id}", "Projekty i ewidencja", :projects}
          ]
      }
      navigate={path}
      class={
        classes([
          "phx-click-loading:opacity-50 p-3 rounded-t-md font-medium text-darkGrey transition-all",
          "shadow shadow-transparent hover:text-black hover:shadow-black/10 hover:bg-white",
          @live_action == action &&
            "text-black shadow-black/10 bg-grey-50"
        ])
      }
    >
      {label}
    </.link>
  </div>

  <div class="w-full space-y-6 row-start-2 col-start-2">
    <%= case @live_action do %>
      <% :projects -> %>
        <.employee_projects_tab
          employee={@employee}
          projects_filter_date={@projects_filter_date}
          active_months={@active_months}
        />
    <% end %>
  </div>
</div>
