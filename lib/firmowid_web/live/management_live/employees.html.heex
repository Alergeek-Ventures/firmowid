<div class="flex flex-col gap-6 w-full max-w-7xl mx-auto my-4">
  <div class="flex items-center justify-between">
    <form class="flex gap-5" phx-submit="search">
      <.date_picker
        id="month"
        selected_date={@selected_date}
        active_months={@active_months}
      />
      <div class={[
        @search_expanded && "focus-within:ring-2",
        "flex items-center justify-center bg-greyButtonBg rounded-[5px] min-w-10 transition-shadow"
      ]}>
        <.input
          type="text"
          name="q"
          value={@search}
          placeholder="Szukaj pracownika"
          phx-change="search"
          phx-debounce="300"
          input_class="py-0 px-1 bg-transparent border-none"
          class={[
            "transition-[width,opacity,padding] duration-300 ease-in-out border-transparent",
            "focus:border-none focus:ring-0 focus:outline-hidden",
            @search_expanded && "w-64 opacity-100 px-2 py-1",
            !@search_expanded && "w-0 opacity-0 px-0"
          ]}
        />
        <.button
          type="button"
          phx-click="toggle_search"
          class="p-2 bg-transparent text-darkGrey border-none flex"
          id="search-button"
        >
          <.icon name="hero-magnifying-glass" class="w-5 h-5" />
        </.button>
      </div>
    </form>

    <div class="flex gap-4">
      <.link
        :if={@can_export_csv}
        class={button_styles(%{variant: "ghost", size: "small", new: true})}
        download
        href={
          ~p"/czasosledz/projekty/csv?month=#{@selected_date.month}&year=#{@selected_date.year}"
        }
      >
        <Lucideicons.cloud_download class="size-4" /> Pobierz raport wypłat
      </.link>
      <.link
        navigate="/zaproszenia"
        class={button_styles(%{new: true, color: "light_grey", size: "medium"})}
      >
        <.icon name="hero-plus-mini" class="size-6" /> Dodaj pracownika
      </.link>
    </div>
  </div>

  <div class="flex gap-4">
    <.switch
      class="ml-auto flex-row-reverse gap-4"
      label="Widok wypłat"
      field={@form[:viewing_wages]}
      phx-click="toggle_wages_view"
    />
  </div>

  <form
    phx-submit="save_wages"
    class={[
      "grid gap-x-6 gap-y-2",
      @view == :standard && "grid-cols-[1fr_min-content_min-content_min-content]",
      @view != :standard && "grid-cols-[2fr_1fr_1fr_1fr_min-content_min-content]"
    ]}
  >
    <div class="grid grid-cols-subgrid col-span-full items-center text-sm/snug text-grey-700 px-4 h-11">
      <p>Pracownik</p>
      <p class="text-right text-nowrap">Przepracowane godziny</p>

      <%= if @view in [:wages, :wage_editor] do %>
        <%= case @view do %>
          <% :wages -> %>
            <button
              phx-click="toggle_wage_editor"
              type="button"
              class="px-2 py-1 rounded-sm hover:bg-grey-200 transition flex items-center gap-1.5 justify-self-end"
            >
              Stawka <.icon name="hero-pencil-square-solid" class="size-4" />
            </button>
          <% :wage_editor -> %>
            <div class="flex gap-2 justify-self-end">
              <button
                id="wage-editor-toggle"
                class="bg-grey-200 text-grey-700 rounded-sm px-3 py-1 inline-flex"
                phx-click="toggle_wage_editor"
                phx-hook="ConfirmLeave"
                data-unsaved={true}
                type="button"
              >
                <.icon name="hero-arrow-uturn-left-micro" class="size-4" />
              </button>
              <button
                class="bg-orange-200 text-orange-700 rounded-sm uppercase px-3 py-1 font-medium text-caps-sm/tight w-22"
                type="submit"
              >
                Zapisz
              </button>
            </div>
        <% end %>

        <p class="text-right">Wynagrodzenie</p>
      <% end %>
    </div>

    <%= if Enum.empty?(@employees) do %>
      <div class="col-span-full text-center text-darkGrey py-10">
        Brak wyników. Spróbuj zmienić kryteria wyszukiwania.
      </div>
    <% else %>
      <div
        :for={employee <- @employees}
        :key={employee.user.id}
        class="grid grid-cols-subgrid col-span-full h-14"
      >
        <div class={[
          "grid grid-cols-subgrid items-center bg-white rounded-sm px-4",
          if(@view == :standard, do: "col-span-3", else: "col-span-5")
        ]}>
          <div class="flex items-center gap-4">
            <.avatar><.icon name="hero-user" class="h-8 w-8" /></.avatar>
            <.link
              navigate={~p"/zarzadzanie/pracownicy/#{employee.user.id}"}
              class="hover:underline"
            >
              {employee.user.name || employee.user.email}
            </.link>
          </div>

          <p class="text-right">
            {TimeConverter.time_worked_in_seconds_to_hours(employee.time_worked)} h
          </p>

          <%= if @view in [:wages, :wage_editor] do %>
            <%= case @view do %>
              <% :wages -> %>
                <p class="text-right mx-2">
                  {Decimal.round(employee.hourly_rate || 0)} zł/godz.
                </p>
              <% :wage_editor -> %>
                <div class="flex gap-1 items-center mx-2 justify-self-end">
                  <.input
                    type="number"
                    class="w-14"
                    input_class="text-right"
                    new={true}
                    step="0.01"
                    min="0"
                    name={"employee[#{employee.user.id}][wage]"}
                    value={Decimal.round(employee.hourly_rate || 0)}
                  />
                  <p>zł/godz.</p>
                </div>
            <% end %>

            <p class="font-medium text-right">
              {:PLN
              |> Money.new(
                employee.time_worked
                |> TimeConverter.time_worked_in_seconds_to_hours()
                |> Decimal.new()
                |> Decimal.mult(employee.hourly_rate || 0)
              )
              |> Money.to_string!(fractional_digits: 0, currency_symbol: "PLN")}
            </p>
          <% end %>

          <.link
            navigate={~p"/zarzadzanie/pracownicy/#{employee.user.id}"}
            class="flex items-center"
          >
            <Lucideicons.chevron_right class="size-4 shrink-0 text-grey-700" />
          </.link>
        </div>

        <div class="flex items-center gap-4 bg-white rounded-sm p-4 ml-2">
          <.hours_record_status hours_record={employee.hours_record} user={employee.user} />

          <button
            type="button"
            id={"copy-bank-number-#{employee.user.id}"}
            phx-hook="Tippy"
            data-tippy-content="Skopiuj numer konta"
            disabled={is_nil(employee.user.bank_account_number)}
            onclick={"navigator.clipboard.writeText('#{employee.user.bank_account_number}')"}
            class="text-grey-700 hover:text-grey-800 active:text-grey-900 disabled:text-grey-400 inline-flex active:scale-95 transition"
          >
            <.icon name="hero-credit-card-micro" class="size-6 shrink-0" />
          </button>
        </div>
      </div>
    <% end %>
  </form>
</div>
