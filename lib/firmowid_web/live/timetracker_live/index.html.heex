<div class="max-w-6xl w-full mx-auto">
  <%!-- todo: css background image --%>
  <img
    src="/images/figurine_timeracker.png"
    class="h-[135vh] pointer-events-none fixed top-[20%] left-0 z-0 hidden lg:block"
  />

  <div class="flex items-center justify-between gap-4 -mt-4 pt-12 pb-9 sticky top-16 z-30 bg-lightGreyBg">
    <div class="flex gap-2 shrink-0">
      <Lucideicons.calendar_1 />
      <p class="line-clamp-1 text-grey-900">{format_current_day_header(Date.utc_today())}</p>
    </div>

    <.link
      navigate={~p"/czasosledz/ewidencja"}
      class={button_styles(%{variant: "outline", size: "medium", new: true})}
    >
      <Lucideicons.clipboard_list /> Ewidencja
    </.link>
  </div>

  <div class="w-full flex gap-10 lg:gap-20 justify-between flex-col md:flex-row">
    <div class="max-w-md w-full mx-auto md:mx-0">
      <%= if Enum.empty?(@active_projects) do %>
        <div class="w-full text-center py-8 text-darkGrey">
          <p class="text-lg font-semibold">Nie masz przypisanych projektów</p>
          <%= if @current_user.role == :admin do %>
            <p class="text-sm mt-2">
              Dodaj swój pierwszy projekt i przypisz się do niego, aby rozpocząć śledzenie czasu
            </p>
            <.link
              navigate={~p"/zarzadzanie/projekty"}
              class="mt-4 inline-block text-orangeText hover:underline"
            >
              Przejdź do zarządzania projektami
            </.link>
          <% else %>
            <p class="text-sm mt-2">Poproś administratora o przypisanie Cię do projektu</p>
          <% end %>
        </div>
      <% else %>
        <.form
          id="session_form"
          phx-change={if @current_session, do: "validate_and_update", else: "validate"}
          phx-submit="save"
          for={@form}
          class="w-full flex flex-col sticky top-[12.1rem]"
        >
          <div class="flex flex-col gap-4">
            <% is_hours_record_submitted = @is_hours_record_submitted %>

            <.input
              field={@form[:title]}
              required={true}
              placeholder={
                if not is_hours_record_submitted,
                  do: "Nad czym dzisiaj pracujesz?",
                  else: "Nie możesz dodać sesji, po wysłaniu ewidencji godzin"
              }
              input_class="h-11 border-none hover:!bg-grey-300 focus:!outline-[2px] focus:!outline-offset-0 focus:!outline-grey-300 bg-greyButtonBg text-black"
              phx-hook="FocusOnMount"
              phx-debounce="300"
              autofocus
            />

            <.input
              type="select"
              disabled={is_hours_record_submitted}
              class="bg-orangeBg text-orangeText border-none px-4 py-2 appearance-none cursor-pointer hover:bg-[#f0e0d8] transition-colors focus:outline-hidden focus:ring-1 focus:ring-orangeText h-11"
              field={@form[:project_id]}
              options={@active_projects |> Enum.map(&{&1.name, &1.id})}
            />

            <div class="flex justify-between mt-2">
              <.switch
                field={@form[:is_remote]}
                label="pracuję z domu"
                class="font-normal gap-3!"
                disabled={is_hours_record_submitted}
              />

              <.button
                type="button"
                new={true}
                id="toggle_extended_form"
                color="light_grey"
                class="h-8 w-8 p-0 rounded-lg"
                phx-click="toggle_extended_form"
                data-active={@is_form_extended}
                disabled={is_hours_record_submitted}
              >
                <Lucideicons.square_pen />
              </.button>
            </div>

            <p :for={{error, _} <- Keyword.get_values(@form.errors, :base)}>{error}</p>
          </div>
          <div class="flex flex-col items-center">
            <%= cond do %>
              <% @is_form_extended -> %>
                <div class="flex flex-col justify-center pt-8 items-center gap-12 w-full ">
                  <div class="flex gap-6 w-full h-8">
                    <.input
                      type="date"
                      class="flex-1 min-w-0"
                      input_class="w-full h-8 border-none bg-grey-200"
                      field={@form[:date]}
                    />

                    <.input
                      step="60"
                      label="od"
                      type="time"
                      class="flex-1 min-w-0 flex items-baseline gap-4 justify-center"
                      input_class="w-full h-8 border-none bg-grey-200"
                      field={@form[:start_time]}
                      value={format_time(@form[:start_time].value)}
                    />

                    <.input
                      step="60"
                      type="time"
                      label="do"
                      class="flex-1 min-w-0 flex items-baseline gap-4 justify-center"
                      input_class="w-full h-8 border-none bg-grey-200"
                      field={@form[:end_time]}
                      value={format_time(@form[:end_time].value)}
                    />
                  </div>

                  <.button
                    :if={!@current_session}
                    new={true}
                    variant="solid"
                    color="orange"
                    size="medium"
                    class=" w-31.5"
                    disabled={is_hours_record_submitted}
                  >
                    Start
                  </.button>
                  <.button
                    :if={@current_session}
                    new={true}
                    phx-click="end_session"
                    type="button"
                    variant="solid"
                    color="orange"
                    size="medium"
                    class=" w-31.5"
                    disabled={is_hours_record_submitted}
                  >
                    Stop
                  </.button>
                </div>
              <% @current_session -> %>
                <div class="flex flex-col items-center gap-5 mt-14.5 w-full min-w-0">
                  <p
                    class="text-orangeText leading-tight text-2xl text-center font-semibold tracking-normal"
                    id="timetracker-timer"
                    data-start_time={@current_session.start_datetime}
                    phx-hook="Timer"
                  >
                    {TimeFormatter.format_timer(@current_session.duration, :with_seconds)}
                  </p>

                  <.button
                    phx-click="end_session"
                    type="button"
                    variant="solid"
                    color="orange"
                    size="medium"
                    new={true}
                    class=" w-31.5"
                  >
                    Stop
                  </.button>
                </div>
              <% true -> %>
                <div class="flex flex-col items-center gap-5 mt-8 w-full">
                  <div class="h-[60px]">
                    <p class="text-orangeText text-2xl text-center font-semibold leading-tight">
                      {@month_stats.hours} godz. {@month_stats.minutes} min
                    </p>
                    <p class="text-orangeText text-center">w {@month_stats.month}</p>
                  </div>
                  <.button
                    new={true}
                    variant="solid"
                    color="orange"
                    size="medium"
                    class=" w-31.5"
                    disabled={is_hours_record_submitted}
                  >
                    Start
                  </.button>
                </div>
            <% end %>
          </div>
        </.form>
      <% end %>
    </div>
    <div class="w-full min-w-0 space-y-16 mb-16">
      <div
        :if={Enum.empty?(@grouped_sessions) and Enum.empty?(@today_sessions)}
        class="text-center py-8 text-darkGrey"
      >
        <p class="text-lg font-semibold">Brak zarejestrowanych sesji</p>
        <p class="text-sm mt-2">Rozpocznij swoją pierwszą sesję używając formularza po lewej</p>
      </div>

      <div :if={not Enum.empty?(@today_sessions)}>
        <div class="flex justify-between items-center pb-3">
          <p class=" font-semibold text-orangeText">Twoje dzisiejsze sesje</p>
          <% today_time = @today_sessions |> List.flatten() |> calculate_total_duration() %>
          <p
            class="bg-orangeBg text-orangeText px-2 py-1 rounded-md font-bold text-xl leading-tight"
            id="today-timer"
            phx-hook="Timer"
            data-start_time={DateTime.utc_now() |> DateTime.add(-today_time, :second)}
            data-format="short"
            data-disabled={@current_session == nil}
          >
            {today_time |> TimeFormatter.format_timer()}
          </p>
        </div>
        <div class="divide-y divide-grey-200">
          <FirmowidWeb.Components.Session.render
            :for={sessions <- @today_sessions}
            :key={hd(sessions).id}
            sessions={sessions}
            active_projects={@active_projects}
            projects_by_id={@projects_by_id}
          />
        </div>
      </div>

      <div class="flex flex-col space-y-14">
        <div
          :for={{week, days} <- @grouped_sessions}
          :key={week}
          class={if Enum.empty?(@today_sessions), do: "order-first", else: ""}
        >
          <div :if={Enum.empty?(@today_sessions)} />
          <div class="space-y-8">
            <div
              :for={{day, session_group} <- days}
              :key={day}
              class=" flex flex-col gap-2"
            >
              <p class="text-sm font-semibold flex text-darkGrey sticky top-[190px] bg-lightGreyBg">
                {format_day_header(day)}
              </p>
              <div class="divide-y divide-grey-200">
                <FirmowidWeb.Components.Session.render
                  :for={sessions <- session_group}
                  :key={hd(sessions).id}
                  sessions={sessions}
                  active_projects={@active_projects}
                  projects_by_id={@projects_by_id}
                />
              </div>
            </div>
          </div>
        </div>
      </div>

      <.button
        :if={@next_sessions_after}
        phx-click="load_more"
        color="grey"
        class="mx-auto block"
      >
        Pokaż więcej
      </.button>
    </div>
  </div>
</div>

<.modal
  :if={@trim_plan}
  id="overlap-confirmation"
  show={true}
  on_cancel={JS.push("cancel_overlap_save")}
>
  <div class="space-y-6">
    <div>
      <h3 class="text-lg font-bold text-grey-900">Nakładające się sesje</h3>
      <p class="mt-1 text-sm text-darkGrey">
        Nowa sesja nachodzi na istniejące. Zapisanie wymaga poniższych zmian:
      </p>
    </div>

    <%!-- New session preview --%>
    <FirmowidWeb.Components.Timetracker.Overlap.new_session_card
      title={@trim_plan.new_session_attrs[:title]}
      start_datetime={@trim_plan.new_start}
      end_datetime={@trim_plan.new_end}
      date={@trim_plan.new_start}
      timezone={@timezone}
    />

    <%!-- Affected sessions --%>
    <div class="space-y-3">
      <p class="text-sm font-medium text-darkGrey">Zmiany w istniejących sesjach:</p>

      <FirmowidWeb.Components.Timetracker.Overlap.trim_action_card
        :for={action <- @trim_plan.actions}
        action={action}
        timezone={@timezone}
        projects_by_id={@projects_by_id}
      />
    </div>

    <%!-- Action buttons --%>
    <div class="flex gap-4 pt-2 w-full justify-end">
      <.button
        type="button"
        phx-click={
          JS.push("cancel_overlap_save")
          |> hide_modal("overlap-confirmation")
        }
        new={true}
        color="grey"
      >
        Anuluj
      </.button>
      <.button
        phx-click="confirm_overlap_save"
        variant="solid"
        color="orange"
        new={true}
        phx-disable-with="Zapisywanie..."
      >
        Zapisz i dostosuj sesje
      </.button>
    </div>
  </div>
</.modal>
