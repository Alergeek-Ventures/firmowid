<div class="container flex flex-col p-6">
  <div class="flex justify-end gap-4">
    <.link
      :if={@current_user.role == :employee}
      navigate={~p"/czasosledz/ewidencja"}
      class={button_styles(%{color: "light_grey", variant: "outline"})}
    >
      Twoje projekty
    </.link>

    <.link
      :if={Bodyguard.permit?(Firmowid.Timetracker, :read_projects, @current_user)}
      navigate={~p"/czasosledz/projekty"}
      class={button_styles(%{color: "light_grey", variant: "outline"})}
    >
      Zarządzanie
    </.link>

    <.link
      :if={Bodyguard.permit?(Firmowid.Timetracker, :create_project, @current_user)}
      navigate={~p"/czasosledz/projekty/dodaj"}
      class={classes(["ml-2", button_styles(%{color: "black"})])}
    >
      <.icon name="hero-plus-mini" class="size-6 mr-1.5" /> Dodaj projekt
    </.link>
  </div>

  <div class="flex justify-between items-center gap-8 mt-24 px-4 max-w-6xl w-full mx-auto">
    <%= if Enum.empty?(@active_projects) do %>
      <div class="w-full max-w-md text-center py-8 text-darkGrey">
        <p class="text-lg font-semibold">Nie masz przypisanych projektów</p>
        <%= if Bodyguard.permit?(Firmowid.Timetracker, :create_project, @current_user) do %>
          <p class="text-sm mt-2">
            Dodaj swój pierwszy projekt i przypisz się do niego, aby rozpocząć śledzenie czasu
          </p>
          <.link
            navigate={~p"/czasosledz/projekty"}
            class="mt-4 inline-block text-orangeText hover:underline"
          >
            Przejdź do zarządzania projektami
          </.link>
        <% else %>
          <p class="text-sm mt-2">Poproś administratora o przypisanie Cię do projektu</p>
        <% end %>
      </div>
    <% else %>
      <.form
        id="session_form"
        phx-change="validate"
        phx-submit="save"
        for={@form}
        class="w-full max-w-md flex flex-col gap-4"
      >
        <% is_hours_record_submitted =
          Timetracker.submitted_hours_record?(@current_user.id, Date.utc_today()) %>

        <.input
          type="select"
          disabled={@current_session != nil or is_hours_record_submitted}
          class="w-full font-bold bg-orangeBg text-orangeText border-none px-4 py-3 rounded appearance-none cursor-pointer hover:bg-[#f0e0d8] transition-colors focus:outline-hidden focus:ring-1 focus:ring-orangeText"
          field={@form[:project_id]}
          options={@active_projects |> Enum.map(&{&1.name, &1.id})}
        />
        <%= if @current_session do %>
          <p class="w-full font-bold bg-greyButtonBg px-4 py-3 rounded">
            {@current_session.title}
          </p>
        <% else %>
          <.input
            field={@form[:title]}
            required={true}
            disabled={@current_session != nil or is_hours_record_submitted}
            placeholder={
              if not is_hours_record_submitted,
                do: "Nad czym dzisiaj pracujesz?",
                else: "Nie możesz dodać sesji, po wysłaniu ewidencji godzin"
            }
          />
        <% end %>

        <div :if={@is_form_extended && !@current_session} class="flex gap-2">
          <.input label="Data" type="date" class="w-full" field={@form[:date]} />
          <.input
            step="60"
            label="Od"
            type="time"
            class="w-full"
            field={@form[:start_time]}
            value={format_time(@form[:start_time].value)}
          />
          <.input
            step="60"
            type="time"
            label="Do"
            class="w-full"
            field={@form[:end_time]}
            value={format_time(@form[:end_time].value)}
          />
        </div>

        <p :for={{error, _} <- Keyword.get_values(@form.errors, :base)}>{error}</p>

        <div :if={@current_session} class="text-center mt-2">
          <p
            class="text-2xl font-bold text-orangeText"
            id="timetracker-timer"
            data-start_time={@current_session.start_datetime}
            phx-hook="Timer"
          >
            {TimeFormatter.format_timer(@current_session.duration, :with_seconds)}
          </p>

          <.button phx-click="end_session" color="orange" type="button" class="mt-4 w-full">
            Zatrzymaj
          </.button>
        </div>

        <div :if={!@current_session} class="flex gap-4 mt-2">
          <.button
            type="button"
            variant="outline"
            id="toggle_extended_form"
            color="orange"
            class="w-full phx-click-loading:opacity-60 phx-click-loading:cursor-default"
            phx-click="toggle_extended_form"
            disabled={is_hours_record_submitted}
          >
            {if @is_form_extended, do: "Anuluj", else: "Wprowadź inną datę"}
          </.button>
          <.button color="orange" class="w-full" disabled={is_hours_record_submitted}>
            {if @is_form_extended, do: "Zapisz", else: "Zacznij teraz"}
          </.button>
        </div>
      </.form>
    <% end %>

    <div class="relative max-w-sm w-full aspect-square">
      <div class="w-full h-full rounded-full bg-gray-100"></div>

      <div class="absolute top-0 left-0 w-full h-full aspect-square">
        <div
          class="w-full h-full rounded-full -rotate-90"
          style={"background: conic-gradient(var(--color-orange-text), #{@month_stats.percentage}%, var(--color-grey-button-bg) 0)"}
        >
        </div>

        <div class="absolute top-1/2 left-1/2 size-4/5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-lightGreyBg">
        </div>
      </div>

      <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-center">
        <p
          class="font-bold text-lg md:text-2xl"
          id="month-timer"
          phx-hook="Timer"
          data-start_time={@month_stats.elapsed}
          data-format="pretty"
          data-disabled={@current_session == nil}
        >
          {@month_stats.hours}h {@month_stats.minutes}min
        </p>
        <p class="mt-1 sm:text-sm lg:text-lg">w {@month_stats.month}</p>
      </div>
    </div>
  </div>

  <div
    :if={Enum.empty?(@grouped_sessions) and Enum.empty?(@today_sessions)}
    class="text-center py-8 text-darkGrey"
  >
    <p class="text-lg font-semibold">Brak zarejestrowanych sesji</p>
    <p class="text-sm mt-2">Rozpocznij swoją pierwszą sesję używając formularza powyżej</p>
  </div>

  <div class="space-y-24 my-16 max-w-6xl w-full mx-auto">
    <div :if={not Enum.empty?(@today_sessions)} class="space-y-4 px-4">
      <div class="w-full mt-2 flex text-darkGrey justify-between items-center">
        <p class="text-sm font-semibold">TWOJA DZISIEJSZA SESJA</p>

        <% today_time = @today_sessions |> List.flatten() |> calculate_total_duration() %>
        <p
          class="bg-orangeBg text-orangeText px-2 py-1 rounded-md font-bold text-xl leading-tight"
          id="today-timer"
          phx-hook="Timer"
          data-start_time={DateTime.utc_now() |> DateTime.add(-today_time, :second)}
          data-format="short"
          data-disabled={@current_session == nil}
        >
          {today_time |> TimeFormatter.format_timer()}
        </p>
      </div>
      <div class="space-y-1">
        <.live_component
          :for={sessions <- @today_sessions}
          module={FirmowidWeb.Components.Session}
          id={"tracker-entry-#{hd(sessions).id}"}
          sessions={sessions}
          active_projects={@active_projects}
          projects_by_id={@projects_by_id}
        />
      </div>
    </div>

    <div :for={{week, days} <- @grouped_sessions} class="space-y-6 w-full">
      <div class="flex justify-between items-center px-4 text-darkGrey">
        <p class="text-sm font-semibold">{format_week_header(week)}</p>
        <p class="bg-greyButtonBg px-1.5 py-1 rounded-md font-bold">
          {days
          |> Enum.map(fn {_, session_group} -> session_group end)
          |> List.flatten()
          |> calculate_total_duration()
          |> TimeFormatter.format_timer()}
        </p>
      </div>
      <div class="border-greyButtonBg p-4 pt-2 border rounded-md my-12 mt-16 w-full space-y-12">
        <div :for={{day, session_group} <- days} class="space-y-4">
          <div class="w-full mt-2 flex text-darkGrey justify-between items-center">
            <p class="text-sm font-semibold">{format_day_header(day)}</p>
            <p class="border border-greyButtonBg px-1.5 py-1 rounded-md font-bold">
              {session_group
              |> List.flatten()
              |> calculate_total_duration()
              |> TimeFormatter.format_timer()}
            </p>
          </div>
          <div class="space-y-1">
            <.live_component
              :for={sessions <- session_group}
              module={FirmowidWeb.Components.Session}
              id={"tracker-entry-#{hd(sessions).id}"}
              sessions={sessions}
              active_projects={@active_projects}
              projects_by_id={@projects_by_id}
            />
          </div>
        </div>
      </div>
    </div>
    <.button
      :if={@next_sessions_after}
      phx-click="load_more"
      color="grey"
      class="mx-auto block"
    >
      Pokaż więcej
    </.button>
  </div>
</div>
