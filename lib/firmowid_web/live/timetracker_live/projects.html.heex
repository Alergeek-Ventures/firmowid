<div class="container bg-lightGreyBg p-6">
  <div class="flex justify-end gap-4">
    <%= if Bodyguard.permit?(Firmowid.Timetracker, :read_projects, @current_user) do %>
      <.link navigate={~p"/czasosledz/projekty"} class={button_styles(%{color: "grey"})}>
        Zarządzanie
      </.link>
    <% end %>

    <.link
      navigate={~p"/czasosledz"}
      class={classes(["hover:underline", button_styles(%{color: "grey", variant: "outline"})])}
    >
      Czasośledz
    </.link>

    <.link
      navigate={~p"/czasosledz/ewidencja"}
      class={classes(["hover:underline", button_styles(%{color: "grey", variant: "outline"})])}
    >
      Ewidencja
    </.link>
  </div>

  <h2 class="text-xl font-semibold text-darkGrey mt-5">Ewidencje pracowników</h2>
  <div class="mt-8">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-greyButtonBg">
        <thead class="bg-lightGreyBg">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-darkGrey uppercase tracking-wider">
              Rok
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-darkGrey uppercase tracking-wider">
              Miesiąc
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-darkGrey uppercase tracking-wider">
              Liczba godzin
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-darkGrey uppercase tracking-wider">
              Użytkownik
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-darkGrey uppercase tracking-wider">
              Data utworzenia
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-darkGrey uppercase tracking-wider">
              Akcje
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-greyButtonBg">
          <%= for record <- @hours_records do %>
            <tr class="hover:bg-lightGreyBg transition-colors">
              <td class="px-6 py-4 whitespace-nowrap text-sm text-darkGrey">
                {record.year}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-darkGrey">
                {record.month}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-darkGrey">
                {record.number_of_hours}
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-darkGrey">{record.user.name}</div>
                <div class="text-xs text-darkGrey opacity-75">{record.user.email}</div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-darkGrey">
                {Calendar.strftime(record.inserted_at, "%Y-%m-%d %H:%M")}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <a
                  href={~p"/czasosledz/ewidencja/#{record.id}"}
                  download={"Ewidencja_#{record.year}_#{record.month}_#{record.user.name}.pdf"}
                  class="text-orangeText hover:text-orange-700 transition-colors"
                >
                  Pobierz
                </a>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="flex justify-between items-center mt-4">
    <h2 class="text-xl font-semibold text-darkGrey">Projekty</h2>
    <.button phx-click="new" phx-disable-with="Ładowanie...">
      Dodaj projekt
    </.button>
  </div>

  <div class="mt-4 mb-8">
    <div class="bg-white rounded-lg shadow-sm">
      <div class="p-4">
        <h3 class="text-lg font-medium text-darkGrey mb-4">Lista projektów</h3>
        <div class="divide-y">
          <%= for project <- @projects do %>
            <div class="py-3 flex items-center justify-between">
              <span class="text-darkGrey">{project.name}</span>
              <div class="flex gap-2">
                <.button
                  variant="outline"
                  phx-click="edit"
                  phx-value-id={project.id}
                  phx-disable-with="Edytowanie..."
                >
                  Edytuj
                </.button>
                <.button
                  variant="outline"
                  phx-click="delete"
                  phx-value-id={project.id}
                  phx-disable-with="Usuwanie..."
                  data-confirm="Czy na pewno chcesz usunąć ten projekt?"
                >
                  Usuń
                </.button>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-4">
    <%= for user <- @users do %>
      <div class="mb-4 rounded-lg bg-white shadow-sm">
        <div class="p-4 border-b border-greyButtonBg/30">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
              <.avatar class="size-12 ring-2 ring-greyButtonBg/50">
                <.avatar_image src={user.avatar_url} alt="Avatar" />
                <.avatar_fallback class="bg-blueBg text-blueText">
                  {String.slice(user.email, 0, 1) |> String.upcase()}
                </.avatar_fallback>
              </.avatar>
              <p class="text-darkGrey font-medium">{user.email}</p>
            </div>
            <div class="flex items-center">
              <span class="px-3 py-1 rounded-full text-sm bg-greenBg text-greenText">
                {user.role}
              </span>
            </div>
          </div>
        </div>
        <div class="p-4">
          <div class="flex gap-4">
            <%= for project <- @projects do %>
              <form phx-change="toggle_project">
                <.input
                  type="checkbox"
                  label={project.name}
                  value={Enum.any?(project.users, fn up -> up.id == user.id end)}
                  name={"project[#{project.id}][#{user.id}]"}
                  class="checked:bg-blueBg checked:border-blueText"
                />
              </form>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <.modal :if={@show_modal} id="project-modal" show={@show_modal} on_cancel={JS.push("close")}>
    <div class="space-y-6">
      <h2 class="text-lg font-semibold text-darkGrey">
        {if @editing_project, do: "Edytuj projekt", else: "Nowy projekt"}
      </h2>

      <.form for={@form} phx-change="validate" phx-submit="save">
        <.input field={@form[:name]} label="Nazwa projektu" />

        <div class="mt-6 flex justify-end gap-4">
          <.button
            type="button"
            phx-click="close_modal"
            phx-disable-with="Zamykanie..."
            variant="outline"
          >
            Anuluj
          </.button>
          <.button type="submit" phx-disable-with="Zapisywanie...">
            Zapisz
          </.button>
        </div>
      </.form>
    </div>
  </.modal>
</div>
