<div class="container mt-16">
  <div class="flex gap-16">
    <div class="flex-1 self-end">
      <div class="flex gap-4 items-center">
        <form class="relative" phx-submit="upload" phx-change="upload">
          <div class="hidden">
            <.live_file_input upload={@uploads.user_avatar} />
          </div>
          <.avatar class="size-28">
            <.avatar_image src={@current_user.avatar_url} alt="Avatar" />
            <.avatar_fallback>
              {String.slice(@current_user.email, 0, 1) |> String.upcase()}
            </.avatar_fallback>
          </.avatar>
          <.edit_button
            tag_name="label"
            for={@uploads.user_avatar.ref}
            class="absolute right-0 bottom-0 rounded-full"
          />
        </form>
        <div>
          <h1 class="text-2xl">
            Cześć{@current_user.name && " #{@current_user.name}"}!
          </h1>
          <p>{@current_user.email}</p>
        </div>
      </div>
      <div class="flex gap-10 font-semibold mt-16">
        <%= for {_should_show, {tab, label}} <-
            [

              {true, {"konto", "Twoje konto"}},
              {Bodyguard.permit?(Firmowid.Accounts, :update_organization, @current_user, @current_org), 
              {"organizacja", "Twoja organizacja"}},
              {Bodyguard.permit?(Firmowid.Finances, :read_bank_accounts, @current_user),
              {"konta_bankowe", "Konta bankowe"}}
            ] |> Enum.filter(&elem(&1, 0))
           do %>
          <.link
            patch={~p"/ustawienia?tab=#{tab}"}
            class={
              classes([
                @tab == tab && "text-orangeText",
                "phx-click-loading:opacity-50"
              ])
            }
          >
            {label}
          </.link>
        <% end %>
      </div>
      <hr class="border-t border-t-greyButtonBg mt-4" />
    </div>

    <%= if Bodyguard.permit?(Firmowid.Accounts, :update_organization, @current_user, @current_org) do %>
      <div class="min-w-fit flex gap-3 flex-col">
        <div class="flex gap-1 items-center">
          <p class="font-bold text-base">Logo firmy</p>
          <form id="upload-form" phx-submit="upload" phx-change="upload">
            <div class="hidden">
              <.live_file_input upload={@uploads.organization_avatar} />
            </div>
            <.edit_button
              tag_name="label"
              for={@uploads.organization_avatar.ref}
              class="cursor-pointer"
            />
          </form>
        </div>
        <.avatar class="rounded-none size-36">
          <.avatar_image src={@current_org.avatar_url} alt="Logo firmy" />
          <.avatar_fallback class="rounded-none">
            {String.slice(@current_org.name, 0, 1) |> String.upcase()}
          </.avatar_fallback>
        </.avatar>
      </div>
    <% end %>
  </div>

  <%= case @tab do %>
    <% "organizacja" -> %>
      <div class={
        classes([
          "mt-6 rounded-md p-4  w-fit border border-transparent",
          @company_form[:is_basic_info_editing].value && "border-greyButtonBg"
        ])
      }>
        <div class="flex gap-1">
          <h2 class="font-bold mt-0.5">Dane firmy</h2>
          <.edit_button
            phx-click={
              JS.push("save",
                value: %{
                  "organization" => %{
                    "is_basic_info_editing" => !@company_form[:is_basic_info_editing].value
                  }
                }
              )
            }
            class={
              classes([
                @company_form[:is_basic_info_editing].value == true &&
                  "text-orangeText hover:text-orangeText/70 active:text-orangeText/90"
              ])
            }
          />
        </div>
        <%= if @company_form[:is_basic_info_editing].value do %>
          <div class="flex flex-col gap-4 mt-6">
            <.form class="flex flex-col gap-4" phx-submit="save" for={@company_form}>
              <%= for [field, label, type] <- [
                [:organization_type, "Rodzaj działalności", "text"],
                [:name, "Nazwa organizacji", "text"],
                [:identification_number, "NIP", "text"],
                [:address, "Adres przedsiębiorstwa", "text"],
                [:phone_number, "Numer telefonu", "text"],
                [:is_vat_payer, "Czy jest płatnikiem VAT?", "checkbox"]
              ] do %>
                <div class="flex">
                  <label
                    for={@company_form[field].id}
                    class="w-48 flex items-center justify-end font-medium text-darkGrey uppercase text-xs pr-4"
                  >
                    {label}
                  </label>
                  <div class="flex-1 text-sm">
                    <.input
                      type={type}
                      field={@company_form[field]}
                      class="font-normal h-8 mt-0 w-[439px]"
                      input_class="mt-0 h-8 border-greyButtonBg"
                    />
                  </div>
                </div>
              <% end %>
              <.input type="hidden" field={@company_form[:is_basic_info_editing]} value="false" />

              <.button
                color="orange"
                class="w-fit ml-auto"
                type="submit"
                phx-disable-with="Zapisywanie..."
              >
                Zatwierdź
              </.button>
            </.form>
          </div>
        <% else %>
          <div class="space-y-4 mt-6">
            <%= for {label, value} <- [
              {"Rodzaj działalności", @current_org.organization_type},
              {"Nazwa organizacji", @current_org.name},
              {"NIP", @current_org.identification_number},
              {"Adres przedsiębiorstwa", @current_org.address},
              {"Numer telefonu", @current_org.phone_number},
              {"Płatnik VAT", if(@current_org.is_vat_payer, do: "Tak", else: "Nie")}
            ], value do %>
              <div class="flex">
                <div class="w-64 flex items-center justify-end font-medium text-darkGrey uppercase text-xs pr-4">
                  {label}
                </div>
                <div class="flex-1">
                  <%= if is_list(value) do %>
                    <%= for line <- value do %>
                      <div>{line}</div>
                    <% end %>
                  <% else %>
                    {value}
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class={
        classes([
          "mt-6 rounded-md p-4 w-fit border border-transparent",
          @correspondence_form[:is_correspondence_editing].value && "border-greyButtonBg"
        ])
      }>
        <div class="flex gap-1">
          <h2 class="font-bold mt-0.5">Adres korespondencyjny</h2>
          <.edit_button
            phx-click={
              JS.push("save",
                value: %{
                  "organization" => %{
                    "is_correspondence_editing" =>
                      !@correspondence_form[:is_correspondence_editing].value
                  }
                }
              )
            }
            class={
              classes([
                @correspondence_form[:is_correspondence_editing].value == true &&
                  "text-orangeText hover:text-orangeText/70 active:text-orangeText/90"
              ])
            }
          />
        </div>
        <%= if @correspondence_form[:is_correspondence_editing].value do %>
          <div class="flex flex-col gap-4 mt-6">
            <.form class="flex flex-col gap-4" phx-submit="save" for={@correspondence_form}>
              <%= for {field, label} <- [
                {:correspondence_name, "Nazwa organizacji"},
                {:correspondence_address, "Adres przedsiębiorstwa"}
              ] do %>
                <div class="flex">
                  <label
                    for={@correspondence_form[field].id}
                    class="w-48 flex items-center justify-end font-medium text-darkGrey uppercase text-xs pr-4"
                  >
                    {label}
                  </label>
                  <div class="flex-1 text-sm">
                    <.input
                      field={@correspondence_form[field]}
                      class="font-normal h-8 mt-0 w-[439px]"
                      input_class="mt-0 h-8 border-greyButtonBg"
                    />
                  </div>
                </div>
              <% end %>
              <.input
                type="hidden"
                field={@correspondence_form[:is_correspondence_editing]}
                value="false"
              />
              <.button
                color="orange"
                class="w-fit ml-auto"
                type="submit"
                phx-disable-with="Zapisywanie..."
              >
                Zatwierdź
              </.button>
            </.form>
          </div>
        <% else %>
          <div class="space-y-4 mt-6">
            <%= for {label, value} <- [
              {"Nazwa do korespondencji", @current_org.correspondence_name},
              {"Adres do korespondencji", @current_org.correspondence_address}
            ], value do %>
              <div class="flex">
                <div class="w-64 flex items-center justify-end font-medium text-darkGrey uppercase text-xs pr-4">
                  {label}
                </div>
                <div class="flex-1">
                  <%= if is_list(value) do %>
                    <%= for line <- value do %>
                      <div>{line}</div>
                    <% end %>
                  <% else %>
                    {value}
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="mt-6 rounded-md p-4 w-fit border border-transparent">
        <h2 class="font-bold mt-0.5">Adres e-mail do faktur kosztowych</h2>
        <div class="space-y-4 mt-6">
          <div class="flex">
            <div class="w-64 flex items-center justify-end font-medium text-darkGrey uppercase text-xs pr-4">
              Adres e-mail
            </div>
            <div class="flex-1 flex items-center gap-4">
              <code class="bg-gray-100 px-3 py-1 rounded text-sm">
                {@current_org.inbound_email_nickname}@firmowid.pl
              </code>
              <.button
                color="orange"
                variant="outline"
                phx-click="regenerate_inbound_nickname"
                phx-disable-with="Generowanie..."
                class="text-xs py-1 px-3"
              >
                Wygeneruj nowy
              </.button>
            </div>
          </div>
          <div class="flex">
            <div class="w-64 flex items-start justify-end font-medium text-darkGrey uppercase text-xs pr-4 mt-1">
              Opis
            </div>
            <div class="flex-1 text-sm text-gray-600 max-w-lg">
              Wysyłaj faktury kosztowe na ten adres, a zostaną automatycznie zaimportowane do systemu.
              Tylko adresy z dozwolonej listy będą akceptowane.
            </div>
          </div>
        </div>
      </div>

      <div class="mt-6 rounded-md p-4 w-fit border border-transparent">
        <h2 class="font-bold mt-0.5">Dozwolone adresy e-mail</h2>
        <div class="space-y-4 mt-6">
          <div class="flex">
            <div class="w-64 flex items-start justify-end font-medium text-darkGrey uppercase text-xs pr-4 mt-1">
              Lista dozwolonych
            </div>
            <div class="flex-1">
              <%= if @current_org.allowed_sender_emails == [] do %>
                <p class="text-sm text-gray-500 italic">Brak dozwolonych adresów e-mail</p>
              <% else %>
                <div class="space-y-2">
                  <%= for email <- @current_org.allowed_sender_emails do %>
                    <div class="flex items-center gap-2 bg-gray-50 px-3 py-2 rounded">
                      <code class="text-sm flex-1">{email}</code>
                      <button
                        type="button"
                        phx-click="remove_allowed_email"
                        phx-value-email={email}
                        class="text-red-600 hover:text-red-800"
                      >
                        <.icon name="hero-x-mark" class="w-5 h-5" />
                      </button>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
          <div class="flex">
            <div class="w-64 flex items-center justify-end font-medium text-darkGrey uppercase text-xs pr-4">
              Dodaj nowy adres
            </div>
            <div class="flex-1">
              <form phx-submit="add_allowed_email" class="flex gap-2">
                <input
                  type="email"
                  name="email"
                  required
                  placeholder="email@example.com"
                  class="flex-1 rounded-md border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm"
                />
                <.button type="submit" color="orange" variant="outline" class="text-xs py-1 px-3">
                  Dodaj
                </.button>
              </form>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-6 ml-4">
        <.link navigate={~p"/zaproszenia"} class={button_styles(%{variant: "outline"})}>
          Dodaj współpracowników do organizacji
        </.link>
      </div>
    <% "konto" -> %>
      <div class="mt-6">
        <div class="ml-4">
          <div class="flex gap-4">
            <h2 class="font-bold">Dane dostępowe</h2>
            <.link class="text-sm mt-0.5 hover:underline" navigate={~p"/ustawienia/uzytkownik"}>
              Edytuj
            </.link>
          </div>
          <div class="space-y-4 mt-6">
            <div class="flex">
              <div class="w-64 mt-1 font-medium text-darkGrey uppercase text-xs text-right pr-4">
                Email
              </div>
              <div class="flex-1">
                {@current_user.email}
              </div>
            </div>
            <div class="flex">
              <div class="w-64 mt-1 font-medium text-darkGrey uppercase text-xs text-right pr-4">
                Hasło
              </div>
              <div class="flex-1">
                **************
              </div>
            </div>
          </div>
        </div>
        <div class={
          classes([
            "mt-6 rounded-md p-4 w-fit border border-transparent",
            @user_form[:is_personal_info_editing].value && "border-greyButtonBg"
          ])
        }>
          <div class="flex gap-1">
            <h2 class="font-bold mt-0.5">Dane osobowe</h2>
            <.edit_button
              phx-click={
                JS.push("save",
                  value: %{
                    "user" => %{
                      "is_personal_info_editing" => !@user_form[:is_personal_info_editing].value
                    }
                  }
                )
              }
              class={
                classes([
                  @user_form[:is_personal_info_editing].value == true &&
                    "text-orangeText hover:text-orangeText/70 active:text-orangeText/90"
                ])
              }
            />
          </div>
          <%= if @user_form[:is_personal_info_editing].value do %>
            <div class="flex flex-col gap-4 mt-6">
              <.form class="flex flex-col gap-4" phx-submit="save" for={@user_form}>
                <%= for [field, label, type] <- [
                  [:name, "Imię i nazwisko", "text"],
                  [:employment_date, "Data zatrudnienia", "date"]
                ] do %>
                  <div class="flex">
                    <label
                      for={@user_form[field].id}
                      class="w-48 flex items-center justify-end font-medium text-darkGrey uppercase text-xs pr-4"
                    >
                      {label}
                    </label>
                    <div class="flex-1 text-sm">
                      <.input
                        type={type}
                        field={@user_form[field]}
                        class="font-normal h-8 mt-0 w-[439px]"
                        input_class="mt-0 h-8 border-greyButtonBg"
                      />
                    </div>
                  </div>
                <% end %>
                <.input type="hidden" field={@user_form[:is_personal_info_editing]} value="false" />
                <.button
                  color="orange"
                  class="w-fit ml-auto"
                  type="submit"
                  phx-disable-with="Zapisywanie..."
                >
                  Zatwierdź
                </.button>
              </.form>
            </div>
          <% else %>
            <div class="space-y-4 mt-6">
              <%= for {label, value} <- [
                {"Imię i nazwisko", @current_user.name},
                {"Data zatrudnienia", @current_user.employment_date}
              ], value do %>
                <div class="flex">
                  <div class="w-64 mt-1 font-medium text-darkGrey uppercase text-xs text-right pr-4">
                    {label}
                  </div>
                  <div class="flex-1">
                    <%= if is_list(value) do %>
                      <%= for line <- value do %>
                        <div>{line}</div>
                      <% end %>
                    <% else %>
                      {value}
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
        <div class="ml-4">
          <h2 class="font-bold mt-6">Zgoda marketingowa</h2>
          <div class="flex items-center mt-6">
            <label
              for="consent"
              class="w-64 flex items-center justify-end font-medium text-darkGrey uppercase text-xs pr-4 text-right"
            >
              Zgoda na przesyłanie informacji o charakterze marketingowym
            </label>
            <div>
              <.input
                phx-click="update_marketing_consent"
                name="consent"
                id="consent"
                value={@current_user.marketing_consent}
                type="checkbox"
              />
            </div>
          </div>
        </div>
        <div class="ml-4">
          <h2 class="font-bold mt-6">Zamykanie konta</h2>
          <div class="flex items-center mt-6">
            <div class="w-64 flex items-center justify-end font-medium text-darkGrey uppercase text-xs pr-4">
              Nazwa konta
            </div>
            <div class="flex-1 flex flex-col">
              {@current_user.email}
            </div>
          </div>
          <div class="flex mt-4">
            <div class="w-64 flex items-center justify-end font-medium text-darkGrey uppercase text-xs pr-4">
            </div>
            <div class="flex-1">
              <.button phx-click={show_modal("confirm_modal")} variant="outline" color="red">
                Zamknij konto
              </.button>
              <.modal id="confirm_modal">
                <h3>Czy na pewno chcesz zamknąć konto? <b>Nie da się tego cofnąć!</b></h3>
                <.simple_form
                  for={@delete_account_form}
                  phx-submit="delete_account"
                  id="delete_account_form"
                >
                  <.input
                    field={@delete_account_form[:current_password]}
                    type="password"
                    label="Twoje hasło"
                    required
                  />
                  <:actions>
                    <div class="flex gap-4">
                      <.button variant="outline" color="red" phx-disable-with="Usuwam...">
                        Zamknij konto
                      </.button>
                      <.button type="button" phx-click={hide_modal("confirm_modal")}>
                        Anuluj
                      </.button>
                    </div>
                  </:actions>
                </.simple_form>
              </.modal>
            </div>
          </div>
        </div>
      </div>
    <% "konta_bankowe" -> %>
      <div class="mt-6 flex flex-col items-start">
        <div class="flex gap-1">
          <h2 class="font-bold mt-0.5">Konta bankowe</h2>
        </div>
        <%= if Enum.any?(@bank_accounts) do %>
          <div class="space-y-4 mt-10">
            <%= for {institution, accounts} <- Enum.group_by(@bank_accounts, & &1.institution_name) do %>
              <h3>{if(institution == "Manual", do: "wprowadzone ręcznie", else: institution)}</h3>

              <div class="flex flex-wrap items-start gap-4">
                <%= for account <- accounts do %>
                  <div class={[
                    "border border-greyButtonBg rounded-md p-4",
                    "relative grid grid-cols-[85px_1fr] gap-2",
                    "align-center justify-center w-[450px]"
                  ]}>
                    <%= for {label, value} <- [
                          {"Nazwa", account.name},
                          {"Waluta", account.currency},
                          {"Numer", account.iban}
                        ] do %>
                      <span class={[
                        "font-medium text-darkGrey uppercase",
                        "text-xs content-center"
                      ]}>
                        {label}
                      </span>
                      <%= if label == "Numer" do %>
                        <div class="flex items-center gap-2">
                          <span class="break-all">{value}</span>
                          <span
                            :if={@bank_account_statuses[account.id] == :connected}
                            class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-greenText"
                          >
                            <.icon name="hero-check-circle-solid" class="w-5 h-5 text-greenBg" />
                          </span>
                          <span
                            :if={@bank_account_statuses[account.id] in [:broken, :disconnected]}
                            class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-redBg"
                          >
                            <.icon name="hero-x-mark-solid" class="w-5 h-5 text-redText" />
                          </span>
                          <span
                            :if={@bank_account_statuses[account.id] == :processing}
                            class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-blueBg"
                          >
                            <.icon name="hero-ellipsis-horizontal" class="w-5 h-5 text-blueText" />
                          </span>
                        </div>
                      <% else %>
                        <div class={[
                          !value && "text-darkGrey/30"
                        ]}>
                          {if value do
                            value
                          else
                            "—"
                          end}
                        </div>
                      <% end %>
                    <% end %>
                    <button
                      :if={
                        @bank_account_statuses[account.id] == :broken or
                          @bank_account_statuses[account.id] == :disconnected
                      }
                      phx-click="reconnect_bank_account"
                      phx-value-account_id={account.id}
                      class={[
                        "bg-greyButtonBg text-greyButtonText uppercase w-full",
                        "hover:bg-white hover:text-black border border-greyButtonBg",
                        "transition-all transform ease-out duration-200",
                        "rounded-md text-xs h-8 flex items-center",
                        "justify-center gap-1 col-span-full mt-4"
                      ]}
                    >
                      <.icon name="hero-arrow-path" class="w-4 h-4 inline-block" /> Powiąż
                    </button>
                    <div
                      :if={account.is_default}
                      class="bg-orangeBg text-orangeText uppercase w-full rounded-md text-xs h-8 flex items-center justify-center col-span-full mt-4"
                    >
                      Domyślne dla
                      <span class="font-bold inline-block pl-1">{account.currency}</span>
                    </div>
                    <div class="absolute top-2 right-2">
                      <.dropdown id={account.id}>
                        <:trigger>
                          <.icon class="text-darkGrey" name="hero-ellipsis-horizontal" />
                        </:trigger>
                        <div class={[
                          "flex flex-col text-sm text-darkGrey gap-2",
                          "bg-lightGreyBg shadow-2xl w-44 font-semibold z-10 rounded",
                          "overflow-hidden border border-darkGrey/30"
                        ]}>
                          <button
                            phx-click={show_modal("rename_modal_#{account.id}")}
                            class={[
                              "transition px-4 py-2 text-left",
                              "hover:text-white",
                              "hover:bg-darkGrey phx-click-loading:opacity-50",
                              "phx-click-loading:cursor-wait"
                            ]}
                          >
                            Zmień nazwę
                          </button>
                          <button
                            :if={!is_nil(account.institution_id)}
                            phx-click="reconnect_bank_account"
                            phx-value-account_id={account.id}
                            class={[
                              "transition px-4 py-2 text-left",
                              "hover:text-white",
                              "hover:bg-darkGrey phx-click-loading:opacity-50",
                              "phx-click-loading:cursor-wait"
                            ]}
                          >
                            Połącz ponownie
                          </button>

                          <button
                            phx-click={show_modal("confirm_delete_bank_account_#{account.id}")}
                            class={[
                              "transition px-4 py-2 text-left",
                              "hover:text-white",
                              "hover:bg-darkGrey phx-click-loading:opacity-50",
                              "phx-click-loading:cursor-wait"
                            ]}
                          >
                            Usuń
                          </button>
                          <button
                            :if={!account.is_default}
                            phx-click="make_default_account"
                            phx-value-account_id={account.id}
                            class={[
                              "transition px-4 py-2 text-left",
                              "hover:text-white",
                              "hover:bg-darkGrey phx-click-loading:opacity-50",
                              "phx-click-loading:cursor-wait"
                            ]}
                          >
                            Domyślne dla {account.currency}
                          </button>
                        </div>
                      </.dropdown>
                    </div>
                  </div>
                  <.modal id={"rename_modal_#{account.id}"}>
                    <.form
                      for={%{}}
                      phx-submit="rename_bank_account"
                      id={"rename_form_#{account.id}"}
                    >
                      <.input name="name" label="Nowa nazwa" value={account.name} />
                      <input type="hidden" name="account_id" value={account.id} />
                      <div class="mt-4 flex gap-4">
                        <.button
                          type="submit"
                          phx-click={hide_modal("rename_modal_#{account.id}")}
                          phx-disable-with="Zapisywanie..."
                        >
                          Zapisz
                        </.button>
                        <.button
                          type="button"
                          phx-click={hide_modal("rename_modal_#{account.id}")}
                        >
                          Anuluj
                        </.button>
                      </div>
                    </.form>
                  </.modal>
                  <.modal id={"confirm_delete_bank_account_#{account.id}"}>
                    <h3 class="text-lg font-bold mb-4">Potwierdź usunięcie</h3>
                    <p class="mb-6">
                      Czy na pewno chcesz usunąć to konto bankowe?
                      Spowoduje to również usunięcie wszystkich powiązanych transakcji.
                    </p>
                    <div class="flex gap-4">
                      <.button
                        phx-click="delete_bank_account"
                        phx-value-account_id={account.id}
                        variant="outline"
                        color="red"
                        phx-disable-with="Usuwam..."
                        class="phx-click-loading:opacity-50 phx-click-loading:cursor-wait"
                      >
                        Usuń
                      </.button>
                      <.button
                        type="button"
                        phx-click={hide_modal("confirm_delete_bank_account_#{account.id}")}
                        class="phx-click-loading:opacity-50 phx-click-loading:cursor-wait"
                      >
                        Anuluj
                      </.button>
                    </div>
                  </.modal>
                <% end %>
              </div>
            <% end %>
          </div>
          <div class="ml-auto mt-16 flex gap-2">
            <.link
              navigate={~p"/ustawienia/bank/dodaj"}
              class={button_styles(%{variant: "outline"})}
            >
              Podepnij kolejne konto
            </.link>
            <.button variant="outline" phx-click={show_modal("manual_bank_account_modal")}>
              Dodaj konto ręcznie
            </.button>
          </div>
          <.modal
            id="manual_bank_account_modal"
            on_cancel={hide_modal("manual_bank_account_modal")}
          >
            <div class="flex flex-col gap-4">
              <h3 class="text-lg font-semibold">Dodaj konto bankowe ręcznie</h3>
              <p class="text-sm text-darkGrey">
                Ta funkcja pozwala dodać konto bez integracji z bankiem. Synchronizacja transakcji będzie wyłączona.
              </p>
              <.form
                for={%{}}
                phx-submit="create_manual_bank_account"
                id="manual_bank_account_form"
              >
                <.input name="name" label="Nazwa konta" value="" />
                <.input name="iban" label="IBAN" value="" />
                <.input name="currency" label="Waluta" value="" />
                <div class="mt-4 flex gap-4">
                  <.button
                    type="submit"
                    phx-click={hide_modal("manual_bank_account_modal")}
                    phx-disable-with="Dodawanie..."
                  >
                    Zapisz
                  </.button>
                  <.button type="button" phx-click={hide_modal("manual_bank_account_modal")}>
                    Anuluj
                  </.button>
                </div>
              </.form>
            </div>
          </.modal>
        <% else %>
          <div class="text-left py-6 text-darkGrey">
            <p>Nie masz jeszcze żadnych kont bankowych.</p>
            <p class="text-sm mt-2">
              Dodaj swoje pierwsze konto bankowe, aby móc wystawiać faktury.
            </p>
            <div class="mt-6">
              <.link
                navigate={~p"/ustawienia/bank/dodaj"}
                class={button_styles(%{variant: "outline"})}
              >
                Podepnij konto
              </.link>
            </div>
          </div>
        <% end %>
      </div>
  <% end %>
</div>
