<div class="container mt-16">
  <h1 class="text-2xl">Cześć!</h1>
  <p>{@current_user.email}</p>

  <div class="flex gap-10 font-semibold mt-16">
    <%= for {tab, label} <- [
      {"company", "Twoja firma"},
      {"account", "Twoje konto"},
      {"bank_accounts", "Konta bankowe"},
      {"address_book", "Książka adresowa"}
    ] do %>
      <.link
        patch={~p"/settings?tab=#{tab}"}
        class={
          classes([
            @tab == tab && "text-orangeText",
            "phx-click-loading:opacity-50"
          ])
        }
      >
        {label}
      </.link>
    <% end %>
  </div>
  <hr class="border-t border-t-greyButtonBg mt-4" />

  <%= case @tab do %>
    <% "company" -> %>
      <%= if @company_form[:is_basic_info_editing].value do %>
        <div class="mt-6">
          <div class="flex gap-1 bg-lightGreyBg p-4">
            <h2 class="font-bold mt-0.5">Dane firmy</h2>
            <.simple_form phx-submit="save" for={@company_form}>
              <.input
                field={@company_form[:organization_type]}
                label="Rodzaj działalności"
                class="font-normal"
              />
              <.input field={@company_form[:name]} label="Nazwa organizacji" class="font-normal" />
              <.input
                field={@company_form[:identification_number]}
                label="NIP"
                class="font-normal"
              />
              <.input
                field={@company_form[:address]}
                label="Adres przedsiębiorstwa"
                class="font-normal"
              />
              <.input
                field={@company_form[:phone_number]}
                label="Numer telefonu"
                class="font-normal"
              />
              <.input type="hidden" field={@company_form[:is_basic_info_editing]} value="false" />

              <:actions>
                <.button type="submit" phx-disable-with="Zapisywanie...">
                  Zapisz
                </.button>
                <.button
                  type="button"
                  phx-click={
                    JS.push("save",
                      value: %{
                        organization: %{
                          is_basic_info_editing: false
                        }
                      }
                    )
                  }
                  phx-disable-with="Anulowanie..."
                  class="ml-2"
                >
                  Anuluj
                </.button>
              </:actions>
            </.simple_form>
          </div>
        </div>
      <% else %>
        <div class="mt-6">
          <div class="flex gap-1">
            <h2 class="font-bold mt-0.5">Dane firmy</h2>
            <.form for={@company_form} phx-submit="save">
              <.input type="hidden" field={@company_form[:is_basic_info_editing]} value="true" />
              <.edit_button />
            </.form>
          </div>
          <div class="space-y-4 mt-6">
            <%= for {label, value} <- [
              {"Rodzaj działalności", @current_org.organization_type},
              {"Nazwa organizacji", @current_org.name},
              {"NIP", @current_org.identification_number},
              {"Adres przedsiębiorstwa", @current_org.address},
              {"Numer telefonu", @current_org.phone_number}
            ], value do %>
              <div class="flex">
                <div class="w-64 mt-1 font-medium text-darkGrey uppercase text-xs text-right pr-4">
                  {label}
                </div>
                <div class="flex-1">
                  <%= if is_list(value) do %>
                    <%= for line <- value do %>
                      <div>{line}</div>
                    <% end %>
                  <% else %>
                    {value}
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%= if @correspondence_form[:is_correspondence_editing].value do %>
        <div class="mt-6">
          <div class="flex gap-1 bg-lightGreyBg p-4">
            <h2 class="font-bold mt-0.5">Adres korespondencyjny</h2>
            <.simple_form phx-submit="save" for={@correspondence_form}>
              <.input
                field={@correspondence_form[:correspondence_name]}
                label="Nazwa do korespondencji"
                class="font-normal"
              />
              <.input
                field={@correspondence_form[:correspondence_address]}
                label="Adres do korespondencji"
                class="font-normal"
              />
              <.input
                type="hidden"
                field={@correspondence_form[:is_correspondence_editing]}
                value="false"
              />

              <:actions>
                <.button type="submit" phx-disable-with="Zapisywanie...">
                  Zapisz
                </.button>
                <.button
                  type="button"
                  phx-click={
                    JS.push("save",
                      value: %{
                        organization: %{
                          is_correspondence_editing: false
                        }
                      }
                    )
                  }
                  phx-disable-with="Anulowanie..."
                  class="ml-2"
                >
                  Anuluj
                </.button>
              </:actions>
            </.simple_form>
          </div>
        </div>
      <% else %>
        <div class="mt-6">
          <div class="flex gap-1">
            <h2 class="font-bold mt-0.5">Adres korespondencyjny</h2>
            <.form for={@correspondence_form} phx-submit="save">
              <.input
                type="hidden"
                field={@correspondence_form[:is_correspondence_editing]}
                value="true"
              />
              <.edit_button />
            </.form>
          </div>
          <div class="space-y-4 mt-6">
            <%= for {label, value} <- [
              {"Nazwa do korespondencji", @current_org.correspondence_name},
              {"Adres do korespondencji", @current_org.correspondence_address}
            ], value do %>
              <div class="flex">
                <div class="w-64 mt-1 font-medium text-darkGrey uppercase text-xs text-right pr-4">
                  {label}
                </div>
                <div class="flex-1">
                  <%= if is_list(value) do %>
                    <%= for line <- value do %>
                      <div>{line}</div>
                    <% end %>
                  <% else %>
                    {value}
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% "account" -> %>
      <div class="mt-6">
        <div class="flex gap-4">
          <h2 class="font-bold">Dane dostępowe</h2>
          <.link class="text-sm mt-0.5 hover:underline" navigate={~p"/users/settings"}>
            Edytuj
          </.link>
        </div>
        <div class="space-y-4 mt-6">
          <div class="flex">
            <div class="w-64 mt-1 font-medium text-darkGrey uppercase text-xs text-right pr-4">
              Email
            </div>
            <div class="flex-1">
              {@current_user.email}
            </div>
          </div>
          <div class="flex">
            <div class="w-64 mt-1 font-medium text-darkGrey uppercase text-xs text-right pr-4">
              Hasło
            </div>
            <div class="flex-1">
              **************
            </div>
          </div>
        </div>
        <h2 class="font-bold mt-6">Zgoda marketingowa</h2>
        <div class="flex items-center mt-6">
          <label
            for="marketing"
            class="w-64 mt-1 font-medium text-darkGrey uppercase text-xs text-right pr-4"
          >
            Zgoda na przesyłanie informacji o charakterze marketingowym
          </label>
          <div>
            <.input type="checkbox" id="marketing" name="marketing" />
          </div>
        </div>
        <h2 class="font-bold mt-6">Zamykanie konta</h2>
        <div class="flex items-center mt-6">
          <div class="w-64 mt-1 font-medium text-darkGrey uppercase text-xs text-right pr-4">
            Nazwa konta
          </div>
          <div class="flex-1 flex flex-col">
            {@current_user.email}
          </div>
        </div>
        <div class="flex mt-4">
          <div class="w-64 mt-1 font-medium text-darkGrey uppercase text-xs text-right pr-4">
          </div>
          <div class="flex-1">
            <.button phx-click={show_modal("confirm_modal")} variant="outline" color="red">
              Zamknij konto
            </.button>
            <.modal id="confirm_modal">
              <h3>Czy na pewno chcesz zamknąć konto? <b>Nie da się tego cofnąć!</b></h3>
              <.simple_form
                for={@delete_account_form}
                phx-submit="delete_account"
                id="delete_account_form"
              >
                <.input
                  field={@delete_account_form[:current_password]}
                  type="password"
                  label="Twoje hasło"
                  required
                />
                <:actions>
                  <div class="flex gap-4">
                    <.button variant="outline" color="red" phx-disable-with="Usuwam...">
                      Zamknij konto
                    </.button>
                    <.button type="button" phx-click={hide_modal("confirm_modal")}>
                      Anuluj
                    </.button>
                  </div>
                </:actions>
              </.simple_form>
            </.modal>
          </div>
        </div>
      </div>
    <% "bank_accounts" -> %>
      <div class="mt-6">
        <div class="flex gap-1">
          <h2 class="font-bold mt-0.5">Konta bankowe</h2>
        </div>
        <div class="space-y-4 mt-6">
          <%= for {institution, accounts} <- Enum.group_by(@bank_accounts, & &1.institution_name) do %>
            <h3>{institution}</h3>
            <div class="flex flex-wrap gap-4">
              <%= for account <- accounts do %>
                <div class="flex justify-between border rounded-md p-4 w-96">
                  <div class="grid grid-cols-[auto,1fr] gap-4">
                    <div class="mt-1 font-medium text-darkGrey uppercase text-xs pr-4">
                      Nazwa
                    </div>
                    <div>
                      {account.name}
                    </div>
                    <div class="mt-1 font-medium text-darkGrey uppercase text-xs pr-4">
                      Waluta
                    </div>
                    <div>
                      {account.currency}
                    </div>
                    <div class="mt-1 font-medium text-darkGrey uppercase text-xs text-left pr-4">
                      Numer
                    </div>
                    <div>
                      {account.iban}
                    </div>
                  </div>
                  <div>
                    <.icon name="hero-ellipsis-horizontal" />
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% "address_book" -> %>
      <div class="mt-6">
        <h2 class="font-bold">Książka adresowa</h2>
        <p class="mt-4">Ta funkcja nie jest jeszcze dostępna.</p>
      </div>
  <% end %>
</div>
