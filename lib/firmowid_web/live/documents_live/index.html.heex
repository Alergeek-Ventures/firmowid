<div class="mt-16 mb-16 flex flex-col justify-center items-center gap-16
  text-center md:hidden">
  <.icon name="hero-document-magnifying-glass-solid" class="w-16 h-16" />
  <div class="flex flex-col gap-4">
    <p class="font-bold">Podgląd dokumentów nie jest aktualnie dostępny na urządzeniu mobilnym</p>
    <p>Zeskanuj dokument naciskając przycisk poniżej, a będzie on dostępny na
      komputerze.</p>
  </div>
</div>

<div class="flex max-md:justify-center justify-between pb-8">
  <input
    class="block w-44 border border-darkGrey rounded-lg py-1 px-3 max-md:hidden"
    type="button"
    id="month"
    phx-hook="AirDatepicker"
    data-initial-date={@month}
  />
  <div phx-drop-target={@uploads.file.ref} class="flex flex-row gap-4">
    <%= if @invoice_matchers != [] do %>
      <a
        id="download-button"
        data-tippy-content="Pobierz wszystkie faktury wystawione w tym miesiącu"
        phx-hook="tippy"
        href={"/file?month=#{@month}"}
        download
        class="relative flex flex-row gap-4 items-center justify-center
        border rounded-lg px-3 py-2 max-md:hidden hover:bg-greyButtonBg
        transition-colors"
      >
        <.icon name="hero-cloud-arrow-down" class="w-6 h-6" />
        <span class="max-lg:hidden">
          Pobierz
        </span>
      </a>
    <% end %>
    <.link
      navigate={~p"/sales_invoices"}
      id="sales-invoice-link"
      data-tippy-content="Wystaw fakturę sprzedażową"
      phx-hook="tippy"
      class="
      relative flex flex-row gap-4 items-center justify-center
      border rounded-lg px-3 py-2 max-md:hidden hover:bg-greyButtonBg
      transition-colors
      "
    >
      <.icon name="hero-document-duplicate" class="w-5 h-5" />
      <span class="max-lg:hidden">
        Wystaw fakturę
      </span>
    </.link>
    <form id="upload-form" phx-change="upload" phx-submit="upload">
      <div class="hidden">
        <.live_file_input upload={@uploads.file} />
      </div>
      <label
        for={@uploads.file.ref}
        class={button_styles(%{class: "relative flex flex-row gap-2 items-center justify-center
        border-2 rounded-lg px-3 py-2 border-black hover:bg-greyButtonBg
        hover:text-black transition-colors max-md:h-20 max-md:w-60 max-md:gap-4"})}
      >
        <%= if @currently_uploading_count > 0 or @processing_blobs_count > 0 do %>
          <span
            id="upload-count-indicator"
            phx-hook="tippy"
            data-tippy-content="Pliki są przetwarzane i za kilka chwil będą dostępne w Firmowidzie"
            class="absolute overflow-hidden flex items-center justify-center -top-3 -right-3 h-7 w-7 bg-black rounded-full"
          >
            <span class="absolute animate-spin bg-gradient-to-r from-[#727272] to-black block w-full h-full" />
            <span class="bg-black flex items-center justify-center w-6 h-6 z-10 rounded-full">
              <%= if @currently_uploading_count > 0 do %>
                <.icon name="hero-arrow-up-circle-solid" class="text-white leading-none w-6 h-6" />
              <% else %>
                <%= case @processing_blobs_count do %>
                  <% 1 -> %>
                    <.icon
                      name="hero-arrow-up-circle-solid"
                      class="text-white leading-none w-6 h-6"
                    />
                  <% 0 -> %>
                  <% _ -> %>
                    <span>{@processing_blobs_count}</span>
                <% end %>
              <% end %>
            </span>
          </span>
        <% end %>
        <.icon name="hero-plus-mini" class="w-5 h-5" /> Dodaj dokument
      </label>
    </form>
  </div>
</div>

<div class="flex flex-row gap-4 max-md:hidden">
  <%= for {filter, label} <- [
        {:invoices, "Faktury"},
        {:transactions, "Transakcje"},
        {:unmatched, "Bez dopasowania"},
        {:all, "Wszystkie"}
    ] do %>
    <.button
      class={[
        @filter == filter && "!bg-darkGrey !text-white",
        "text-darkGrey text-center bg-lightGreyBg rounded-lg border-none
        hover:bg-greyButtonBg py-2 px-3 text-sm font-semibold leading-6
        active:text-white/80 flex items-center justify-center"
      ]}
      phx-click="filter-change"
      phx-value-filter={filter}
    >
      {label}
    </.button>
  <% end %>
</div>

<div class="mt-2 flex flex-col gap-4 max-md:hidden">
  <FirmowidWeb.DocumentsLive.DocumentsTable.table
    invoice_matchers={@invoice_matchers}
    has_connected_bank_account={@has_connected_bank_account}
  />
</div>

<div
  id="file-drop-overlay"
  class="fixed top-[10lvw] left-[5lvw] w-[90lvw] h-[80lvh] bg-[#CEE6E666]
  rounded-lg items-center justify-center z-50 bg-opacity-50 opacity-0
  transition-opacity flex hidden"
  phx-hook="FileUploadDragNDrop"
  phx-drop-target={@uploads.file.ref}
>
  <div class="absolute top-0 left-0 border-2 border-blueBg rounded-lg w-full
    h-full opacity-100" />
  <div class="flex flex-col items-center justify-center gap-8 bg-blueText
    text-white
    p-4 py-8 rounded-xl">
    <.icon name="hero-cloud-arrow-up" class="w-16 h-16" />
    <p class="text-xl opacity-100 text-center max-w-[25lvw]">
      Przeciągnij faktury, aby załadować je do Firmowida.
    </p>
    <p class="text-sm opacity-80 text-center max-w-[25lvw]">
      (max 50 plików, PDF, JPG oraz PNG)
    </p>
  </div>
</div>
