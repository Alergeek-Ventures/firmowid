<div class="mt-16 mb-16 flex flex-col justify-center items-center gap-16
  text-center md:hidden">
  <.icon name="hero-document-magnifying-glass-solid" class="w-16 h-16" />
  <div class="flex flex-col gap-4">
    <p class="font-bold">Podgląd dokumentów nie jest aktualnie dostępny na urządzeniu mobilnym</p>
    <p>Zeskanuj dokument naciskając przycisk poniżej, a będzie on dostępny na
      komputerze.</p>
  </div>
</div>

<div class="w-full flex items-start max-md:justify-center justify-between pb-8">
  <div class="flex flex-col gap-4 flex-grow max-w-xl items-start justify-center max-md:hidden">
    <input
      class="w-52 h-10 border border-darkGrey rounded-lg"
      type="button"
      id="month"
      phx-hook="AirDatepicker"
      data-initial-date={@month}
    />
  </div>
  <div phx-drop-target={@uploads.file.ref} class="flex flex-row gap-4">
    <%= if @invoice_matchers != [] do %>
      <a
        id="download-button"
        data-tippy-content="Pobierz wszystkie faktury wystawione w tym miesiącu"
        phx-hook="tippy"
        href={"/file?month=#{@month}"}
        download
        class="relative flex flex-row gap-4 items-center justify-center w-full
        border rounded-lg px-3 py-2 max-md:hidden min-h-[40px] hover:bg-greyButtonBg
        transition-colors"
      >
        <.icon name="hero-cloud-arrow-down" class="w-6 h-6" /> Pobierz
      </a>
    <% end %>
    <.link
      navigate={~p"/invoices"}
      class="min-w-[200px]
      relative flex flex-row gap-4 items-center justify-center w-full
      border rounded-lg px-3 py-2 max-md:hidden min-h-[40px] hover:bg-greyButtonBg
      transition-colors
      "
    >
      <.icon name="hero-document-duplicate" class="w-5 h-5" /> Wystaw fakturę
    </.link>
    <form id="upload-form" phx-change="upload" phx-submit="upload">
      <div class="hidden">
        <.live_file_input upload={@uploads.file} />
      </div>
      <label
        for={@uploads.file.ref}
        class={
          button_styles(%{class: "relative flex flex-row gap-4 items-center justify-center w-full
        border-2 rounded-lg px-3 py-2 min-w-[210px] border-black
        max-md:w-[300px] min-h-[40px] max-md:min-h-[60px] hover:bg-greyButtonBg
        hover:text-black transition-colors"})
        }
      >
        <%= if length(Enum.filter(@uploads.file.entries, & !&1.done?)) + length(@documents_pending_extraction) > 0 do %>
          <span class="absolute -top-2 -right-2 h-6 w-6 rounded-full bg-blueBg
          text-blueText flex justify-center items-center items animate-bounce">
            <span>
              {length(Enum.filter(@uploads.file.entries, &(!&1.done?))) +
                length(@documents_pending_extraction)}
            </span>
          </span>
        <% end %>
        <.icon name="hero-plus" class="w-6 h-6" /> Dodaj dokument
      </label>
    </form>
  </div>
</div>

<div class="flex flex-row gap-4">
  <%= for {filter, label} <- [
        {:all, "Wszystkie"},
        {:unmatched, "Bez dopasowania"},
        {:invoices, "Faktury"},
        {:transactions, "Transakcje"}
    ] do %>
    <.button
      class={[
        @filter == filter && "!bg-darkGrey !text-white",
        "text-darkGrey text-center bg-lightGreyBg rounded-lg border-none
        hover:bg-greyButtonBg py-2 px-3 text-sm font-semibold leading-6
        active:text-white/80 flex items-center justify-center"
      ]}
      phx-click="filter-change"
      phx-value-filter={filter}
    >
      {label}
    </.button>
  <% end %>
</div>

<div class="mt-2 flex flex-col gap-4 max-md:hidden">
  <FirmowidWeb.DocumentsLive.DocumentsTable.table
    invoice_matchers={@invoice_matchers}
    has_connected_bank_account={@has_connected_bank_account}
  />
</div>

<div
  id="file-drop-overlay"
  class="fixed top-[10lvw] left-[5lvw] w-[90lvw] h-[80lvh] bg-[#CEE6E666]
  rounded-lg items-center justify-center z-50 bg-opacity-50 opacity-0
  transition-opacity flex hidden"
  phx-hook="FileUploadDragNDrop"
  phx-drop-target={@uploads.file.ref}
>
  <div class="absolute top-0 left-0 border-2 border-blueBg rounded-lg w-full
    h-full opacity-100" />
  <div class="flex flex-col items-center justify-center gap-8 bg-blueText
    text-white
    p-4 py-8 rounded-xl">
    <.icon name="hero-cloud-arrow-up" class="w-16 h-16" />
    <p class="text-xl opacity-100 text-center max-w-[25lvw]">
      Przeciągnij pliki, aby wgrać je do zakładki Dokumenty
    </p>
  </div>
</div>
