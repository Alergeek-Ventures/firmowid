<div class="w-full flex items-end justify-between pb-8">
  <.simple_form phx-change="change-date" phx-submit="change-date" for={@date_range_form}>
    <div class="flex flex-row gap-4 items-center">
      <.input type="date" label="Od" field={@date_range_form["from"]} />
      <.input type="date" label="Do" field={@date_range_form["to"]} />
    </div>
  </.simple_form>
  <div phx-drop-target={@uploads.file.ref}>
    <form id="upload-form" phx-change="upload" phx-submit="upload">
      <div class="hidden">
        <.live_file_input upload={@uploads.file} />
      </div>
      <label
        for={@uploads.file.ref}
        class="relative flex flex-row gap-4 items-center justify-center w-full border-2
      border-gray-300 border-dashed rounded-lg cursor-pointer bg-gray-50
      hover:bg-gray-200 px-3 py-2"
      >
        <%= if length(@documents_pending_extraction) > 0 do %>
          <span class="absolute -top-2 -right-2 h-6 w-6 rounded-full bg-blueBg
          text-blueText flex justify-center items-center items animate-bounce">
            <span><%= length(@documents_pending_extraction) %></span>
          </span>
        <% end %>
        <.icon name="hero-document" class="w-6 h-6" /> Dodaj dokument
        (lub przeciągnij tutaj, aby załadować)
      </label>
    </form>
  </div>
</div>

<div class="mt-2 flex flex-col gap-4">
  <FirmowidWeb.DocumentsLive.DocumentsTable.table invoice_matchers={@invoice_matchers} />
</div>

<div
  id="file-drop-overlay"
  class="fixed top-[10lvw] left-[5lvw] w-[90lvw] h-[80lvh] bg-[#CEE6E666]
  rounded-lg items-center justify-center z-50 bg-opacity-50 opacity-0
  transition-opacity flex hidden"
  phx-hook="FileUploadDragNDrop"
  phx-drop-target={@uploads.file.ref}
>
  <div class="absolute top-0 left-0 border-2 border-blueBg rounded-lg w-full
    h-full opacity-100" />
  <div class="flex flex-col items-center justify-center gap-8 bg-blueText
    text-white
    p-4 py-8 rounded-xl">
    <.icon name="hero-cloud-arrow-up" class="w-16 h-16" />
    <p class="text-xl opacity-100 text-center max-w-[25lvw]">
      Przeciągnij pliki, aby wgrać je do zakładki Dokumenty
    </p>
  </div>
</div>
