<.header>
  Lista połączeń z bankiem
</.header>

<div class="flex flex-row justify-end gap-4 p-4 w-full">
  <.link class="underline font-bold" navigate={~p"/settings/bank-sync/create"}>
    Dodaj konto bankowe
  </.link>
</div>

<div class="flex flex-row gap-4 p-4 w-full">
  <.table id="bank-accounts" rows={@bank_accounts}>
    <:col :let={bank_account} label="Stan">
      <div class="flex justify-center items-center max-w-[30px]">
        <%= if is_nil(bank_account.gocardless_id) do %>
          <.icon name="hero-x-circle-solid" class="h-5 w-5 text-redText" />
        <% else %>
          <.icon name="hero-check-circle-solid" class="h-5 w-5 text-greenText" />
        <% end %>
      </div>
    </:col>
    <:col :let={bank_account} label="Nr konta">
      <span class="text-xl">{bank_account.iban}</span>
    </:col>
    <:col :let={_bank_account} label="Waluta">
      🇵🇱 PLN
    </:col>
    <:action :let={bank_account}>
      <div class="flex flex-row gap-2">
        <.button
          phx-click="sync"
          class="min-w-[140px] bg-white text-black border-none phx-click-loading:opacity-50 phx-click-loading:cursor-disabled"
          phx-value-bank-account-id={bank_account.id}
          disabled={is_nil(bank_account.gocardless_id)}
        >
          Synchronizuj
          <.icon name="hero-arrow-path-solid" class="w-4 h-4 phx-click-loading:animate-spin" />
        </.button>
      </div>
    </:action>
  </.table>
</div>
