<div class="container p-6">
  <div class="flex justify-between">
    <.back navigate={~p"/czasosledz/"} class="my-auto" icon_only />
    <.month_picker
      id="selected_date"
      active_months={@active_months}
      selected_date={@selected_date}
      data-position="bottom right"
    />
  </div>

  <div class="mt-8 flex flex-col justify-between gap-20 md:flex-row">
    <div class="col-span-4 w-full space-y-2">
      <%= for project <- @projects do %>
        <div class="flex flex-col divide-y divide-grey-200 rounded-md bg-grey-50 px-4">
          <FirmowidUI.Components.Button.button
            phx-click="toggle-project"
            type="button"
            phx-value-id={project.id}
            disabled={project.duration == 0}
            variant="unstyled"
            class="flex w-full items-center gap-6 py-5 text-left disabled:cursor-not-allowed disabled:opacity-50"
          >
            <span class="mr-auto">{project.name}</span>
            <span>{TimeFormatter.format_duration(project.duration)}</span>
            <span class="inline-flex items-center justify-center">
              <.icon :if={project.expanded} name="hero-chevron-up-mini" class="text-grey-700" />
              <.icon :if={!project.expanded} name="hero-chevron-down-mini" class="text-grey-700" />
            </span>
          </FirmowidUI.Components.Button.button>

          <div :if={project.expanded} class="space-y-4 py-4 pr-11">
            <div :for={session <- project.sessions} class="flex justify-between text-sm">
              <span>{session.title}</span>
              <span>{TimeFormatter.format_duration(session.duration)}</span>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="flex w-full max-w-[360px] flex-col gap-6">
      <div class="flex flex-col space-y-8 rounded-sm bg-grey-50 p-4">
        <h3 class="font-bold">Podsumowanie:</h3>
        <div>
          <p class="mb-3">Przepracowane godziny:</p>
          <p class="text-xl font-bold">{TimeFormatter.format_duration(@total_duration)}</p>
          <p class="text-sm text-grey-700">
            {TimeFormatter.format_duration(@total_duration, :with_days)}
          </p>
        </div>
        <div :if={most_demanding = Enum.max_by(@projects, & &1.duration, fn -> nil end)}>
          <p class="mb-3">Najbardziej wymagający projekt:</p>
          <p class="text-xl font-bold">
            {TimeFormatter.format_duration(most_demanding.duration)}
          </p>
          <p class="text-sm text-grey-700">{most_demanding.name}</p>
        </div>
      </div>
      <div
        :if={@current_hours_record || @total_duration > 3599}
        id="hours-record-submission-card"
        class="flex flex-col gap-6 rounded-md bg-grey-50 p-4"
      >
        <div class="flex items-center justify-between gap-2 bg-grey-50">
          <span class="font-bold">Ewidencja godzin</span>

          <%= if @current_hours_record do %>
            <.badge tone="success">WYSŁANO <.icon name="hero-check-micro" /></.badge>
          <% else %>
            <.badge>BRAK <.icon name="hero-x-mark-micro" /></.badge>
          <% end %>
        </div>
        <p :if={!@can_use_hours_records} class="mt-2 text-sm">
          Aby wypełnić ewidencję godzin musisz ustawić imię i nazwisko oraz datę zatrudnienia w
          <.link
            kind="unstyled"
            navigate={~p"/ustawienia"}
            class="text-rust-700 hover:underline"
          >
            Ustawieniach
          </.link>
        </p>
        <.live_component
          :if={!@current_hours_record && @can_use_hours_records}
          module={FirmowidWeb.HoursRecord.Components.UploadForm}
          id={"upload_form-#{Date.to_iso8601(@selected_date)}"}
          selected_date={@selected_date}
          current_user={@current_user}
          total_duration={@total_duration}
          ash_scope={@ash_scope}
        />
      </div>
      <div
        :if={@current_hours_record && is_nil(@current_hours_record.change_requested_at)}
        id="hours-record-change-card"
        class="rounded-md bg-grey-50"
      >
        <.button
          id="hours-record-request-change"
          type="button"
          variant="unstyled"
          class="block w-full cursor-pointer rounded-md p-4 text-center focus-visible:outline-2 focus-visible:outline-rust-500 active:bg-grey-200"
          phx-click={show_modal("hours-record-change-request")}
        >
          {gettext("Request correction or cancellation")}
        </.button>
      </div>
      <div
        :for={record <- @change_requests}
        class="rounded-md border border-rust-700 bg-grey-50 p-4"
      >
        <.change_request record={record} />
      </div>
      <div :if={@previous_hours_records != []} class="rounded-md bg-grey-50 p-4">
        <.submission_history records={@previous_hours_records} user={@current_user} />
      </div>
      <p :if={!@current_hours_record && @total_duration <= 3599} class="mt-2 text-center text-sm">
        Aby wypełnić ewidencję godzin musisz dodać przynajmniej jedną godzinę pracy
      </p>
    </div>
  </div>
  <.modal :if={@current_hours_record} id="hours-record-change-request">
    <.form
      for={@change_request_form}
      id="hours-record-change-request-form"
      phx-submit="request-change"
      class="flex flex-col gap-6"
    >
      <h2 id="hours-record-change-request-title" class="font-bold">
        {gettext("Request correction or cancellation")}
      </h2>
      <p id="hours-record-change-request-description">
        {gettext(
          "Your request will be saved and emailed to your organization administrators. It does not cancel the signature or unlock hours automatically."
        )}
      </p>
      <.input
        field={@change_request_form[:change_request_kind]}
        type="select"
        label={gettext("Request type")}
        options={[
          {gettext("Correction"), "correction"},
          {gettext("Cancellation"), "cancellation"}
        ]}
        required
      />
      <.input
        field={@change_request_form[:change_request_reason]}
        type="textarea"
        label={gettext("Reason")}
        required
        maxlength="2000"
      />
      <p :if={@change_request_error} role="alert">{@change_request_error}</p>
      <div class="flex flex-wrap justify-end gap-3">
        <.button
          type="button"
          variant="outline"
          phx-click={hide_modal("hours-record-change-request")}
        >
          {gettext("Cancel")}
        </.button>
        <.button phx-disable-with={gettext("Submitting...")}>
          {gettext("Submit request")}
        </.button>
      </div>
    </.form>
  </.modal>
</div>
