<%!-- On phones the header holds the date alone and scrolls away with the page, so the day headers stick right below the top bar. --%>
<div class="mx-auto w-full max-w-6xl max-md:[--page-header-height:0px] lg:px-4 lg:pt-2">
  <%!-- The Firmowid figure at 5% as in Figma: 613 px wide, 155 px left of the content (under the sidebar) and 238 px from the top. --%>
  <img
    src={~p"/images/figurine.png"}
    alt=""
    class="pointer-events-none fixed top-[20%] left-0 z-0 hidden opacity-5 lg:top-[238px] lg:left-[calc(16rem-155px)] lg:block lg:w-[613px] lg:in-data-[sidebar=collapsed]:left-[calc(3.5rem-155px)]"
  />

  <div class="sticky top-navbar z-40 flex items-center justify-between gap-4 bg-white py-4 max-md:static max-md:-mt-4 max-md:pb-2">
    <div class="flex shrink-0 items-center gap-2 max-md:min-w-0 max-md:shrink">
      <.figma_icon name="calendar" class="size-5" />
      <p class="line-clamp-1 font-medium text-grey-900 max-md:line-clamp-2 max-md:leading-[1.4]">
        {format_current_day_header(Date.utc_today())}
      </p>
    </div>

    <%!-- Says what the timesheet holds for the month it opens: the filtered month, or the current one.
    On phones it moves to the bar at the bottom. --%>
    <.link
      id="timesheet-link"
      navigate={Navigation.hours_record_index_path(@timesheet_month.date)}
      kind="button"
      variant="outline"
      class="gap-2! rounded bg-white px-2.5! leading-[normal]! hover:bg-grey-50! active:bg-grey-100! max-md:hidden!"
    >
      <span class="flex items-center gap-1.5">
        <.timesheet_icon />
        <span class="text-grey-600 max-sm:hidden">{String.capitalize(
          month_name(@timesheet_month.date)
        )}</span>
        <span class="text-grey-900 max-sm:hidden">{@timesheet_month.duration}</span>
      </span>
      <span class="h-5 w-px bg-grey-200 max-sm:hidden" aria-hidden="true" />
      <span class="text-grey-900">{pgettext("timesheet link", "Timesheet")}</span>
    </.link>
  </div>

  <div class="relative z-30 mbs-4 flex w-full flex-col justify-between gap-10 max-md:gap-0 md:flex-row lg:mbs-6 lg:gap-14">
    <div class="mx-auto w-full max-w-md md:mx-0 md:max-w-100">
      <%= if Enum.empty?(@active_projects) do %>
        <div class="w-full py-8 text-center text-grey-700">
          <p class="text-lg font-semibold">{gettext("You have no assigned projects")}</p>
          <%= if @current_user.member.role == :admin do %>
            <p class="mt-2 text-sm">
              {gettext("Add your first project and assign yourself to it to start tracking time")}
            </p>
            <.link
              kind="unstyled"
              navigate={~p"/zarzadzanie/projekty"}
              class="mt-4 inline-block text-rust-700 hover:underline"
            >
              {gettext("Go to project management")}
            </.link>
          <% else %>
            <p class="mt-2 text-sm">
              {gettext("Ask an administrator to assign you to a project")}
            </p>
          <% end %>
        </div>
      <% else %>
        <.form
          id="session_form"
          phx-change={if @current_session, do: "validate_and_update", else: "validate"}
          phx-submit={
            cond do
              @current_session && @is_form_extended -> "save_current_session"
              @current_session -> "end_session"
              true -> "save"
            end
          }
          for={@form}
          class="sticky top-[calc(var(--spacing-navbar)+var(--page-header-height))] z-40 flex w-full flex-col"
        >
          <div class="flex flex-col gap-4">
            <% is_hours_record_submitted = @is_hours_record_submitted %>

            <.input
              field={@form[:title]}
              required={true}
              placeholder={
                if not is_hours_record_submitted,
                  do: gettext("What are you working on?"),
                  else: gettext("You cannot add a session after the timesheet has been submitted")
              }
              input_class="rounded! text-base/[1.35]! text-black! focus:border-grey-500! focus-visible:outline-none max-md:h-11!"
              phx-hook="FocusOnMount"
              phx-debounce="300"
            />

            <%!-- The same dropdown as in the session rows instead of a native select, which
            opens over the chosen option; this list always opens below, as wide as the field. --%>
            <% project_field = @form[:project_id] %>
            <% project_list_id = "session-form-project-list" %>
            <% chosen_project = Enum.find(@active_projects, &(&1.id == project_field.value)) %>
            <div class="relative" phx-click-away={JS.hide(to: "##{project_list_id}")}>
              <input
                type="hidden"
                id={project_field.id}
                name={project_field.name}
                value={project_field.value}
              />
              <.button
                id="session-form-project"
                type="button"
                variant="unstyled"
                disabled={is_hours_record_submitted}
                aria-haspopup="listbox"
                phx-click={
                  JS.toggle(to: "##{project_list_id}", display: "flex")
                  |> JS.focus_first(to: "##{project_list_id}")
                }
                class={[
                  "flex w-full cursor-pointer items-center gap-2.5 rounded border border-grey-200 bg-grey-50 px-3 py-1.5 text-left text-base/[1.35] focus:border-grey-700 focus:outline-hidden disabled:cursor-default disabled:text-grey-300 max-md:h-11",
                  if(chosen_project, do: "text-black", else: "text-grey-500")
                ]}
              >
                <span class="min-w-0 flex-1 truncate">
                  {if chosen_project, do: chosen_project.name, else: gettext("Choose a project")}
                </span>
                <.figma_icon name="chevron_down" class="size-4 text-grey-700" />
              </.button>
              <ul
                id={project_list_id}
                role="listbox"
                aria-label={gettext("Project")}
                phx-hook="ListboxKeys"
                class={[
                  "absolute inset-x-0 top-full z-50 mt-1 hidden max-h-80 origin-top flex-col overflow-auto",
                  dropdown_panel_styles()
                ]}
              >
                <li :for={project <- @active_projects} role="none">
                  <%!-- Buttons, so Tab reaches each option and Enter or Space picks it; LiveView
                  reads Escape on the focused element only, so each option closes the list. --%>
                  <.dropdown_option
                    selected={project.id == project_field.value}
                    phx-keydown={
                      JS.hide(to: "##{project_list_id}") |> JS.focus(to: "#session-form-project")
                    }
                    phx-key="escape"
                    phx-click={
                      JS.set_attribute({"value", project.id}, to: "##{project_field.id}")
                      |> JS.dispatch("input", to: "##{project_field.id}")
                      |> JS.hide(to: "##{project_list_id}")
                      |> JS.focus(to: "#session-form-project")
                    }
                  >
                    {project.name}
                  </.dropdown_option>
                </li>
              </ul>
            </div>

            <div class="flex items-center justify-between">
              <.switch
                field={@form[:is_remote]}
                label={gettext("I work from home")}
                color="black"
                class="gap-2.5! text-sm font-normal max-md:gap-3! [&>span]:text-grey-700!"
                disabled={is_hours_record_submitted}
              />

              <.button
                type="button"
                id="toggle_extended_form"
                variant="tertiary"
                size="small"
                class="rounded! aria-pressed:bg-grey-400 max-md:size-11"
                phx-click="toggle_extended_form"
                data-active={@is_form_extended}
                disabled={is_hours_record_submitted}
                aria-label={gettext("Enter time manually")}
                aria-pressed={to_string(@is_form_extended)}
              >
                <.figma_icon name="edit" class="max-md:size-5!" />
              </.button>
            </div>

            <p :for={{error, _} <- Keyword.get_values(@form.errors, :base)}>{error}</p>

            <%!-- Figma "Edycja bieżącej sesji": the running session's date and times, with a
            hint below that a problem with them replaces, in brick, and marks its field. --%>
            <div
              :if={@is_form_extended and @current_session}
              id="current-session-times"
              phx-mounted={list_enter()}
              class="flex flex-col gap-2"
            >
              <div class="flex w-full gap-2">
                <div class="flex w-40 shrink-0 flex-col gap-1">
                  <label for={@form[:date].id} class="text-xs/[1.4] font-medium text-grey-500">
                    {gettext("Date")}
                  </label>
                  <FirmowidWeb.Timetracker.Components.Session.date_field
                    field={@form[:date]}
                    invalid={match?({:error, :date, _}, @edit_check)}
                  />
                </div>
                <div class="flex min-w-0 flex-1 flex-col gap-1">
                  <label
                    for={@form[:start_time].id}
                    class="text-xs/[1.4] font-medium text-grey-500"
                  >
                    {pgettext("time range column", "From")}
                  </label>
                  <FirmowidWeb.Timetracker.Components.Session.time_field
                    field={@form[:start_time]}
                    value={format_time(@form[:start_time].value)}
                    invalid={match?({:error, :start_time, _}, @edit_check)}
                  />
                </div>
                <div class="flex min-w-0 flex-1 flex-col gap-1">
                  <label for={@form[:end_time].id} class="text-xs/[1.4] font-medium text-grey-500">
                    {pgettext("time range column", "To")}
                  </label>
                  <FirmowidWeb.Timetracker.Components.Session.time_field
                    field={@form[:end_time]}
                    value={format_time(@form[:end_time].value)}
                    invalid={match?({:error, :end_time, _}, @edit_check)}
                  />
                </div>
              </div>
              <%= case @edit_check do %>
                <% {:error, _field, message} -> %>
                  <p
                    id="current-session-times-error"
                    class="text-xs/[1.4] font-medium text-brick-700"
                  >
                    {message}
                  </p>
                <% _ok -> %>
                  <p class="text-xs/[1.4] font-medium text-grey-500">
                    {gettext("Leave “To” empty and the session will go on until you stop it.")}
                  </p>
              <% end %>
            </div>
          </div>
          <div class="flex flex-col items-center">
            <%= cond do %>
              <% @is_form_extended and @current_session -> %>
                <%!-- The timer follows the edited start; with an end it shows the length, and
                with a problem in the times it has nothing to show. --%>
                <div class="flex w-full min-w-0 flex-col items-center gap-6 pt-12 pb-2 max-md:gap-4 max-md:pt-6 max-md:pb-7">
                  <%= case @edit_check do %>
                    <% {:ok, %{start_datetime: start, end_datetime: nil}} -> %>
                      <p
                        class="text-center text-3xl/tight font-bold text-grey-900 tabular-nums max-md:text-[64px]/[1.25]"
                        id="timetracker-timer"
                        data-start_time={start}
                        phx-hook="Timer"
                      >
                        {TimeFormatter.format_timer(
                          max(DateTime.diff(DateTime.utc_now(), start), 0),
                          :with_seconds
                        )}
                      </p>
                    <% {:ok, %{start_datetime: start, end_datetime: finish}} -> %>
                      <p
                        id="timetracker-edit-duration"
                        class="text-center text-3xl/tight font-bold text-grey-900 tabular-nums max-md:text-[64px]/[1.25]"
                      >
                        {TimeFormatter.format_timer(DateTime.diff(finish, start), :with_seconds)}
                      </p>
                    <% _error -> %>
                      <p
                        id="timetracker-edit-duration"
                        class="text-center text-3xl/tight font-bold text-grey-300 tabular-nums max-md:text-[64px]/[1.25]"
                      >
                        --:--:--
                      </p>
                  <% end %>

                  <div class="flex items-center gap-2">
                    <.button
                      type="button"
                      variant="outline"
                      class="rounded!"
                      phx-click="cancel_current_session_edit"
                    >
                      {gettext("Cancel")}
                    </.button>
                    <.button
                      id="save-current-session"
                      variant="special"
                      class="rounded!"
                      disabled={match?({:error, _, _}, @edit_check)}
                    >
                      {if match?({:ok, %{end_datetime: %DateTime{}}}, @edit_check),
                        do: gettext("Save and stop"),
                        else: gettext("Save")}
                    </.button>
                  </div>
                </div>
              <% @is_form_extended -> %>
                <div
                  id="session-form-times"
                  phx-mounted={list_enter()}
                  class="flex w-full flex-col items-center justify-center gap-12 pt-8 max-md:pb-7"
                >
                  <div class="flex w-full gap-2">
                    <div class="flex w-40 shrink-0 flex-col gap-1">
                      <label for={@form[:date].id} class="text-xs/[1.4] font-medium text-grey-500">
                        {gettext("Date")}
                      </label>
                      <FirmowidWeb.Timetracker.Components.Session.date_field field={@form[:date]} />
                    </div>

                    <div class="flex min-w-0 flex-1 flex-col gap-1">
                      <label
                        for={@form[:start_time].id}
                        class="text-xs/[1.4] font-medium text-grey-500"
                      >
                        {pgettext("time range column", "From")}
                      </label>
                      <FirmowidWeb.Timetracker.Components.Session.time_field
                        field={@form[:start_time]}
                        value={format_time(@form[:start_time].value)}
                      />
                    </div>

                    <div class="flex min-w-0 flex-1 flex-col gap-1">
                      <label
                        for={@form[:end_time].id}
                        class="text-xs/[1.4] font-medium text-grey-500"
                      >
                        {pgettext("time range column", "To")}
                      </label>
                      <FirmowidWeb.Timetracker.Components.Session.time_field
                        field={@form[:end_time]}
                        value={format_time(@form[:end_time].value)}
                      />
                    </div>
                  </div>

                  <.button
                    :if={!@current_session}
                    variant="special"
                    class="min-w-[67px] rounded! max-md:h-12 max-md:w-40"
                    disabled={is_hours_record_submitted}
                  >
                    {gettext("Start")}
                  </.button>
                  <.button
                    :if={@current_session}
                    phx-click="end_session"
                    type="button"
                    variant="special"
                    class="min-w-[67px] rounded! max-md:h-12 max-md:w-40"
                    disabled={is_hours_record_submitted}
                  >
                    {gettext("Stop")}
                  </.button>
                </div>
              <% @current_session -> %>
                <div class="flex w-full min-w-0 flex-col items-center gap-6 pt-12 pb-2 max-md:gap-4 max-md:pt-6 max-md:pb-7">
                  <p
                    class="text-center text-3xl/tight font-bold text-grey-900 tabular-nums max-md:text-[64px]/[1.25]"
                    id="timetracker-timer"
                    data-start_time={@current_session.start_datetime}
                    phx-hook="Timer"
                  >
                    {TimeFormatter.format_timer(@current_session.duration, :with_seconds)}
                  </p>

                  <.button
                    phx-click="end_session"
                    type="button"
                    variant="special"
                    class="min-w-[67px] rounded! max-md:h-12 max-md:w-40"
                  >
                    {gettext("Stop")}
                  </.button>
                </div>
              <% true -> %>
                <div class="flex w-full flex-col items-center gap-6 pt-12 pb-2 max-md:gap-4 max-md:pt-6 max-md:pb-7">
                  <%!-- Lighter while the form is empty, darker once the session can start; it eases between the two. --%>
                  <p class={[
                    "text-center text-3xl/tight font-bold tabular-nums transition-colors duration-300 ease-out motion-reduce:transition-none max-md:text-[64px]/[1.25]",
                    if(@form.source.valid?, do: "text-grey-500", else: "text-grey-300")
                  ]}>
                    {TimeFormatter.format_timer(0, :with_seconds)}
                  </p>
                  <%!-- Starts once the session has a title and a project. --%>
                  <.button
                    variant="special"
                    class="min-w-[67px] rounded! max-md:h-12 max-md:w-40"
                    disabled={is_hours_record_submitted or not @form.source.valid?}
                  >
                    {gettext("Start")}
                  </.button>
                </div>
            <% end %>
          </div>
        </.form>
      <% end %>
    </div>
    <div
      :if={@filter}
      id="filtered-sessions"
      phx-mounted={list_enter()}
      class={[
        "mb-16 flex w-full min-w-0 flex-col gap-1 md:pr-8 lg:pr-0",
        phone_list_panel_classes()
      ]}
    >
      <% month_sessions = List.flatten(@filtered_tasks) %>
      <% total = calculate_total_duration(month_sessions) %>
      <div class="flex items-center justify-between gap-4 pb-1 pl-2">
        <p class="flex min-w-0 items-baseline gap-2 leading-[1.4]">
          <span class="truncate text-h5/[1.4] font-medium text-grey-900">
            {@filter.project.name} · {month_name(@filter.month)}
          </span>
          <span class="text-sm whitespace-nowrap text-grey-500">
            | {ngettext("%{count} session", "%{count} sessions", length(month_sessions))}
          </span>
        </p>
        <div class="flex shrink-0 items-center gap-3">
          <p
            class={total_pill_classes()}
            id="filtered-timer"
            phx-hook="Timer"
            data-start_time={DateTime.utc_now() |> DateTime.add(-total, :second)}
            data-format="short"
            data-disabled={not Enum.any?(month_sessions, &is_nil(&1.end_datetime))}
          >
            {TimeFormatter.format_timer(total)}
          </p>
          <.link
            patch={~p"/czasosledz"}
            kind="button"
            variant="outline"
            size="small"
            class="rounded!"
          >
            <.figma_icon name="close" /> {gettext("All sessions")}
          </.link>
        </div>
      </div>

      <p :if={month_sessions == []} class="py-8 text-center text-sm text-grey-600">
        {gettext("No sessions in this project this month")}
      </p>

      <div>
        <FirmowidWeb.Timetracker.Components.Session.render
          :for={sessions <- @filtered_tasks}
          :key={hd(sessions).id}
          sessions={sessions}
          active_projects={@active_projects}
          projects_by_id={@projects_by_id}
          filter={@filter}
          highlighted={hd(sessions).id == @highlighted_task}
        />
      </div>
    </div>

    <div
      :if={!@filter}
      id="all-sessions"
      phx-mounted={list_enter()}
      class={[
        "mb-16 flex w-full min-w-0 flex-col gap-10 has-[#sessions-empty-state]:mb-0 max-md:gap-4 md:pr-8 lg:pr-0",
        phone_list_panel_classes()
      ]}
    >
      <div
        :if={Enum.empty?(@grouped_sessions) and Enum.empty?(@today_sessions)}
        id="sessions-empty-state"
        class="flex flex-1 flex-col items-center justify-center gap-2 rounded border border-dashed border-grey-300 px-8 py-12 text-center"
      >
        <.figma_icon name="czasosledz" class="mb-3 size-6 text-grey-900" />
        <p class="text-h5/[1.4] font-medium text-grey-900">
          {gettext("Your sessions will appear here")}
        </p>
        <p class="max-w-90 text-sm/normal text-grey-600">
          {gettext(
            "Type what you are working on, choose a project and click Start. Sessions will line up here chronologically, and their totals will go to the timesheet."
          )}
        </p>
        <p
          :if={@active_projects != [] and not @is_hours_record_submitted}
          class="mt-4 text-sm text-grey-600"
        >
          {gettext("Was the timer off?")}
          <.button
            type="button"
            variant="unstyled"
            phx-click="toggle_extended_form"
            class="cursor-pointer font-medium text-grey-700 hover:text-grey-900 hover:underline"
          >
            {gettext("Add a session manually")}
          </.button>
        </p>
      </div>

      <div :if={not Enum.empty?(@today_sessions)}>
        <div class="flex items-center justify-between pb-2 pl-2">
          <p class="text-h5/[1.4] font-medium text-grey-900">{gettext("Your sessions today")}</p>
          <% today_time = @today_sessions |> List.flatten() |> calculate_total_duration() %>
          <p
            class={total_pill_classes()}
            id="today-timer"
            phx-hook="Timer"
            data-start_time={DateTime.utc_now() |> DateTime.add(-today_time, :second)}
            data-format="short"
            data-disabled={@current_session == nil}
          >
            {today_time |> TimeFormatter.format_timer()}
          </p>
        </div>
        <div>
          <FirmowidWeb.Timetracker.Components.Session.render
            :for={sessions <- @today_sessions}
            :key={hd(sessions).id}
            sessions={sessions}
            active_projects={@active_projects}
            projects_by_id={@projects_by_id}
          />
        </div>
      </div>

      <div
        :if={@grouped_sessions != []}
        class="flex flex-col gap-10 max-md:gap-4"
      >
        <div
          :for={{week, days} <- @grouped_sessions}
          :key={week}
          class={if Enum.empty?(@today_sessions), do: "order-first", else: ""}
        >
          <div :if={Enum.empty?(@today_sessions)} />
          <div class="flex flex-col gap-10 max-md:gap-4">
            <div :for={{day, session_group} <- days} :key={day}>
              <p class="sticky top-[calc(var(--spacing-navbar)+var(--page-header-height))] z-10 flex bg-white pb-2 pl-2 text-caps-sm/[1.6] font-medium text-grey-500 uppercase max-md:bg-grey-50">
                {format_day_header(day)}
              </p>
              <div>
                <FirmowidWeb.Timetracker.Components.Session.render
                  :for={sessions <- session_group}
                  :key={hd(sessions).id}
                  sessions={sessions}
                  active_projects={@active_projects}
                  projects_by_id={@projects_by_id}
                />
              </div>
            </div>
          </div>
        </div>
      </div>

      <.button
        :if={@next_sessions_after}
        phx-click="load_more"
        variant="tertiary"
        class="mx-auto block"
      >
        {gettext("Show more")}
      </.button>
    </div>
  </div>
</div>

<%!-- Figma "Pasek Ewidencji": on phones the month's total and the way into the timesheet float
at the bottom. They step aside while a field is focused, as the keyboard pushes them up. --%>
<.link
  id="timesheet-bar"
  navigate={Navigation.hours_record_index_path(@timesheet_month.date)}
  kind="unstyled"
  class="fixed inset-x-4 bottom-[calc(1rem+env(safe-area-inset-bottom))] z-30 flex h-12 items-center gap-1 rounded border border-black bg-teal-100 px-3 shadow-small md:hidden [body:has(:is(input,textarea):focus)_&]:hidden"
>
  <span class="flex min-w-0 flex-1 items-center gap-1.5">
    <.timesheet_icon />
    <span class="truncate text-base/[normal] font-medium text-grey-900">
      {@timesheet_month.duration}
    </span>
  </span>
  <span class="text-base/[normal] font-medium text-black">
    {pgettext("timesheet link", "Timesheet")}
  </span>
  <.figma_icon name="chevron_right" class="size-4 text-grey-700" />
</.link>

<%!-- Figma "Nakładające się sesje — modal (nowy styl)": asks before a session overlaps others,
a new one or the running one whose times were edited. The session in question first, then
each session it changes, its old times struck through before the new ones. --%>
<.modal
  :if={@trim_plan}
  id="overlap-confirmation"
  show={true}
  size="large"
  on_cancel={JS.push("cancel_overlap_save")}
>
  <:header>
    <h2 id="overlap-confirmation-title" class="text-xl/[30px] font-medium text-black">
      {gettext("Sessions overlap")}
    </h2>
    <p id="overlap-confirmation-description" class="mt-2 text-base/[1.35] text-black">
      {if Map.has_key?(@trim_plan, :edited_session),
        do:
          ngettext(
            "This session overlaps %{count} existing one. After saving it will change like this:",
            "This session overlaps %{count} existing ones. After saving they will change like this:",
            length(@trim_plan.actions)
          ),
        else:
          ngettext(
            "The new session overlaps %{count} existing one. After saving it will change like this:",
            "The new session overlaps %{count} existing ones. After saving they will change like this:",
            length(@trim_plan.actions)
          )}
    </p>
  </:header>
  <% edited? = Map.has_key?(@trim_plan, :edited_session) %>
  <div class="flex flex-col gap-6">
    <div class="flex flex-col gap-6">
      <FirmowidWeb.Timetracker.Components.Overlap.new_session_card
        title={@trim_plan.new_session_attrs[:title]}
        project={@projects_by_id[@trim_plan.new_session_attrs[:project_id]]}
        start_datetime={@trim_plan.new_start}
        end_datetime={@trim_plan.new_end}
        date={@trim_plan.new_start}
        timezone={@timezone}
        edited={edited?}
      />
      <section class="flex flex-col gap-1">
        <h3 class="text-caps-sm font-medium text-grey-500 uppercase">
          {gettext("Changes to existing sessions")}
        </h3>
        <ul class="flex flex-col gap-2">
          <FirmowidWeb.Timetracker.Components.Overlap.trim_action_card
            :for={action <- @trim_plan.actions}
            action={action}
            timezone={@timezone}
            projects_by_id={@projects_by_id}
            edited={edited?}
          />
        </ul>
      </section>
    </div>
    <div class="flex justify-end gap-2">
      <.button
        type="button"
        variant="outline"
        size="small"
        phx-click={JS.push("cancel_overlap_save") |> hide_modal("overlap-confirmation")}
      >
        {gettext("Cancel")}
      </.button>
      <.button
        variant="special"
        size="small"
        phx-click="confirm_overlap_save"
        phx-disable-with={pgettext("overlap confirmation", "Saving...")}
      >
        {gettext("Save and adjust sessions")}
      </.button>
    </div>
  </div>
</.modal>
