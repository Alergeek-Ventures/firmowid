<div class="mx-auto w-full max-w-6xl">
  <%!-- todo: css background image --%>
  <img
    src="/images/figurine_timeracker.png"
    class="pointer-events-none fixed top-[20%] left-0 z-0 hidden h-[135vh] lg:block"
  />

  <div class="sticky top-navbar z-40 -mt-4 flex items-center justify-between gap-4 bg-grey-100 pt-12 pb-9">
    <div class="flex shrink-0 gap-2">
      <Lucideicons.calendar_1 />
      <p class="line-clamp-1 text-grey-900">{format_current_day_header(Date.utc_today())}</p>
    </div>

    <.link
      navigate={~p"/czasosledz/ewidencja"}
      kind="button"
      variant="outline"
    >
      <Lucideicons.clipboard_list /> Ewidencja
    </.link>
  </div>

  <div class="relative z-30 flex w-full flex-col justify-between gap-10 md:flex-row lg:gap-20">
    <div class="mx-auto w-full max-w-md md:mx-0">
      <%= if Enum.empty?(@active_projects) do %>
        <.empty_state title="Nie masz przypisanych projektów">
          <%= if @current_user.member.role == :admin do %>
            Dodaj swój pierwszy projekt i przypisz się do niego, aby rozpocząć śledzenie czasu
          <% else %>
            Poproś administratora o przypisanie Cię do projektu
          <% end %>
          <:action :if={@current_user.member.role == :admin}>
            <.link
              kind="unstyled"
              navigate={~p"/zarzadzanie/projekty"}
              class="inline-block text-rust-700 hover:underline"
            >
              Przejdź do zarządzania projektami
            </.link>
          </:action>
        </.empty_state>
      <% else %>
        <.form
          id="session_form"
          phx-change={if @current_session, do: "validate_and_update", else: "validate"}
          phx-submit={if @current_session, do: "end_session", else: "save"}
          for={@form}
          class="sticky top-[12.2rem] z-40 flex w-full flex-col"
        >
          <div class="flex flex-col gap-4">
            <% is_hours_record_submitted = @is_hours_record_submitted %>

            <.input
              field={@form[:title]}
              required={true}
              placeholder={
                if not is_hours_record_submitted,
                  do: "Nad czym dzisiaj pracujesz?",
                  else: "Nie możesz dodać sesji, po wysłaniu ewidencji godzin"
              }
              input_class="h-11 border-none hover:!bg-grey-300 focus:!outline-[2px] focus:!outline-offset-0 focus:!outline-grey-300 bg-grey-200! text-black"
              phx-hook="FocusOnMount"
              phx-debounce="300"
              autofocus
            />

            <.input
              type="select"
              disabled={is_hours_record_submitted}
              class="h-11 cursor-pointer appearance-none border-none bg-rust-200! px-4 py-2 text-rust-700 transition-colors hover:bg-[#f0e0d8] focus:ring-1 focus:ring-rust-700 focus:outline-hidden"
              field={@form[:project_id]}
              options={@active_projects |> Enum.map(&{&1.name, &1.id})}
            />

            <div class="mt-2 flex justify-between">
              <.switch
                field={@form[:is_remote]}
                label="pracuję z domu"
                class="gap-3! font-normal"
                disabled={is_hours_record_submitted}
              />

              <.button
                type="button"
                id="toggle_extended_form"
                variant="secondary"
                class="size-8! rounded-lg! p-0!"
                phx-click="toggle_extended_form"
                data-active={@is_form_extended}
                disabled={is_hours_record_submitted}
              >
                <Lucideicons.square_pen />
              </.button>
            </div>

            <p :for={{error, _} <- Keyword.get_values(@form.errors, :base)}>{error}</p>
          </div>
          <div class="flex flex-col items-center">
            <%= cond do %>
              <% @is_form_extended -> %>
                <div class="flex w-full flex-col items-center justify-center gap-12 pt-8">
                  <div class="flex h-8 w-full gap-6">
                    <.input
                      type="date"
                      class="min-w-0 flex-1"
                      input_class="w-full h-8 border-none bg-grey-200!"
                      field={@form[:date]}
                    />

                    <.input
                      step="60"
                      label="od"
                      type="time"
                      class="flex min-w-0 flex-1 items-baseline justify-center gap-4"
                      input_class="w-full h-8 border-none bg-grey-200!"
                      field={@form[:start_time]}
                      value={format_time(@form[:start_time].value)}
                    />

                    <.input
                      step="60"
                      type="time"
                      label="do"
                      class="flex min-w-0 flex-1 items-baseline justify-center gap-4"
                      input_class="w-full h-8 border-none bg-grey-200!"
                      field={@form[:end_time]}
                      value={format_time(@form[:end_time].value)}
                    />
                  </div>

                  <.button
                    :if={!@current_session}
                    variant="primary"
                    class="w-31.5"
                    disabled={is_hours_record_submitted}
                  >
                    Start
                  </.button>
                  <.button
                    :if={@current_session}
                    phx-click="end_session"
                    type="button"
                    variant="primary"
                    class="w-31.5"
                    disabled={is_hours_record_submitted}
                  >
                    Stop
                  </.button>
                </div>
              <% @current_session -> %>
                <div class="mt-14.5 flex w-full min-w-0 flex-col items-center gap-5">
                  <p
                    class="text-center text-2xl/tight font-semibold tracking-normal text-rust-700"
                    id="timetracker-timer"
                    data-start_time={@current_session.start_datetime}
                    phx-hook="Timer"
                  >
                    {TimeFormatter.format_timer(@current_session.duration, :with_seconds)}
                  </p>

                  <.button
                    phx-click="end_session"
                    type="button"
                    variant="primary"
                    class="w-31.5"
                  >
                    Stop
                  </.button>
                </div>
              <% true -> %>
                <div class="mt-8 flex w-full flex-col items-center gap-5">
                  <div class="h-[60px]">
                    <p class="text-center text-2xl/tight font-semibold text-rust-700">
                      {@month_stats.hours} godz. {@month_stats.minutes} min
                    </p>
                    <p class="text-center text-rust-700">w {@month_stats.month}</p>
                  </div>
                  <.button
                    variant="primary"
                    class="w-31.5"
                    disabled={is_hours_record_submitted}
                  >
                    Start
                  </.button>
                </div>
            <% end %>
          </div>
        </.form>
      <% end %>
    </div>
    <div class="mb-16 w-full min-w-0 space-y-16">
      <.empty_state
        :if={Enum.empty?(@grouped_sessions) and Enum.empty?(@today_sessions)}
        title="Brak zarejestrowanych sesji"
      >
        Rozpocznij swoją pierwszą sesję używając formularza po lewej
      </.empty_state>

      <div :if={not Enum.empty?(@today_sessions)}>
        <div class="flex items-center justify-between pb-3">
          <p class="font-semibold text-rust-700">Twoje dzisiejsze sesje</p>
          <% today_time = @today_sessions |> List.flatten() |> calculate_total_duration() %>
          <p
            class="rounded-md bg-rust-200 px-2 py-1 text-xl/tight font-bold text-rust-700"
            id="today-timer"
            phx-hook="Timer"
            data-start_time={DateTime.utc_now() |> DateTime.add(-today_time, :second)}
            data-format="short"
            data-disabled={@current_session == nil}
          >
            {today_time |> TimeFormatter.format_timer()}
          </p>
        </div>
        <div class="divide-y divide-grey-200">
          <FirmowidWeb.Timetracker.Components.Session.render
            :for={sessions <- @today_sessions}
            :key={hd(sessions).id}
            sessions={sessions}
            active_projects={@active_projects}
            projects_by_id={@projects_by_id}
          />
        </div>
      </div>

      <div class="flex flex-col space-y-14">
        <div
          :for={{week, days} <- @grouped_sessions}
          :key={week}
          class={if Enum.empty?(@today_sessions), do: "order-first", else: ""}
        >
          <div :if={Enum.empty?(@today_sessions)} />
          <div class="space-y-8">
            <div
              :for={{day, session_group} <- days}
              :key={day}
              class="flex flex-col gap-2"
            >
              <p class="sticky top-[190px] flex bg-grey-100 text-sm font-semibold text-grey-700">
                {format_day_header(day)}
              </p>
              <div class="divide-y divide-grey-200">
                <FirmowidWeb.Timetracker.Components.Session.render
                  :for={sessions <- session_group}
                  :key={hd(sessions).id}
                  sessions={sessions}
                  active_projects={@active_projects}
                  projects_by_id={@projects_by_id}
                />
              </div>
            </div>
          </div>
        </div>
      </div>

      <.button
        :if={@next_sessions_after}
        phx-click="load_more"
        variant="secondary"
        class="mx-auto block"
      >
        Pokaż więcej
      </.button>
    </div>
  </div>
</div>

<.modal
  :if={@trim_plan}
  id="overlap-confirmation"
  show={true}
  on_cancel={JS.push("cancel_overlap_save")}
>
  <div class="space-y-6">
    <div>
      <h3 class="text-lg font-bold text-grey-900">Nakładające się sesje</h3>
      <p class="mt-1 text-sm text-grey-700">
        Nowa sesja nachodzi na istniejące. Zapisanie wymaga poniższych zmian:
      </p>
    </div>

    <%!-- New session preview --%>
    <FirmowidWeb.Timetracker.Components.Overlap.new_session_card
      title={@trim_plan.new_session_attrs[:title]}
      start_datetime={@trim_plan.new_start}
      end_datetime={@trim_plan.new_end}
      date={@trim_plan.new_start}
      timezone={@timezone}
    />

    <%!-- Affected sessions --%>
    <div class="space-y-3">
      <p class="text-sm font-medium text-grey-700">Zmiany w istniejących sesjach:</p>

      <FirmowidWeb.Timetracker.Components.Overlap.trim_action_card
        :for={action <- @trim_plan.actions}
        action={action}
        timezone={@timezone}
        projects_by_id={@projects_by_id}
      />
    </div>

    <%!-- Action buttons --%>
    <div class="flex w-full justify-end gap-4 pt-2">
      <.button
        type="button"
        phx-click={
          JS.push("cancel_overlap_save")
          |> hide_modal("overlap-confirmation")
        }
        variant="tertiary"
      >
        Anuluj
      </.button>
      <.button
        phx-click="confirm_overlap_save"
        variant="primary"
        phx-disable-with="Zapisywanie..."
      >
        Zapisz i dostosuj sesje
      </.button>
    </div>
  </div>
</.modal>
