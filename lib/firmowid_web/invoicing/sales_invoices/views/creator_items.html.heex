<div class="relative mx-auto my-4 flex w-full max-w-6xl flex-1 flex-col">
  <.link
    kind="unstyled"
    patch={
      Navigation.sales_invoice_creator_path(%{
        szkic_kreatora: @creator_draft_id,
        krok: @step_number - 1
      })
    }
    class="absolute top-[-2.5px] -left-[calc(68px+1.5rem)] flex items-center gap-2 text-sm"
  >
    <Lucideicons.circle_chevron_left /> Wróć
  </.link>

  <.form
    for={@items_form}
    phx-change="validate_items"
    phx-submit="submit_items"
    id="invoice-form"
    class="grid grid-cols-[min-content_1fr_repeat(7,min-content)] gap-x-2"
  >
    <div class="col-start-2 col-end-9 mb-8">
      <.render_header
        invoice={@invoice}
        step={@step_number}
        title="Sprzedawane towary/usługi"
      />
    </div>

    <FirmowidWeb.Invoicing.SalesInvoices.Components.InvoiceItems.invoice_items
      invoice={@invoice}
      invoice_changeset={@items_form.source}
      items_field={@items_field}
      price_input_modes={@price_input_modes}
      focused_price_input_index={@focused_price_input_index}
    />

    <.button
      type="submit"
      phx-disable-with="Przetwarzanie..."
      class="col-start-1 col-end-9 mt-20 ml-auto h-11 w-full max-w-44"
      variant="primary"
      accent="turquoise"
      disabled={not @items_form.source.valid?}
    >
      Dalej
    </.button>
  </.form>
</div>
