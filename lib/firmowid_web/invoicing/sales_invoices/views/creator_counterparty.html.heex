<div class="mx-auto my-4 flex w-full max-w-7xl flex-1 flex-col">
  <div class="flex flex-1 flex-col space-y-10 px-9">
    <div class="flex flex-row items-start justify-between">
      <.render_header step={@step_number} title="Wybierz kontrahenta" />

      <div>
        <.button
          size="small"
          variant="secondary"
          phx-click={show_modal("counterparty-modal")}
        >
          Wprowadź ręcznie
        </.button>

        <.button
          :if={false}
          size="small"
          variant="secondary"
        >
          <Lucideicons.plus /> Dodaj nowego
        </.button>
      </div>
    </div>

    <div class="flex flex-1 flex-col-reverse items-center gap-5 md:flex-row md:items-start">
      <div
        :if={@counterparties_zero_state?}
        class="border-grey-200 flex w-full flex-col items-center justify-center gap-6 self-stretch rounded-lg border p-10"
      >
        <p class="text-grey-700 text-center text-sm/snug text-balance">
          Nie wprowadziłeś jeszcze żadnego kontrahenta.
          Wprowadź go, klikając poniżej, aby wystawić fakturę.
        </p>
        <span
          id="add-counterparty-disabled-tooltip"
          class="inline-flex"
          phx-hook="Tippy"
          data-tippy-content="w trakcie prac - wprowadź kontrahenta ręcznie przyciskiem w prawym górnym rogu ekranu"
        >
          <.button
            type="button"
            variant="secondary"
            accent="turquoise"
            disabled
          >
            Dodaj kontrahenta
          </.button>
        </span>
      </div>

      <div
        :if={not @counterparties_zero_state?}
        class="grid flex-1 grid-cols-[1fr_max-content_max-content_max-content] gap-x-6 gap-y-2"
      >
        <.form
          for={@params}
          phx-change={JS.push("search_counterparties", loading: "#counterparties")}
          phx-submit={JS.push("search_counterparties", loading: "#counterparties")}
          class="col-span-full mb-2 flex flex-row items-center gap-4"
        >
          <div class="relative w-full max-w-lg flex-1">
            <Lucideicons.search class="text-grey-900 absolute inset-y-0 top-0.5 left-3 my-auto size-4" />

            <.input
              field={@params[:search]}
              placeholder="Wyszukaj kontrahenta"
              input_class="pl-9 bg-grey-100 border min-w-[250px]"
              phx-debounce
              new={true}
            />
          </div>

          <div class="space-x-2">
            <.input type="hidden" field={@params[:filter]} />
            <% filter_id = "#" <> @params[:filter].id %>

            <.button
              type="button"
              phx-click={
                JS.toggle_attribute({"value", "company", ""}, to: filter_id)
                |> JS.dispatch("change", to: filter_id)
              }
              size="small"
              variant="ghost"
              class={[@params[:filter].value == "company" && "bg-grey-200"]}
            >
              <Lucideicons.building_2 />
            </.button>

            <.button
              type="button"
              phx-click={
                JS.toggle_attribute({"value", "individual", ""}, to: filter_id)
                |> JS.dispatch("change", to: filter_id)
              }
              size="small"
              variant="ghost"
              class={[@params[:filter].value == "individual" && "bg-grey-200"]}
            >
              <Lucideicons.user />
            </.button>
          </div>

          <div class="grow" />

          <.input type="hidden" field={@params[:sort_order]} />
          <% sort_id = "#" <> @params[:sort_order].id %>

          <.button
            type="button"
            phx-click={
              JS.toggle_attribute({"value", "desc", "asc"}, to: sort_id)
              |> JS.dispatch("change", to: sort_id)
            }
            size="small"
            variant="ghost"
          >
            <%= if @params[:sort_order].value == "desc" do %>
              <Lucideicons.arrow_down_a_z />
            <% else %>
              <Lucideicons.arrow_up_a_z />
            <% end %>
          </.button>
        </.form>

        <div
          id="counterparties_header"
          data-empty={@counterparties_empty?}
          class="text-grey-700 col-span-full grid grid-cols-subgrid items-center px-4 py-1 text-sm/snug data-empty:hidden"
        >
          <p>Kontrahent</p>
          <p>Identyfikator</p>
          <p>Kraj</p>
        </div>

        <div
          id="counterparties"
          phx-update="stream"
          class="peer phx-change-loading:opacity-50 col-span-full grid grid-cols-subgrid gap-y-2 transition-opacity"
        >
          <div
            id="counterparties_empty"
            class="col-span-full hidden flex-col items-center justify-center gap-4 p-8 only:flex"
          >
            <p class="text-grey-500 text-center">
              Nie znaleziono kontrahentów.
            </p>
            <.button
              variant="outline"
              class="border-transparent"
              phx-click="clear_counterparty_filters"
            >
              Wyczyść filtry
            </.button>
          </div>

          <.button
            :for={{dom_id, counterparty} <- @streams.counterparties}
            id={dom_id}
            type="button"
            variant="unstyled"
            phx-click="select_counterparty"
            phx-value-counterparty_id={counterparty.id}
            class="-ring-offset-1 group phx-click-loading:opacity-70 ring-turquoise-300 col-span-full grid cursor-pointer grid-cols-subgrid items-center rounded-md bg-white px-4 py-3 text-left text-sm transition duration-200 ease-out hover:ring-2"
          >
            <p class="flex flex-row items-center gap-2 text-black">
              <span class="inline-flex items-center gap-2">
                <%= case counterparty.type do %>
                  <% :company -> %>
                    <Lucideicons.building_2 class="text-grey-500 size-4" />
                  <% :individual -> %>
                    <Lucideicons.user class="text-grey-500 size-4" />
                <% end %>
                <span class="truncate">{counterparty.display_label}</span>
              </span>
            </p>

            <p class="text-grey-500 text-left">
              {counterparty.pesel || counterparty.tax_id}
            </p>

            <p class="text-grey-500 text-left">
              {CountryCodes.country_name(counterparty.country)}
            </p>

            <Lucideicons.chevron_right class="group-hover:text-grey-900 text-grey-500 justify-self-end transition duration-200 ease-out" />
          </.button>
        </div>
      </div>

      <div
        :if={@last_counterparties != [] or @last_invoices != []}
        class="w-full max-w-md"
        style="filter: drop-shadow(0px 1px 3px rgba(0, 0, 0, 0.1));"
      >
        <div id="tabs" class="flex flex-row justify-around px-2 leading-tight font-medium">
          <.link
            :for={
              {tab, label} <-
                cond do
                  @last_counterparties == [] and @last_invoices == [] ->
                    []

                  @last_counterparties == [] ->
                    [last_invoices: "Ostatnie faktury"]

                  true ->
                    [
                      last_counterparties: "Ostatnio wybierani",
                      last_invoices: "Ostatnie faktury"
                    ]
                end
            }
            id={"tab_#{tab}"}
            kind="unstyled"
            patch={
              ~p"/sprzedazowe?#{Map.merge(%{creator_draft: @creator_draft_id, step: @step_number}, encode_query_params(Map.put(@query_params, :tab, tab)))}"
            }
            class={[
              "text-grey-700 rounded-t-lg px-4 py-3 transition-colors",
              tab == @tab && "bg-grey-50 text-grey-900 pointer-events-none"
            ]}
          >
            {label}
          </.link>
        </div>

        <div
          :if={@last_counterparties != [] or @last_invoices != []}
          id="tab_content"
          class="bg-grey-50 space-y-2 rounded-lg p-6 leading-snug"
        >
          <%= case @tab do %>
            <% :last_counterparties -> %>
              <div
                :for={counterparty <- @last_counterparties}
                class="border-grey-200 phx-click-loading:opacity-50 flex flex-row justify-between gap-4 rounded-md border px-4 py-3.5 transition-opacity"
              >
                <div class="grid min-w-0 grid-cols-[max-content_minmax(0,1fr)] gap-x-5 gap-y-2 text-sm">
                  <p class="text-grey-700">Nazwa</p>
                  <p class="truncate text-black">{counterparty.display_label}</p>

                  <%= if counterparty.type == :individual do %>
                    <p class="text-grey-700">PESEL</p>
                    <p class="text-grey-500">{counterparty.pesel}</p>
                  <% else %>
                    <p class="text-grey-700">ID</p>
                    <p class="text-grey-500">{counterparty.tax_id}</p>
                  <% end %>

                  <p class="text-grey-700">Kraj</p>
                  <p class="text-grey-500">
                    {CountryCodes.country_name(counterparty.country)}
                  </p>
                </div>

                <div class="flex flex-col items-end justify-between text-right">
                  <%= case counterparty.type do %>
                    <% :company -> %>
                      <Lucideicons.building_2 class="text-grey-500 size-4" />
                    <% :individual -> %>
                      <Lucideicons.user class="text-grey-500 size-4" />
                  <% end %>

                  <div class="flex flex-row gap-2.5">
                    <.button
                      phx-click="select_counterparty"
                      phx-value-counterparty_id={counterparty.id}
                      size="small"
                      variant="secondary"
                    >
                      Wybierz
                    </.button>
                  </div>
                </div>
              </div>
            <% :last_invoices -> %>
              <div
                :for={invoice <- @last_invoices}
                class="border-grey-200 phx-click-loading:opacity-50 flex flex-row justify-between gap-4 rounded-md border px-4 py-3.5 transition-opacity"
              >
                <div class="grid min-w-0 grid-cols-[max-content_minmax(0,1fr)] gap-x-5 gap-y-2 text-sm">
                  <p class="text-grey-700">Kontrahent</p>
                  <p class="truncate text-black">{invoice.buyer_display_name_label}</p>

                  <p class="text-grey-700">Numer</p>
                  <p class="text-grey-500">{invoice.invoice_number}</p>

                  <p class="text-grey-700">Kwota</p>
                  <p class="text-grey-500">
                    {Money.new(
                      invoice.currency,
                      invoice.gross_value
                    )
                    |> Money.to_string!()}
                  </p>
                </div>

                <div class="flex flex-col items-end justify-between text-right">
                  <p class="text-grey-500 text-sm">{invoice.issue_date}</p>

                  <div class="flex flex-row gap-2.5">
                    <.link
                      navigate={
                        ~p"/sprzedazowe/#{invoice.id}?#{[return_to: "/sprzedazowe?tab=last_invoices"]}"
                      }
                      kind="button"
                      variant="outline"
                      size="small"
                    >
                      <Lucideicons.eye />
                    </.link>

                    <.button
                      phx-click="select_base_invoice"
                      phx-value-invoice_id={invoice.id}
                      size="small"
                      variant="secondary"
                    >
                      Skopiuj
                    </.button>
                  </div>
                </div>
              </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<.modal id="counterparty-modal" show={@open_counterparty_modal}>
  <h2 class="text-grey-900 mb-6 text-xl font-semibold">Wprowadź dane kontrahenta</h2>

  <.form
    for={@counterparty_form}
    id="counterparty-form"
    phx-change="validate_counterparty"
    phx-submit="submit_counterparty"
    class="space-y-6"
  >
    <div class="bg-grey-50 rounded-lg px-5 py-3">
      <.radio_group field={@counterparty_form[:buyer_type]} class="gap-8">
        <:radio value="company">Firma / Jednoosobowa Działalność Gospodarcza</:radio>
        <:radio value="individual">Osoba prywatna</:radio>
      </.radio_group>
    </div>

    <div class="grid grid-cols-2 gap-6">
      <div class="space-y-4">
        <p class="text-grey-700 text-sm font-medium">Dane podstawowe</p>

        <% # Dynamic label/placeholder based on country
        buyer_country = to_string(@counterparty_form[:buyer_country].value)

        {id_placeholder, id_required?} =
          case buyer_country do
            "PL" ->
              {"NIP klienta", true}

            "US" ->
              {"Tax ID (opcjonalnie)", false}

            country when country != "" ->
              if CountryCodes.eu_country?(country) do
                {"VAT-EU", true}
              else
                {"Identyfikator podatkowy", true}
              end

            _ ->
              {"NIP klienta", true}
          end %>
        <.input
          :if={to_string(@counterparty_form[:buyer_type].value) == "company"}
          field={@counterparty_form[:buyer_id]}
          type="text"
          placeholder={id_placeholder}
          required={id_required?}
          new={true}
        />

        <.input
          :if={to_string(@counterparty_form[:buyer_type].value) == "company"}
          field={@counterparty_form[:buyer_full_name]}
          type="text"
          placeholder="Nazwa firmy"
          new={true}
        />

        <div
          :if={to_string(@counterparty_form[:buyer_type].value) == "individual"}
          class="grid grid-cols-2 gap-2"
        >
          <.input
            field={@counterparty_form[:buyer_given_name]}
            type="text"
            placeholder="Imię"
            new={true}
          />
          <.input
            field={@counterparty_form[:buyer_surname]}
            type="text"
            placeholder="Nazwisko"
            new={true}
          />
        </div>

        <.input
          :if={to_string(@counterparty_form[:buyer_type].value) == "individual"}
          field={@counterparty_form[:buyer_pesel]}
          type="text"
          placeholder="PESEL (opcjonalnie)"
          new={true}
        />
      </div>

      <div class="space-y-4">
        <p class="text-grey-700 text-sm font-medium">Dane adresowe</p>

        <.input
          field={@counterparty_form[:buyer_address]}
          type="textarea"
          placeholder="Adres"
          input_class="resize-none min-h-[6rem]"
        />

        <.input
          field={@counterparty_form[:buyer_country]}
          type="select"
          options={CountryCodes.country_options()}
          prompt="Wybierz kraj"
          new={true}
        />
      </div>
    </div>

    <div class="space-y-4">
      <p class="text-grey-700 text-sm font-medium">Dodatkowe informacje</p>

      <div class="grid grid-cols-2 gap-4">
        <.input
          field={@counterparty_form[:buyer_email]}
          type="email"
          placeholder="E-mail"
          new={true}
        />
        <.input
          field={@counterparty_form[:buyer_phone]}
          type="tel"
          placeholder="Telefon"
          new={true}
        />
      </div>

      <.input
        field={@counterparty_form[:buyer_description]}
        type="textarea"
        placeholder="Opis"
        input_class="resize-none"
      />
    </div>

    <div class="flex justify-end gap-3 pt-4">
      <.button
        type="button"
        variant="outline"
        phx-click={hide_modal("counterparty-modal")}
      >
        Anuluj
      </.button>

      <.button
        type="submit"
        variant="primary"
        accent="turquoise"
        phx-disable-with="Zapisywanie..."
      >
        Kontynuuj
      </.button>
    </div>
  </.form>
</.modal>
