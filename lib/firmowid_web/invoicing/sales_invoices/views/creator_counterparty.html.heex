<div class="mx-auto my-4 flex w-full max-w-7xl flex-1 flex-col">
  <div class="flex flex-1 flex-col space-y-10 px-9">
    <div class="flex flex-row items-start justify-between max-md:flex-wrap max-md:gap-4">
      <.render_header step={@step_number} title={gettext("Choose a counterparty")} />

      <div class="flex flex-row gap-2">
        <.button
          size="small"
          variant="secondary"
          phx-click={show_modal("counterparty-modal")}
        >
          {gettext("Enter manually")}
        </.button>

        <.link
          :if={@can_manage_counterparties}
          kind="button"
          size="small"
          variant="secondary"
          navigate={counterparty_management_new_path(assigns)}
        >
          <Lucideicons.plus /> {gettext("Add new")}
        </.link>
      </div>
    </div>

    <div class="flex flex-1 flex-col-reverse items-center gap-5 md:flex-row md:items-start">
      <div
        :if={@counterparties_zero_state?}
        class="flex w-full flex-col items-center justify-center gap-6 self-stretch rounded-lg border border-grey-200 p-10"
      >
        <p class="text-center text-sm/snug text-balance text-grey-700">
          {gettext(
            "You have not entered any counterparty yet. Enter one by clicking below to issue an invoice."
          )}
        </p>
        <.link
          :if={@can_manage_counterparties}
          kind="button"
          variant="secondary"
          accent="teal"
          navigate={counterparty_management_new_path(assigns)}
        >
          {gettext("Add a counterparty")}
        </.link>
      </div>

      <div
        :if={not @counterparties_zero_state?}
        class="grid flex-1 grid-cols-[1fr_max-content_max-content_max-content] gap-x-6 gap-y-2 max-md:w-full max-md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto]"
      >
        <.form
          for={@params}
          phx-change={JS.push("search_counterparties", loading: "#counterparties")}
          phx-submit={JS.push("search_counterparties", loading: "#counterparties")}
          class="col-span-full mb-2 flex flex-row items-center gap-4 max-md:flex-wrap"
        >
          <div class="relative w-full max-w-lg flex-1 max-md:basis-full">
            <Lucideicons.search class="absolute inset-y-0 top-0.5 left-3 my-auto size-4 text-grey-900" />

            <.input
              field={@params[:szukaj]}
              placeholder={gettext("Search for a counterparty")}
              aria-label={gettext("Search for a counterparty")}
              input_class="pl-9 bg-grey-100 border min-w-[250px]"
              phx-debounce
            />
          </div>

          <div class="space-x-2">
            <.input type="hidden" field={@params[:typ]} />
            <% filter_id = "#" <> @params[:typ].id %>

            <.button
              type="button"
              phx-click={
                JS.toggle_attribute(
                  {"value", QueryCodec.encode_counterparty_type(:company), ""},
                  to: filter_id
                )
                |> JS.dispatch("change", to: filter_id)
              }
              size="small"
              variant="ghost"
              class={[
                @params[:typ].value == QueryCodec.encode_counterparty_type(:company) &&
                  "bg-grey-200"
              ]}
              aria-label={gettext("Show companies only")}
              aria-pressed={
                to_string(@params[:typ].value == QueryCodec.encode_counterparty_type(:company))
              }
            >
              <Lucideicons.building_2 />
            </.button>

            <.button
              type="button"
              phx-click={
                JS.toggle_attribute(
                  {"value", QueryCodec.encode_counterparty_type(:individual), ""},
                  to: filter_id
                )
                |> JS.dispatch("change", to: filter_id)
              }
              size="small"
              variant="ghost"
              class={[
                @params[:typ].value == QueryCodec.encode_counterparty_type(:individual) &&
                  "bg-grey-200"
              ]}
              aria-label={gettext("Show individuals only")}
              aria-pressed={
                to_string(@params[:typ].value == QueryCodec.encode_counterparty_type(:individual))
              }
            >
              <Lucideicons.user />
            </.button>
          </div>

          <div class="grow" />

          <.input type="hidden" field={@params[:kolejnosc]} />
          <% sort_id = "#" <> @params[:kolejnosc].id %>

          <.button
            type="button"
            phx-click={
              JS.toggle_attribute({"value", "malejaco", "rosnaco"}, to: sort_id)
              |> JS.dispatch("change", to: sort_id)
            }
            size="small"
            variant="ghost"
            aria-label={gettext("Change sort order")}
          >
            <%= if @params[:kolejnosc].value == "malejaco" do %>
              <Lucideicons.arrow_down_a_z />
            <% else %>
              <Lucideicons.arrow_up_a_z />
            <% end %>
          </.button>
        </.form>

        <div
          id="counterparties_header"
          data-empty={@counterparties_empty?}
          class="col-span-full grid grid-cols-subgrid items-center px-4 py-1 text-sm/snug text-grey-700 data-empty:hidden"
        >
          <p class="max-md:col-span-2">{gettext("Counterparty")}</p>
          <p class="max-md:col-start-1">{pgettext("sales invoice creator", "Identifier")}</p>
          <p>{pgettext("sales invoice creator", "Country")}</p>
        </div>

        <div
          id="counterparties"
          phx-update="stream"
          class="peer col-span-full grid grid-cols-subgrid gap-y-2 transition-opacity phx-change-loading:opacity-50"
        >
          <div
            id="counterparties_empty"
            class="col-span-full hidden flex-col items-center justify-center gap-4 p-8 only:flex"
          >
            <p class="text-center text-grey-600">
              {gettext("No counterparties found.")}
            </p>
            <.button
              variant="outline"
              class="border-transparent"
              phx-click="clear_counterparty_filters"
            >
              {gettext("Clear filters")}
            </.button>
          </div>

          <.button
            :for={{dom_id, counterparty} <- @streams.counterparties}
            id={dom_id}
            type="button"
            variant="unstyled"
            phx-click="select_counterparty"
            phx-value-counterparty_id={counterparty.id}
            class="-ring-offset-1 group col-span-full grid cursor-pointer grid-cols-subgrid items-center rounded-md bg-white px-4 py-3 text-left text-sm ring-teal-300 transition duration-200 ease-out hover:ring-2 phx-click-loading:opacity-70"
          >
            <p class="flex flex-row items-center gap-2 text-black max-md:col-span-2">
              <span class="inline-flex items-center gap-2">
                <%= case counterparty.type do %>
                  <% :company -> %>
                    <Lucideicons.building_2 class="size-4 text-grey-500" />
                  <% :individual -> %>
                    <Lucideicons.user class="size-4 text-grey-500" />
                <% end %>
                <span class="truncate">{counterparty.display_label}</span>
              </span>
            </p>

            <p class="text-left text-grey-600">
              {counterparty.pesel || counterparty.tax_id}
            </p>

            <p class="text-left text-grey-600">
              {CountryCodes.country_name(counterparty.country)}
            </p>

            <Lucideicons.chevron_right class="justify-self-end text-grey-500 transition duration-200 ease-out group-hover:text-grey-900 max-md:col-start-3 max-md:row-span-2 max-md:row-start-1" />
          </.button>
        </div>
      </div>

      <div
        :if={@last_counterparties != [] or @last_invoices != []}
        class="w-full max-w-md"
        style="filter: drop-shadow(0px 1px 3px rgba(0, 0, 0, 0.1));"
      >
        <div id="tabs" class="flex flex-row justify-around px-2 leading-tight font-medium">
          <.link
            :for={tab_option <- counterparty_tabs(assigns)}
            id={"tab_#{tab_option.tab}"}
            kind="unstyled"
            patch={tab_option.patch}
            class={[
              "rounded-t-lg px-4 py-3 text-grey-700 transition-colors",
              tab_option.tab == @tab && "pointer-events-none bg-grey-50 text-grey-900"
            ]}
          >
            {tab_option.label}
          </.link>
        </div>

        <div
          :if={@last_counterparties != [] or @last_invoices != []}
          id="tab_content"
          class="space-y-2 rounded-lg bg-grey-50 p-6 leading-snug"
        >
          <%= case @tab do %>
            <% :last_counterparties -> %>
              <div
                :for={counterparty <- @last_counterparties}
                class="flex flex-row justify-between gap-4 rounded-md border border-grey-200 px-4 py-3.5 transition-opacity max-md:flex-col phx-click-loading:opacity-50"
              >
                <div class="grid min-w-0 grid-cols-[max-content_minmax(0,1fr)] gap-x-5 gap-y-2 text-sm">
                  <p class="text-grey-700">{gettext("Name")}</p>
                  <p class="truncate text-black">{counterparty.display_label}</p>

                  <%= if counterparty.type == :individual do %>
                    <p class="text-grey-700">PESEL</p>
                    <p class="text-grey-600">{counterparty.pesel}</p>
                  <% else %>
                    <p class="text-grey-700">ID</p>
                    <p class="text-grey-600">{counterparty.tax_id}</p>
                  <% end %>

                  <p class="text-grey-700">{pgettext("sales invoice creator", "Country")}</p>
                  <p class="text-grey-600">
                    {CountryCodes.country_name(counterparty.country)}
                  </p>
                </div>

                <div class="flex flex-col items-end justify-between text-right max-md:flex-row max-md:items-center">
                  <%= case counterparty.type do %>
                    <% :company -> %>
                      <Lucideicons.building_2 class="size-4 text-grey-500" />
                    <% :individual -> %>
                      <Lucideicons.user class="size-4 text-grey-500" />
                  <% end %>

                  <div class="flex flex-row gap-2.5">
                    <.button
                      phx-click="select_counterparty"
                      phx-value-counterparty_id={counterparty.id}
                      size="small"
                      variant="secondary"
                    >
                      {pgettext("sales invoice creator", "Select")}
                    </.button>
                  </div>
                </div>
              </div>
            <% :last_invoices -> %>
              <div
                :for={invoice <- @last_invoices}
                class="flex flex-row justify-between gap-4 rounded-md border border-grey-200 px-4 py-3.5 transition-opacity max-md:flex-col phx-click-loading:opacity-50"
              >
                <div class="grid min-w-0 grid-cols-[max-content_minmax(0,1fr)] gap-x-5 gap-y-2 text-sm">
                  <p class="text-grey-700">{gettext("Counterparty")}</p>
                  <p class="truncate text-black">{invoice.buyer_display_name_label}</p>

                  <p class="text-grey-700">{pgettext("sales invoice creator", "Number")}</p>
                  <p class="text-grey-600">{invoice.invoice_number}</p>

                  <p class="text-grey-700">{gettext("Amount")}</p>
                  <p class="text-grey-600">
                    {Money.to_string!(invoice.amount)}
                  </p>
                </div>

                <div class="flex flex-col items-end justify-between text-right max-md:flex-row max-md:items-center">
                  <p class="text-sm text-grey-600">{invoice.issue_date}</p>

                  <div class="flex flex-row gap-2.5">
                    <.link
                      navigate={Navigation.sales_invoice_show_path(invoice, :last_sales_invoices)}
                      kind="button"
                      variant="outline"
                      size="small"
                      aria-label={
                        gettext("View invoice %{number}", number: invoice.invoice_number)
                      }
                    >
                      <Lucideicons.eye />
                    </.link>

                    <.button
                      phx-click="select_base_invoice"
                      phx-value-invoice_id={invoice.id}
                      size="small"
                      variant="secondary"
                    >
                      {pgettext("sales invoice creator", "Copy")}
                    </.button>
                  </div>
                </div>
              </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<.modal
  id="counterparty-modal"
  show={@open_counterparty_modal}
  on_cancel={JS.push("close_counterparty_modal")}
>
  <h2 class="mb-6 text-xl font-semibold text-grey-900">
    {gettext("Enter the counterparty details")}
  </h2>

  <.form
    for={@counterparty_form}
    id="counterparty-form"
    phx-change="validate_counterparty"
    phx-submit="submit_counterparty"
    class="space-y-6"
  >
    <div class="rounded-lg bg-grey-50 px-5 py-3">
      <.radio_group field={@counterparty_form[:buyer_type]} class="gap-8">
        <:radio value="company">
          {gettext("Company / sole proprietorship")}
        </:radio>
        <:radio value="individual">{gettext("Private individual")}</:radio>
      </.radio_group>
    </div>

    <div class="grid grid-cols-2 gap-6">
      <div class="space-y-4">
        <p class="text-sm font-medium text-grey-700">{gettext("Basic details")}</p>

        <% # Dynamic label/placeholder based on country
        buyer_country = to_string(@counterparty_form[:buyer_country].value)

        {id_placeholder, id_required?} =
          case buyer_country do
            "PL" ->
              {gettext("Customer NIP"), true}

            "US" ->
              {gettext("Tax ID (optional)"), false}

            country when country != "" ->
              if CountryCodes.eu_country?(country) do
                {"VAT-EU", true}
              else
                {gettext("Tax identifier"), true}
              end

            _ ->
              {gettext("Customer NIP"), true}
          end %>
        <.input
          :if={to_string(@counterparty_form[:buyer_type].value) == "company"}
          field={@counterparty_form[:buyer_id]}
          type="text"
          placeholder={id_placeholder}
          required={id_required?}
        />

        <.input
          :if={to_string(@counterparty_form[:buyer_type].value) == "company"}
          field={@counterparty_form[:buyer_full_name]}
          type="text"
          placeholder={gettext("Company name")}
        />

        <div
          :if={to_string(@counterparty_form[:buyer_type].value) == "individual"}
          class="grid grid-cols-2 gap-2"
        >
          <.input
            field={@counterparty_form[:buyer_given_name]}
            type="text"
            placeholder={gettext("First name")}
          />
          <.input
            field={@counterparty_form[:buyer_surname]}
            type="text"
            placeholder={gettext("Last name")}
          />
        </div>

        <.input
          :if={to_string(@counterparty_form[:buyer_type].value) == "individual"}
          field={@counterparty_form[:buyer_pesel]}
          type="text"
          placeholder={gettext("PESEL (optional)")}
        />
      </div>

      <div class="space-y-4">
        <p class="text-sm font-medium text-grey-700">{gettext("Address details")}</p>

        <.input
          field={@counterparty_form[:buyer_address]}
          type="textarea"
          placeholder={gettext("Address")}
          input_class="resize-none min-h-[6rem]"
        />

        <.searchable_select
          field={@counterparty_form[:buyer_country]}
          options={@country_options}
          prompt={gettext("Choose a country")}
          aria-label={pgettext("sales invoice creator", "Country")}
        />
      </div>
    </div>

    <div class="space-y-4">
      <p class="text-sm font-medium text-grey-700">{gettext("Additional information")}</p>

      <div class="grid grid-cols-2 gap-4">
        <.input
          field={@counterparty_form[:buyer_email]}
          type="email"
          placeholder={gettext("Email")}
        />
        <.input
          field={@counterparty_form[:buyer_phone]}
          type="tel"
          placeholder={gettext("Phone")}
        />
      </div>

      <.input
        field={@counterparty_form[:buyer_description]}
        type="textarea"
        placeholder={gettext("Description")}
        input_class="resize-none"
      />
    </div>

    <div class="flex justify-end gap-3 pt-4">
      <.button
        type="button"
        variant="outline"
        phx-click={JS.push("close_counterparty_modal") |> hide_modal("counterparty-modal")}
      >
        {gettext("Cancel")}
      </.button>

      <.button
        type="submit"
        variant="primary"
        accent="teal"
        phx-disable-with={pgettext("sales invoice button", "Saving...")}
      >
        {gettext("Continue")}
      </.button>
    </div>
  </.form>
</.modal>
