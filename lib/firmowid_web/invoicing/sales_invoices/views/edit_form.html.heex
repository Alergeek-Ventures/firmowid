<div class="mx-auto w-full max-w-6xl">
  <.form
    for={@form}
    phx-change="validate"
    phx-submit="send_to_ksef"
    id="invoice-form"
    class={[
      "grid gap-x-2",
      if(@current_org.is_vat_payer,
        do: "grid-cols-[min-content_1fr_repeat(7,min-content)]",
        else: "grid-cols-[min-content_1fr_repeat(6,min-content)]"
      )
    ]}
  >
    <.input type="hidden" field={@form[:invoice_number]} />
    <.input type="hidden" field={@form[:issue_date]} />
    <.input type="hidden" field={@form[:ksef_invoice_kind]} />
    <.input
      :if={@form[:original_invoice_id].value}
      type="hidden"
      field={@form[:original_invoice_id]}
    />

    <.error :for={{error, _} <- Keyword.get_values(@form.errors, :base)}>
      {error}
    </.error>

    <div class="col-start-2 col-end-9">
      <FirmowidWeb.Invoicing.SalesInvoices.Views.Creator.render_header
        invoice={@invoice}
        step={
          if @invoice.invoice_number,
            do: "Faktura korygująca",
            else: "Edycja faktury"
        }
        title={"Edycja faktury #{@invoice.invoice_number}"}
      />
    </div>

    <div class="col-span-full grid grid-cols-subgrid gap-y-14 py-14">
      <div class="col-span-full grid grid-cols-subgrid">
        <FirmowidWeb.Invoicing.SalesInvoices.Components.InvoiceItems.invoice_items
          invoice={@invoice}
          invoice_changeset={@form.source}
          items_field={:sales_invoice_items}
          item_price_input_modes={@item_price_input_modes}
          gross_item_price_inputs={@gross_item_price_inputs}
          focused_item_price_input_index={@focused_item_price_input_index}
          show_vat={@current_org.is_vat_payer}
        />
      </div>

      <hr class="col-start-2 col-end-9 text-grey-200" />

      <div class="col-start-2 col-end-9 flex flex-row items-start gap-14">
        <div class="flex w-1/2 min-w-[400px] flex-col gap-4">
          <label
            class="font-bold whitespace-nowrap text-grey-700"
            for={@form[:counterparty_id].id}
          >
            Kontrahent
          </label>

          <div class="col-start-2 grid grid-cols-[min-content_1fr] items-start gap-x-5 gap-y-4 py-4">
            <p class="whitespace-nowrap text-grey-700">Nazwa</p>
            <p>
              {@form[:buyer_display_name].value}
            </p>

            <%= case @invoice.buyer_id_type do %>
              <% :no_id -> %>
                <p class="whitespace-nowrap text-grey-700">PESEL</p>
                <p>
                  {@form[:buyer_pesel].value}
                </p>
              <% :optional_id -> %>
                <%= if @form[:buyer_id].value && @form[:buyer_id].value != "" do %>
                  <p class="whitespace-nowrap text-grey-700">Identyfikator</p>
                  <p>
                    {@form[:buyer_id].value}
                  </p>
                <% end %>
              <% id_type -> %>
                <p class="whitespace-nowrap text-grey-700">
                  {case id_type do
                    :nip -> "NIP"
                    :eu_vat -> "VAT-EU"
                    :other_id -> "Identyfikator"
                  end}
                </p>
                <p>
                  {@form[:buyer_id].value}
                </p>
            <% end %>

            <p class="whitespace-nowrap text-grey-700">Adres</p>
            <p>
              {@form[:buyer_address].value}
            </p>

            <%= if @form[:buyer_given_name].value && @form[:buyer_surname].value do %>
              <p class="whitespace-nowrap text-grey-700">Imię i nazwisko</p>
              <p>
                {@form[:buyer_given_name].value} {@form[:buyer_surname].value}
              </p>
            <% end %>
          </div>

          <.button
            type="button"
            variant="secondary"
            size="small"
            class="col-start-2 justify-self-end"
            phx-click={show_modal("buyer-edit-modal")}
          >
            Zmień
          </.button>
        </div>

        <div class="flex w-1/2 min-w-[400px] flex-col gap-4">
          <label class="font-bold whitespace-nowrap text-grey-700">
            Płatność
          </label>

          <FirmowidWeb.Invoicing.SalesInvoices.Components.InvoicePayment.invoice_payment
            invoice={@invoice}
            bank_accounts={@bank_accounts}
            selected_bank_account={@selected_bank_account}
            payment_form={@form}
          />
        </div>
      </div>

      <hr class="col-start-2 col-end-9 text-grey-200" />

      <div :if={@invoice.invoice_number} class="col-start-2 col-end-9">
        <.input
          class="min-h-20"
          field={@form[:correction_reason]}
          type="textarea"
          label="Przyczyna korekty"
          placeholder="np. korekta ceny, zmiana danych nabywcy..."
          maxlength="256"
        />
        <p class="mt-1 text-xs text-grey-400">
          Wymagana prawnie (Art. 106j ust. 2 pkt 3 ustawy o VAT). Maksymalnie 256 znaków.
        </p>
      </div>

      <div class="col-start-2 col-end-9 grid grid-cols-2 gap-4">
        <.input
          field={@form[:invoice_note]}
          type="textarea"
          label="Notatka na fakturze"
          placeholder="Widoczna na fakturze i w KSeF (stopka faktury)"
          class="min-h-24!"
        />
        <.input
          field={@form[:internal_note]}
          type="textarea"
          label="Komentarz"
          placeholder="Notatka wewnętrzna (niewidoczna na fakturze - tylko wewnątrz Firmowida)"
          class="min-h-24"
        />
      </div>

      <div class="col-start-2 col-end-9">
        <input type="hidden" name={@form[:should_send_emails].name} value="false" />
        <label
          class="flex items-center gap-3 text-sm font-medium text-grey-700"
          title={@counterparty_check.tooltip}
        >
          <input
            type="checkbox"
            name={@form[:should_send_emails].name}
            value="true"
            checked={@form[:should_send_emails].value in [true, "true"]}
            disabled={!@counterparty_check.valid}
            class="size-4 rounded border-grey-300 text-teal-600 focus:ring-teal-500 disabled:cursor-not-allowed disabled:opacity-60"
          />
          <span>Wyślij fakturę e-mailem do kontrahenta po otrzymaniu numeru KSeF</span>
        </label>
      </div>

      <div class="col-span-full my-14 flex flex-col items-center justify-center gap-14 xl:flex-row">
        <%= if @invoice.invoice_number do %>
          <div class="space-y-4">
            <p class="text-lg/6 font-medium text-black">
              Faktura {@invoice.invoice_number}
            </p>

            <div class="max-w-[650px] overflow-hidden rounded-lg border border-grey-200 bg-white shadow-sm">
              <FirmowidUI.Invoicing.Components.SalesInvoice.sales_invoice
                sales_invoice={@invoice}
                reference_invoice={@reference_invoice}
                currency_rate={Invoicing.get_currency_rate(@invoice)}
                show_vat={@current_org.is_vat_payer}
                logo_url={@logo_url}
              />
            </div>
          </div>

          <div class="space-y-4">
            <p class="text-lg/6 font-medium text-black">
              Faktura korygująca {@preview_invoice.invoice_number}
            </p>

            <div class={[
              "max-w-[650px] overflow-hidden rounded-lg border border-grey-200 bg-white shadow-sm",
              @stale_preview_invoice? && "opacity-50"
            ]}>
              <FirmowidUI.Invoicing.Components.SalesInvoice.sales_invoice
                sales_invoice={@preview_invoice}
                reference_invoice={@invoice}
                currency_rate={@currency_rate}
                show_vat={@current_org.is_vat_payer}
                logo_url={@logo_url}
              />
            </div>
          </div>
        <% else %>
          <div class={[
            "max-w-[650px] overflow-hidden rounded-lg border border-grey-200 bg-white shadow-sm",
            @stale_preview_invoice? && "opacity-50"
          ]}>
            <FirmowidUI.Invoicing.Components.SalesInvoice.sales_invoice
              sales_invoice={@preview_invoice}
              currency_rate={@currency_rate}
              show_vat={@current_org.is_vat_payer}
              logo_url={@logo_url}
              reference_invoice={@reference_invoice}
            />
          </div>
        <% end %>
      </div>
    </div>

    <div class="col-start-2 col-end-9 mb-14 flex justify-end gap-4">
      <.button
        type="button"
        variant="secondary"
        phx-click="cancel_edit"
        data-confirm-leave
      >
        Anuluj
      </.button>

      <.button
        :if={is_nil(@invoice.invoice_number) and @invoice.ksef_invoice_kind == :vat}
        type="button"
        variant="secondary"
        phx-click="save_as_draft"
        phx-disable-with="Zapisywanie..."
      >
        Zapisz wersję roboczą
      </.button>

      <.button
        type="submit"
        variant="primary"
        accent="teal"
      >
        {if @invoice.invoice_number,
          do: "Wystaw fakturę korygującą",
          else: "Zapisz i wyślij do KSeF"}
      </.button>
    </div>
    <.modal id="buyer-edit-modal">
      <h2 class="mb-6 text-xl font-semibold text-grey-900">Edytuj dane nabywcy</h2>

      <div class="space-y-6">
        <div class="rounded-lg bg-grey-50 px-5 py-3">
          <p class="text-sm text-grey-700">
            <%= if to_string(@form[:buyer_type].value) == "company" do %>
              Firma / Jednoosobowa Działalność Gospodarcza
            <% else %>
              Osoba prywatna
            <% end %>
          </p>
        </div>

        <div class="grid grid-cols-2 gap-6">
          <div class="space-y-4">
            <p class="text-sm font-medium text-grey-700">Dane podstawowe</p>

            <div
              :if={
                to_string(@form[:buyer_type].value) == "company" and @form[:buyer_tax_id].value
              }
              class="space-y-1"
            >
              <p class="text-sm text-grey-500">NIP</p>
              <p class="font-medium text-grey-900">{@form[:buyer_tax_id].value}</p>
            </div>

            <.input
              :if={to_string(@form[:buyer_type].value) == "company"}
              field={@form[:buyer_full_name]}
              type="text"
              placeholder="Nazwa firmy"
            />

            <div
              :if={
                to_string(@form[:buyer_type].value) == "individual" and @form[:buyer_pesel].value
              }
              class="space-y-1"
            >
              <p class="text-sm text-grey-500">PESEL</p>
              <p class="font-medium text-grey-900">{@form[:buyer_pesel].value}</p>
            </div>

            <div
              :if={to_string(@form[:buyer_type].value) == "individual"}
              class="grid grid-cols-2 gap-2"
            >
              <.input
                field={@form[:buyer_given_name]}
                type="text"
                placeholder="Imię"
              />
              <.input
                field={@form[:buyer_surname]}
                type="text"
                placeholder="Nazwisko"
              />
            </div>

            <.input
              field={@form[:buyer_display_name]}
              type="text"
              placeholder="Nazwa wyświetlana (opcjonalnie)"
            />
          </div>

          <div class="space-y-4">
            <p class="text-sm font-medium text-grey-700">Dane adresowe</p>

            <.input
              field={@form[:buyer_address]}
              type="textarea"
              placeholder="Adres"
              input_class="resize-none min-h-[6rem]"
            />

            <%= if to_string(@form[:buyer_country].value) == "PL" do %>
              <div class="space-y-1">
                <p class="text-sm text-grey-500">Kraj</p>
                <p class="font-medium text-grey-900">Polska</p>
              </div>
            <% else %>
              <.input
                field={@form[:buyer_country]}
                type="select"
                options={Firmowid.Invoicing.CountryCodes.country_options()}
                prompt="Wybierz kraj"
              />
            <% end %>
          </div>
        </div>

        <div class="space-y-4">
          <p class="text-sm font-medium text-grey-700">Dodatkowe informacje</p>

          <div class="grid grid-cols-2 gap-4">
            <.input
              field={@form[:buyer_email]}
              type="email"
              placeholder="E-mail"
            />
            <.input
              field={@form[:buyer_phone]}
              type="tel"
              placeholder="Telefon"
            />
          </div>

          <.input
            field={@form[:buyer_description]}
            type="textarea"
            placeholder="Opis"
            input_class="resize-none"
          />
        </div>

        <div class="flex justify-end pt-4">
          <.button
            type="button"
            variant="primary"
            accent="teal"
            phx-click={hide_modal("buyer-edit-modal")}
          >
            Zamknij
          </.button>
        </div>
      </div>
    </.modal>
  </.form>
</div>
