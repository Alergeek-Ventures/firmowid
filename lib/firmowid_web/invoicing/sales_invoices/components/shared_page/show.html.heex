<.shared_page
  lang={to_string(@lang)}
  title={"#{if @lang == :en, do: "Invoice", else: "Faktura"} #{@invoice.invoice_number || ""} — #{Firmowid.SalesInvoices.buyer_display_name(@invoice) || ""}"}
>
  <div class="grid grid-cols-[min-content_1fr] justify-center">
    <div class="sticky top-0 left-0 hidden h-min flex-col gap-2 p-4 xl:flex">
      <a
        :for={invoice <- [@invoice | @invoice.corrections]}
        href={"#invoice-#{invoice.id}"}
        data-active={false}
        class="data-active:text-grey-800 hover:text-grey-900 text-grey-700 only:hidden"
      >
        {invoice.invoice_number}
      </a>
    </div>
    <div>
      <div
        :for={invoice <- [@invoice | @invoice.corrections]}
        id={"invoice-#{invoice.id}"}
        class="mx-auto my-4 flex w-full max-w-6xl flex-1 flex-col"
      >
        <div class="px-9">
          <div class="mt-8 flex gap-6">
            <div class="max-w-[650px] flex-1">
              <FirmowidWeb.Invoicing.SalesInvoices.Components.Pdf.sales_invoice
                sales_invoice={invoice}
                currency_rate={@currency_rate}
                show_vat={@show_vat}
                reference_invoice={invoice.reference_invoice}
              />
            </div>
            <div class="min-w-[350px] space-y-6">
              <div class="mb-4 flex items-center justify-between">
                <h2 class="text-grey-700 text-lg font-medium">
                  {if @lang == :en, do: "Invoice details", else: "Dane faktury"}
                </h2>
                <div :if={invoice.invoice_type == :foreign} class="flex gap-1">
                  <a
                    href={~p"/faktura/#{@conn.params["token"]}?lang=pl"}
                    class={[
                      "rounded px-2 py-1 text-xs font-medium transition-colors",
                      if(@lang == :pl,
                        do: "bg-black text-white",
                        else: "bg-greyButtonBg hover:bg-grey-300 text-darkGrey"
                      )
                    ]}
                  >
                    🇵🇱 PL
                  </a>
                  <a
                    href={~p"/faktura/#{@conn.params["token"]}?lang=en"}
                    class={[
                      "rounded px-2 py-1 text-xs font-medium transition-colors",
                      if(@lang == :en,
                        do: "bg-black text-white",
                        else: "bg-greyButtonBg hover:bg-grey-300 text-darkGrey"
                      )
                    ]}
                  >
                    🇬🇧 EN
                  </a>
                </div>
              </div>

              <FirmowidWeb.Invoicing.Components.InvoiceDetails.sales_invoice_metadata
                invoice={invoice}
                lang={@lang}
              />
              <a
                href={
                  case invoice.ksef_invoice_kind do
                    :kor -> ~p"/faktura/#{@conn.params["token"] <> "." <> invoice.id}/pdf"
                    :vat -> ~p"/faktura/#{@conn.params["token"]}/pdf"
                  end
                }
                class="hover:bg-orangeText flex w-full items-center justify-center gap-2 rounded-lg bg-black px-4 py-3 text-sm font-medium text-white transition-colors"
              >
                <.icon name="hero-arrow-down-tray" class="size-4" />
                {if @lang == :en, do: "Download PDF", else: "Pobierz PDF"}
              </a>
              <a
                :if={not is_nil(invoice.ksef_number)}
                href={Firmowid.Ksef.invoice_url!(invoice)}
                target="_blank"
                class="hover:bg-orangeText flex w-full items-center justify-center gap-2 rounded-lg bg-black px-4 py-3 text-sm font-medium text-white transition-colors"
              >
                <.icon name="hero-arrow-trending-up" class="size-4" />
                {if @lang == :en, do: "View in KSeF", else: "Zobacz w KSeF"}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</.shared_page>
