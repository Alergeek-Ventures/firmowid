<.shared_page
  lang={to_string(@lang)}
  title={"#{if @lang == :en, do: "Invoice", else: "Faktura"} #{@invoice.invoice_number || ""} — #{@buyer_display_name}"}
>
  <% invoices = Enum.reverse(@invoice.corrections) ++ [@invoice] %>

  <div class="grid grid-cols-[min-content_1fr] justify-center">
    <div class="sticky top-0 left-0 hidden h-min flex-col gap-2 p-4 xl:flex">
      <.link
        :for={invoice <- invoices}
        kind="unstyled"
        redirect={"#invoice-#{invoice.id}"}
        data-active={false}
        class="text-grey-700 only:hidden hover:text-grey-900 data-active:text-grey-800"
      >
        {invoice.invoice_number}
      </.link>
    </div>
    <div>
      <div
        :for={invoice <- invoices}
        id={"invoice-#{invoice.id}"}
        class="mx-auto my-4 flex w-full max-w-6xl flex-1 flex-col"
      >
        <div class="px-9">
          <div class="mt-8 flex gap-6">
            <div class="max-w-[650px] flex-1">
              <FirmowidUI.Invoicing.Components.SalesInvoice.sales_invoice
                sales_invoice={invoice}
                currency_rate={@currency_rate}
                show_vat={@show_vat}
                reference_invoice={invoice.reference_invoice}
                logo_url={@logo_url}
              />
            </div>
            <div class="min-w-[350px] space-y-6">
              <div class="mb-4 flex items-center justify-between">
                <h2 class="text-lg font-medium text-grey-700">
                  {if @lang == :en, do: "Invoice details", else: "Dane faktury"}
                </h2>
                <div :if={invoice.invoice_type == :foreign} class="flex gap-1">
                  <.link
                    kind="unstyled"
                    navigate={
                      ~p"/faktura/#{@conn.params["token"]}?jezyk=#{QueryCodec.encode_invoice_language(:pl)}"
                    }
                    class={[
                      "rounded px-2 py-1 text-xs font-medium transition-colors",
                      if(@lang == :pl,
                        do: "bg-black text-white",
                        else: "bg-grey-200 text-grey-700 hover:bg-grey-300"
                      )
                    ]}
                  >
                    🇵🇱 PL
                  </.link>
                  <.link
                    kind="unstyled"
                    navigate={
                      ~p"/faktura/#{@conn.params["token"]}?jezyk=#{QueryCodec.encode_invoice_language(:en)}"
                    }
                    class={[
                      "rounded px-2 py-1 text-xs font-medium transition-colors",
                      if(@lang == :en,
                        do: "bg-black text-white",
                        else: "bg-grey-200 text-grey-700 hover:bg-grey-300"
                      )
                    ]}
                  >
                    🇬🇧 EN
                  </.link>
                </div>
              </div>

              <FirmowidWeb.Invoicing.Components.InvoiceDetails.sales_invoice_metadata
                invoice={invoice}
                lang={@lang}
              />
              <.link
                kind="unstyled"
                navigate={
                  case invoice.ksef_invoice_kind do
                    :kor -> ~p"/faktura/#{@conn.params["token"] <> "." <> invoice.id}/pdf"
                    :vat -> ~p"/faktura/#{@conn.params["token"]}/pdf"
                  end
                }
                class="flex w-full items-center justify-center gap-2 rounded-lg bg-black px-4 py-3 text-sm font-medium text-white transition-colors hover:bg-rust-700"
              >
                <.icon name="hero-arrow-down-tray" class="size-4" />
                {if @lang == :en, do: "Download PDF", else: "Pobierz PDF"}
              </.link>
              <.link
                :if={not is_nil(invoice.ksef_number)}
                kind="unstyled"
                external={Firmowid.Ksef.invoice_url!(invoice)}
                target="_blank"
                class="flex w-full items-center justify-center gap-2 rounded-lg bg-black px-4 py-3 text-sm font-medium text-white transition-colors hover:bg-rust-700"
              >
                <.icon name="hero-arrow-trending-up" class="size-4" />
                {if @lang == :en, do: "View in KSeF", else: "Zobacz w KSeF"}
              </.link>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</.shared_page>
