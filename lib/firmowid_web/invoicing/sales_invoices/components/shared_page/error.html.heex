<.shared_page
  title="Błąd — Firmowid"
  body_class="bg-grey-100 min-h-full font-[Lexend] flex flex-col"
>
  <main class="flex-1 flex items-center justify-center p-8">
    <div class="text-center max-w-md">
      <.icon name="hero-exclamation-triangle" class="w-16 h-16 mx-auto text-grey-400 mb-6" />
      <h1 class="text-xl font-bold text-grey-900 mb-2">Wystąpił błąd</h1>
      <p class="text-grey-600">
        Nie udało się wygenerować faktury. Spróbuj ponownie za chwilę.
      </p>
    </div>
  </main>
</.shared_page>
