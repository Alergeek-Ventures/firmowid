<.shared_page
  title="Błąd — Firmowid"
  body_class="bg-grey-100 min-h-full font-[Lexend] flex flex-col"
>
  <main class="flex flex-1 items-center justify-center p-8">
    <div class="max-w-md text-center">
      <.icon name="hero-exclamation-triangle" class="mx-auto mb-6 size-16 text-grey-400" />
      <h1 class="mb-2 text-xl font-bold text-grey-900">Wystąpił błąd</h1>
      <p class="text-grey-600">
        Nie udało się wygenerować faktury. Spróbuj ponownie za chwilę.
      </p>
