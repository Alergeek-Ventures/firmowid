<.shared_page
  title={gettext("Error — Firmowid")}
  body_class="bg-grey-100 min-h-full font-sans flex flex-col"
>
  <main class="flex flex-1 items-center justify-center p-8">
    <div class="max-w-md text-center">
      <.icon name="hero-exclamation-triangle" class="mx-auto mb-6 size-16 text-grey-400" />
      <h1 class="mb-2 text-xl font-bold text-grey-900">{gettext("An error occurred")}</h1>
      <p class="text-grey-600">
        {gettext("Could not generate the invoice. Try again in a moment.")}
      </p>
    </div>
  </main>
</.shared_page>
