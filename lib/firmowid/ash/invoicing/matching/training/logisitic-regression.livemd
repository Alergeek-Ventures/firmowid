                )
            end
          end)

          [Kino.Markdown.new(details), match_button]
        end)
        |> List.flatten()

      Kino.Frame.render(
        output_frame,
        Kino.Layout.grid(
          [
            Kino.Markdown.new(invoice_info),
            skip_button
            | transaction_blocks
          ],
          columns: 1
        )
      )
    else
      Kino.Frame.render(
        output_frame,
        Kino.Layout.grid(
          [
            Kino.Markdown.new(invoice_info <> "\n\n### No prefiltered transactions found"),
            skip_button
          ],
          columns: 1
        )
      )
    end
  else
    Kino.Frame.render(
      output_frame,
      Kino.Markdown.new("**Invalid index. Please select a valid invoice.**")
