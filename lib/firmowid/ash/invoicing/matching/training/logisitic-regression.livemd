## setup

```elixir
defmodule CostInvoiceMatch do
  use Ecto.Schema

  @primary_key false
  embedded_schema do
    field :transaction_id, :string
    field :cost_invoice_id, :string
  end
end
```

```elixir
defmodule SalesInvoiceMatch do
  use Ecto.Schema

  @primary_key false
  embedded_schema do
    field :transaction_id, :string
    field :sales_invoice_id, :string
  end
end
```

```elixir
defmodule Matches do
  @moduledoc """
  Provides functions to read, write, add, and delete invoice matches and skipped invoices from matches.json.
  """

  @json_path Path.join(__DIR__, "matches.json") |> Path.expand()

  @doc """
  Reads the current state from matches.json.
  Returns a map with keys :cost_invoice_matches, :sales_invoice_matches, :skipped_cost_invoices, :skipped_sales_invoices.
  """
  def read_state do
    raw = @json_path |> File.read!() |> Jason.decode!(keys: :atoms)

    cost_matches =
      Enum.map(raw.cost_invoice_matches, fn attrs ->
        changeset = Ecto.Changeset.change(%CostInvoiceMatch{}, attrs)
        if changeset.valid? do
          Ecto.Changeset.apply_changes(changeset)
        else
          raise "Invalid cost_invoice_match: #{inspect(attrs)} errors: #{inspect(changeset.errors)}"
        end
      end)

    sales_matches =
      Enum.map(raw.sales_invoice_matches, fn attrs ->
        changeset = Ecto.Changeset.change(%SalesInvoiceMatch{}, attrs)
        if changeset.valid? do
          Ecto.Changeset.apply_changes(changeset)
        else
          raise "Invalid sales_invoice_match: #{inspect(attrs)} errors: #{inspect(changeset.errors)}"
        end
      end)

    %{
      cost_invoice_matches: cost_matches,
      sales_invoice_matches: sales_matches,
      skipped_cost_invoices: Map.get(raw, :skipped_cost_invoices, []),
      skipped_sales_invoices: Map.get(raw, :skipped_sales_invoices, [])
    }
  end

  @doc """
  Writes the given state map to matches.json.
  The state should be a map with keys :cost_invoice_matches, :sales_invoice_matches, :skipped_cost_invoices, :skipped_sales_invoices.
  """
  def write_state(state) when is_map(state) do
    normalized_state =
      state
      |> Map.update!(:cost_invoice_matches, fn list -> Enum.map(list, &Map.from_struct/1) end)
      |> Map.update!(:sales_invoice_matches, fn list -> Enum.map(list, &Map.from_struct/1) end)
      |> Map.update(:skipped_cost_invoices, [], fn list -> list || [] end)
      |> Map.update(:skipped_sales_invoices, [], fn list -> list || [] end)

    json = Jason.encode!(normalized_state, pretty: true)
    File.write!(@json_path, json)
  end

  @doc """
  Adds a cost invoice match. Throws if the match already exists.
  Accepts a map or %CostInvoiceMatch{}.
  """
  def add_cost_invoice_match(%CostInvoiceMatch{} = new_match) do
    state = read_state()

    if Enum.any?(state.cost_invoice_matches, &(&1.cost_invoice_id == new_match.cost_invoice_id)) do
      raise "Cost invoice match already exists"
    end

    updated = state.cost_invoice_matches ++ [new_match]
    write_state(%{state | cost_invoice_matches: updated})
  end

  @doc """
  Adds a sales invoice match. Throws if the match already exists.
  Accepts a map or %SalesInvoiceMatch{}.
  """
  def add_sales_invoice_match(%SalesInvoiceMatch{} = match),
    do: add_sales_invoice_match(Map.from_struct(match))

  def add_sales_invoice_match(%{transaction_id: _tid, sales_invoice_id: sid} = attrs) do
    state = read_state()

    if Enum.any?(state.sales_invoice_matches, &(&1.sales_invoice_id == sid)) do
      raise "Sales invoice match already exists"
    end

    changeset = Ecto.Changeset.change(%SalesInvoiceMatch{}, attrs)

    if not changeset.valid? do
      raise "Invalid sales invoice match: #{inspect(changeset.errors)}"
    end

    updated = state.sales_invoice_matches ++ [Ecto.Changeset.apply_changes(changeset)]
    write_state(%{state | sales_invoice_matches: updated})
  end

  @doc """
  Deletes a cost invoice match by transaction_id and cost_invoice_id.
  """
  def delete_cost_invoice_match(transaction_id, cost_invoice_id) do
    state = read_state()

    updated =
      Enum.reject(
        state.cost_invoice_matches,
        &(&1.transaction_id == transaction_id and &1.cost_invoice_id == cost_invoice_id)
      )

    write_state(%{state | cost_invoice_matches: updated})
  end

  @doc """
  Deletes a sales invoice match by transaction_id and sales_invoice_id.
  """
  def delete_sales_invoice_match(transaction_id, sales_invoice_id) do
    state = read_state()

    updated =
      Enum.reject(
        state.sales_invoice_matches,
        &(&1.transaction_id == transaction_id and &1.sales_invoice_id == sales_invoice_id)
      )

    write_state(%{state | sales_invoice_matches: updated})
  end

  # Skipped cost invoices
  def add_skipped_cost_invoice(invoice_id) do
    state = read_state()
    updated = Enum.uniq([invoice_id | state.skipped_cost_invoices])
    write_state(%{state | skipped_cost_invoices: updated})
  end

  def remove_skipped_cost_invoice(invoice_id) do
    state = read_state()
    updated = Enum.reject(state.skipped_cost_invoices, &(&1 == invoice_id))
    write_state(%{state | skipped_cost_invoices: updated})
  end

  # Skipped sales invoices
  def add_skipped_sales_invoice(invoice_id) do
    state = read_state()
    updated = Enum.uniq([invoice_id | state.skipped_sales_invoices])
    write_state(%{state | skipped_sales_invoices: updated})
  end

  def remove_skipped_sales_invoice(invoice_id) do
    state = read_state()
    updated = Enum.reject(state.skipped_sales_invoices, &(&1 == invoice_id))
    write_state(%{state | skipped_sales_invoices: updated})
  end
end
```

