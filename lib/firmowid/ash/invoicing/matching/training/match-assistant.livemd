invoice =
  Firmowid.CostInvoices.list_cost_invoices(
    ~D[2024-01-01],
    ~D[2025-02-10]
  )
  |> hd()

"#{invoice.seller_display_name} #{invoice.issue_date} #{invoice.total_amount}"
